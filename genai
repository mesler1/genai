def sandbox_info():
    """Where a command the user runs from genai will execute. An indicator, not a guarantee:
    a sandbox declares itself with GENAI_SANDBOX=<name>; podman and docker leave marker files."""
    name = os.environ.get("GENAI_SANDBOX", "").strip()
    if name and name.lower() not in ("0", "none", "no"):
        return {"name": name, "source": "GENAI_SANDBOX"}
    if os.path.exists("/run/.containerenv"):
        return {"name": "podman", "source": "/run/.containerenv"}
    if os.path.exists("/.dockerenv"):
        return {"name": "docker", "source": "/.dockerenv"}
    return None


def command_fingerprint(cmd):
    """What the audit log keeps of a command: its hash and length, never its text, which may hold secrets."""
    return {"command_sha256": hashlib.sha256(cmd.encode("utf-8", "replace")).hexdigest(), "command_len": len(cmd)}


def where_runs(sb):
    return f"inside the {sb['name']} sandbox" if sb else "OUTSIDE any sandbox, directly on this host"


# --------------------------------------------------------------------------
# Sandbox runner: commands the model runs itself, in a container, on a throwaway copy of the project

SANDBOX_KEYS = {"engine", "image", "network", "timeout", "memory", "pids"}
SANDBOX_TIMEOUT = 300          # seconds a sandboxed command may run before it is killed
SANDBOX_TMP = "1g"             # size of the sandbox's /tmp, which is also its HOME
SANDBOX_MEMORY = "4g"
SANDBOX_PIDS = 1024
SANDBOX_MASKS = 500            # files and directories one run may hide; more refuses the run
SANDBOX_SCAN = 50000           # entries checked for secrets; a larger project refuses the run
SECRET_NAMES = {".env", ".envrc", ".netrc", ".npmrc", ".pypirc", ".pgpass", ".git-credentials", ".vault-token",
                ".aws", ".ssh", ".gnupg", ".docker", ".kube", ".password-store", ".azure", ".config"}
SECRET_PREFIXES = (".env.", "id_rsa", "id_dsa", "id_ecdsa", "id_ed25519")
SECRET_SUFFIXES = (".key", ".p12", ".pfx", ".jks", ".keystore")
SCAN_SKIP = {"node_modules", "__pycache__", ".tox", ".nox", ".mypy_cache", ".pytest_cache", ".ruff_cache"}
_GUARD_EXIT = 97
# Runs first inside the container: every hidden path must really be empty, or the command doesn't run.
_GUARD = ('for p in "$@"; do if [ -d "$p" ]; then [ -z "$(ls -A "$p")" ] || { echo "$GENAI_GUARD $p"; exit 97; }; '
          'elif [ -s "$p" ]; then echo "$GENAI_GUARD $p"; exit 97; fi; done; '
          'c=$GENAI_CMD; unset GENAI_CMD GENAI_GUARD; exec /bin/sh -c "$c"')


def parse_sandbox(data, path):
    """A profile's "sandbox" object, checked. The image is required: offline, the project's tools and
    dependencies have to be in it already."""
    if not isinstance(data, dict):
        raise GenaiError(f"{path}: 'sandbox' must be an object", EXIT_PROFILE)
    unknown = set(data) - SANDBOX_KEYS
    if unknown:
        raise GenaiError(f"{path}: unknown sandbox fields: {', '.join(sorted(unknown))}", EXIT_PROFILE)
    box = {"engine": data.get("engine", "auto"), "image": data.get("image"), "network": data.get("network", False),
           "timeout": data.get("timeout", SANDBOX_TIMEOUT), "memory": data.get("memory", SANDBOX_MEMORY),
           "pids": data.get("pids", SANDBOX_PIDS)}
    if box["engine"] not in ("auto", "podman"):
        raise GenaiError(f"{path}: sandbox 'engine' must be \"auto\" or \"podman\" (apptainer is not supported yet)",
                         EXIT_PROFILE)
    if not isinstance(box["image"], str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/:@+-]{0,255}", box["image"]):
        raise GenaiError(f"{path}: sandbox 'image' is required: the container image commands run in", EXIT_PROFILE)
    if not isinstance(box["network"], bool):
        raise GenaiError(f"{path}: sandbox 'network' must be true or false", EXIT_PROFILE)
    if type(box["timeout"]) is not int or not 1 <= box["timeout"] <= 3600:
        raise GenaiError(f"{path}: sandbox 'timeout' must be seconds, from 1 to 3600", EXIT_PROFILE)
    if not isinstance(box["memory"], str) or not re.fullmatch(r"[0-9]+[kmg]?", box["memory"]):
        raise GenaiError(f"{path}: sandbox 'memory' must be a size such as \"4g\"", EXIT_PROFILE)
    if type(box["pids"]) is not int or not 16 <= box["pids"] <= 100000:
        raise GenaiError(f"{path}: sandbox 'pids' must be a number of processes, from 16 to 100000", EXIT_PROFILE)
    return box


def secret_name(name):
    return name in SECRET_NAMES or name.startswith(SECRET_PREFIXES) or name.endswith(SECRET_SUFFIXES)


class Sandbox:
    """Runs one command in a podman container: the project is a copy-on-write overlay whose changes are
    discarded, files that look like secrets are hidden, there is no network unless switched on, nothing from
    the home directory, a time limit, and memory and process limits where the host allows them."""

    def __init__(self, conf, root, notice):
        self.conf, self.root, self.notice = conf, os.path.realpath(root), notice
        self.podman = shutil.which("podman")
        self.network = conf["network"]      # the switch; starts as the profile says, never saved with a session
        self.limits = True                  # False once the host refused memory and process limits
        self.cache = {}                     # (path, identity) -> looks secret
        self.counter = 0

    def problem(self):
        """Why the sandbox can't run anything here, or None."""
        if not self.podman:
            return "podman is not installed"
        if any(c in self.root for c in ":,"):
            return "the project's path contains ':' or ',', which podman can't mount"
        refused = coding_refusal(self.root)
        if refused:     # even with --coding-anywhere: the copy would hold all of it, and nothing here asks
            return f"this is {refused[0]}; run genai in a project directory"
        return None

    def info(self):
        return {"engine": "podman", "image": self.conf["image"], "network": self.network,
                "timeout": self.conf["timeout"], "problem": self.problem()}

    def masks(self, values=()):
        """Files and directories to hide in the sandbox, relative to the project: secret-looking names, and
        files whose contents look like secrets. Virtual environments and dependency caches are not scanned;
        a .git directory only has its config checked. Raises GenaiError if the project is too big to check."""
        files, dirs, seen = [], [], 0
        stack = [""]
        while stack:
            rel = stack.pop()
            try:
                with os.scandir(os.path.join(self.root, rel)) as it:
                    entries = sorted(it, key=lambda e: e.name)
            except OSError:
                continue                    # unreadable here is unreadable in the sandbox too
            for e in entries:
                seen += 1
                if seen > SANDBOX_SCAN:
                    raise GenaiError(f"the project has more than {SANDBOX_SCAN} files, too many to check for "
                                     "secrets before a sandboxed run", kind="sandbox")
                r = f"{rel}/{e.name}" if rel else e.name
                try:
                    if e.is_symlink():
                        continue
                    if e.is_dir():
                        if secret_name(e.name):
                            dirs.append(r)
                        elif e.name == ".git":
                            if self.secret_file(os.path.join(e.path, "config"), values):
                                files.append(r + "/config")
                        elif e.name not in SCAN_SKIP and not os.path.exists(os.path.join(e.path, "pyvenv.cfg")):
                            stack.append(r)
                    elif e.is_file() and (secret_name(e.name) or self.secret_file(e.path, values)):
                        files.append(r)
                except OSError:
                    continue
        return files, dirs

    def secret_file(self, path, values):
        try:
            st = os.stat(path, follow_symlinks=False)
            if not stat.S_ISREG(st.st_mode):
                return False
            key = (path, st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, tuple(values))
            if key not in self.cache:
                with open(path, "rb") as f:
                    text = f.read(READ_CAP).decode("utf-8", "replace")
                self.cache[key] = looks_secret(text) or any(v and v in text for v in values)
            return self.cache[key]
        except OSError:
            return False

    def argv(self, name, command, files, dirs, empty, guard):
        net = ["--network=none", "--http-proxy=false"] if not self.network else []
        limits = [f"--memory={self.conf['memory']}", f"--pids-limit={self.conf['pids']}"] if self.limits else []
        mounts = [f"--volume={self.root}:/work:O"]
        mounts += [f"--volume=/dev/null:/work/{f}:ro" for f in files]
        mounts += [f"--volume={empty}:/work/{d}:ro" for d in dirs]
        return ([self.podman, "--log-level=error", "run", "--rm", f"--name={name}", "--pull=never", "--init",
                 "--userns=keep-id", "--read-only", f"--tmpfs=/tmp:rw,size={SANDBOX_TMP},mode=1777",
                 "--cap-drop=all", "--security-opt=no-new-privileges", "--workdir=/work",
                 "--env=HOME=/tmp", f"--env=GENAI_CMD={command}", f"--env=GENAI_GUARD={guard}"]
                + net + limits + mounts + [self.conf["image"], "/bin/sh", "-c", _GUARD, "genai-guard"]
                + [f"/work/{p}" for p in files + dirs])

    def run(self, command, values=(), cap=OUTPUT_CAP * 8):
        """Run command; returns (ran, exit code or None, output, note). ran is False when the command never
        started; the exit code is None when it was killed at the time limit. Ctrl-C stops the container and is
        raised again."""
        problem = self.problem()
        if problem:
            return False, None, "", problem
        files, dirs = self.masks(values)
        bad = [p for p in files + dirs if any(c in p for c in ":,")]
        if bad:
            return False, None, "", f"can't hide {show_exact(bad[0])}: its name contains ':' or ','"
        if len(files) + len(dirs) > SANDBOX_MASKS:
            return False, None, "", f"more than {SANDBOX_MASKS} files look like secrets, too many to hide"
        self.counter += 1
        name = f"genai-{os.getpid()}-{self.counter}-{secrets.token_hex(6)}"
        guard = "genai-guard-" + secrets.token_hex(6)
        with tempfile.TemporaryDirectory(prefix="genai-empty-") as empty:
            os.chmod(empty, 0o500)
            for attempt in (1, 2):
                rc, out = self._podman(self.argv(name, command, files, dirs, empty, guard), name, cap)
                if attempt == 1 and self.limits and rc in (125, 126) and "cgroup" in out:
                    self.limits = False
                    self.notice("this host doesn't let podman limit memory or processes (cgroups aren't delegated "
                                "to you); sandboxed commands are limited only by time and the size of /tmp")
                    continue
                break
        hidden = len(files) + len(dirs)
        if rc == _GUARD_EXIT and out.startswith(guard):
            return False, None, "", (f"refused: {out[len(guard):].strip()} should have been hidden in the sandbox but "
                              "wasn't, so the command did not run")
        if rc == "timeout":
            return True, None, out, f"killed after {self.conf['timeout']} s"
        if rc in (125, 126, 127) and out.startswith("Error:"):
            hint = f" (podman pull {self.conf['image']} first)" if "image not known" in out else ""
            return False, None, "", f"the sandbox could not start: {one_line(out.strip())[0]}{hint}"
        return True, rc, out, f"{hidden} secret-looking path{'s' if hidden != 1 else ''} hidden" if hidden else ""

    def _podman(self, argv, name, cap):
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        chunks, size = [], [0]

        def drain():
            for chunk in iter(lambda: proc.stdout.read1(65536), b""):
                if size[0] < cap:
                    chunks.append(chunk)
                size[0] += len(chunk)

        reader = threading.Thread(target=drain, daemon=True)
        reader.start()
        try:
            rc = proc.wait(timeout=self.conf["timeout"])
        except subprocess.TimeoutExpired:
            self._kill(name, proc)
            rc = "timeout"
        except KeyboardInterrupt:
            self._kill(name, proc)
            raise
        reader.join(5)
        proc.stdout.close()
        out = strip_ansi(b"".join(chunks).decode("utf-8", "replace"))
        if size[0] > cap:
            out += f"\n[... {size[0] - cap} more bytes of output not kept ...]"
        return rc, out

    def _kill(self, name, proc):
        subprocess.run([self.podman, "--log-level=error", "kill", name], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=30, check=False)
        try:
            proc.wait(timeout=30)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()




