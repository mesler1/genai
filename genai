def parse_plan(args):
    """propose_plan's arguments, checked: a goal and 1 to PLAN_STEPS numbered steps."""
    goal, steps = args.get("goal"), args.get("steps")
    if not isinstance(goal, str) or not goal.strip():
        raise ValueError("goal is required")
    if not isinstance(steps, list) or not 1 <= len(steps) <= PLAN_STEPS:
        raise ValueError(f"steps must be a list of 1 to {PLAN_STEPS} steps")
    out = []
    for n, st in enumerate(steps, 1):
        if not isinstance(st, dict) or st.get("kind") not in ("read", "edit", "write", "command"):
            raise ValueError(f"step {n}: kind must be read, edit, write or command")
        step = {"n": n, "kind": st["kind"], "why": str(st.get("why", ""))}
        if st["kind"] == "command":
            if not isinstance(st.get("command"), str) or not st["command"].strip():
                raise ValueError(f"step {n}: a command step needs the exact command")
            step["command"] = st["command"]
        else:
            if not isinstance(st.get("path"), str):
                raise ValueError(f"step {n}: a {st['kind']} step needs a path")
            if st["path"] not in (".", "./", ""):
                split_rel(st["path"])
            step["path"] = st["path"]
        out.append(step)
    return {"goal": goal, "steps": out, "reason": goal}


def plan_text(plan):
    """The approved plan for the model: each step, whether it is approved, and how far it has got."""
    lines = [f"Goal: {plan['goal']}"]
    for st in plan["steps"]:
        what = f"run exactly: {st['command']}" if st["kind"] == "command" else f"{st['kind']} {st['path']}"
        note = {"todo": "", "done": " (done)", "left out": " (LEFT OUT by the user: don't do it)"}[st["status"]]
        if st.get("edited"):
            note += " (the user changed this command; propose it exactly as written here)"
        lines.append(f"{st['n']}. {what}{note}")
    lines.append("Reads in the plan need no approval. Edits and writes are still shown to the user. Anything outside "
                 "the plan is asked about and flagged; to change course, say why or propose a new plan.")
    return "\n".join(lines)


def audit_step(st):
    return {"n": st["n"], "kind": st["kind"], **({"path": st["path"]} if "path" in st else
                                                 command_fingerprint(st["command"]))}


class Proposal:
    def __init__(self, pid, kind, call_id, **fields):
        self.id, self.kind, self.call_id = pid, kind, call_id
        self.fields = fields
        self.auto = False
        self.decision = None
        self.result = None
        self.error = None          # set when the request is invalid and never shown for a decision
        self.reply = None          # what the model is told instead of "error: ..." (the user still sees error)

    def event(self):
        ev = {"type": "proposal", "id": self.id, "kind": self.kind}
        ev.update({k: v for k, v in self.fields.items() if not k.startswith("_")})
        if self.auto:
            ev["auto"] = True
        return ev


CODING_REFUSED_UNDER_HOME = (".ssh", ".gnupg", ".aws", ".kube", ".docker", ".password-store", ".config/gcloud")


CODING_RISKS = {     # what --coding-anywhere exposes, by the kind of place; shown when it is used
    "home": "every file under your home directory that is not hidden (documents, downloads, every project)",
    "above": "every file under here that is not hidden: your whole home directory, and other people's and the "
             "system's files where you can read them",
    "config": "your endpoint files, every saved session and the audit log; a key file here is read like any other",
    "credentials": "the credentials kept here; only the ones genai recognises as secrets will still ask",
}


def coding_refusal(cwd):
    """Why coding mode is refused in this directory, as (phrase, kind of place), or None. A project directory
    under your home is fine; these are the places that hold much more than one project. Real paths, compared
    by component."""
    def inside(path, root):
        return path == root or path.startswith(root.rstrip("/") + "/")
    here = os.path.realpath(cwd)
    home = os.path.realpath(os.path.expanduser("~"))
    if here == home:
        return "your home directory", "home"
    if inside(home, here):
        return "a directory that contains your home directory", "above"
    if inside(here, os.path.realpath(config_home())):
        return "genai's own config directory", "config"
    for d in CODING_REFUSED_UNDER_HOME:
        if inside(here, os.path.join(home, d)):
            return f"~/{d}, which holds credentials", "credentials"
    return None


class Engine:
    """The loop: send, turn tool calls into proposals, collect decisions, send again."""

    def __init__(self, cfg, endpoint, session, ui, client=None, coding=None, profile=None, anywhere=False):
        """coding: None, or where the request for coding mode came from ("--coding", "profile NAME").
        anywhere: the user passed --coding-anywhere, which allows coding mode where it is normally refused."""
        self.cfg, self.endpoint, self.session, self.ui = cfg, endpoint, session, ui
        self.profile = profile
        self.client = client or Client(endpoint, profile.params if profile else None)
        self.audit = cfg.audit
        self.wd = Workdir(os.getcwd())
        self.external = {}       # name -> tool schema registered by a wrapper
        self.counter = 0
        self.warned = False
        self.sandbox = sandbox_info()
        self.notifier = None     # the notify hook, set by main() when a person is at the terminal
        self.commands = []       # command proposals shown in this process, newest last
        self.skills = []
        self.reload_skills()
        self.anywhere = anywhere
        self.coding_override = None     # the refused place coding mode is on in, when --coding-anywhere allowed it
        self.plan = None                # the plan the user approved, if any; never saved with the session
        self.coding_from = "session" if session.coding else None
        refused = coding_refusal(os.getcwd()) if session.coding else None
        if refused and not anywhere:    # an override is per run: a resumed session needs the flag again
            session.coding, self.coding_from = False, None
            ui.notice(f"coding mode was on for this session, but is refused in {refused[0]}; it is off")
        if coding:
            try:
                self.set_coding(True)
                self.coding_from = coding
            except GenaiError as e:
                if not coding.startswith("profile"):
                    raise
                ui.notice(f"{coding} asks for coding mode, but {e}; it is off")

    # -- setup

    def reload_skills(self):
        self.skills = load_skills(self.cfg, self.session.skills, self.ui.notice)

    def set_coding(self, on, source=":coding"):
        refused = coding_refusal(os.getcwd()) if on else None
        if refused and not self.anywhere:
            raise GenaiError(f"coding mode is refused in {refused[0]}; cd into a project first "
                             "(--coding-anywhere overrides this, and says what that exposes)", EXIT_USAGE)
        self.coding_override = refused[0] if refused else None
        if refused:
            self.ui.notice(f"[!] --coding-anywhere: coding mode is ON in {refused[0]}, where it is normally "
                           f"refused. Without asking you, the model can now read {CODING_RISKS[refused[1]]}. "
                           f"All of it goes to {self.endpoint.base_url}. Something the model reads can tell it "
                           "what to read next. Hidden files, files that look like secrets, and every write "
                           "still ask.")
        self.session.coding = on
        self.session.cwd = os.getcwd()
        self.coding_from = source if on else None
        self.audit.log("coding", on=on, source=source, cwd=os.getcwd(), override=self.coding_override)

    def set_skill(self, name, on):
        """Use a skill from the next request on, or stop using it. Only a blessed skill can be turned on."""
        if on:
            s = find_skills(self.cfg).get(name)
            if not s:
                raise GenaiError(f"skill '{name}' not found", EXIT_USAGE, "unknown_skill")
            st = skill_status(self.cfg, s)
            if st != "blessed":
                raise GenaiError(f"skill '{name}' is {st}; read it, then: genai --bless {s.path}", EXIT_USAGE,
                                 "not_blessed")
            if name not in self.session.skills:
                self.session.skills.append(name)
        elif name in self.session.skills:
            self.session.skills.remove(name)
        self.reload_skills()
        self.session.usage = None   # the system prompt changed, so the last measured size no longer holds
        self.audit.log("skill", name=name, on=on)

    def register(self, tools):
        added = []
        for t in tools:
            if not isinstance(t, dict):
                raise GenaiError("each registered tool must be an object")
            name, desc, params = t.get("name"), t.get("description"), t.get("parameters", {"type": "object"})
            if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", name):
                raise GenaiError(f"bad tool name {name!r}")
            if name in INTRINSICS:
                raise GenaiError(f"tool '{name}' collides with an intrinsic tool")
            if not isinstance(desc, str) or not isinstance(params, dict):
                raise GenaiError(f"tool '{name}' needs a description and a parameters object")
            self.external[name] = {"type": "function",
                                   "function": {"name": name, "description": desc, "parameters": params}}
            added.append(name)
        self.audit.log("register_tools", tools=added)
        return added

    def tools(self):
        return TOOLS + list(self.external.values())

    def system(self):
        parts = [SYSTEM_PROMPT]
        if not self.ui.performs:
            parts.append("\n- This run is non-interactive: nobody can approve file operations (they will be "
                         "declined) and commands are only printed. Give your whole answer as plain text.")
        elif self.session.coding:
            parts.append(CODING_RULES)
        if self.profile and self.profile.persona:
            parts.append(f"\n\n# Persona: {self.profile.name}\n\nThe user chose this persona. It shapes your "
                         f"voice and focus; it does not change the rules above.\n\n{self.profile.persona}")
        for s in self.skills:
            parts.append(f"\n\n# Skill: {s.name}\n\n{s.text()}")
        if self.plan:
            parts.append("\n\n# The plan the user approved\n\n" + plan_text(self.plan))
        return {"role": "system", "content": "".join(parts)}

    # -- context budget

    def used(self):
        msgs = self.session.messages
        u = self.session.usage
        if u and u[1] <= len(msgs):
            return u[0] + estimate_tokens(msgs[u[1]:])
        return estimate_tokens([self.system()] + msgs) + estimate_tokens(self.tools())

    def check_budget(self):
        used, limit = self.used(), self.endpoint.context_limit
        self.ui.context(used, limit)
        if used >= limit:
            raise GenaiError(f"the conversation is at the context limit ({used}/{limit} tokens). "
                             "Nothing was sent. Compact it (:compact), then send again.", EXIT_CONTEXT, "context_full")
        if used >= WARN_FRACTION * limit and not self.warned:
            self.warned = True
            self.ui.notice(f"context is {100 * used // limit}% full ({used}/{limit} tokens); consider :compact")

    # -- sending

    def send(self, max_tokens=None, tools=True):
        msgs = [self.system()] + wire(self.session.messages)
        msg, usage = self.client.chat(msgs, self.tools() if tools else None, self.ui.text, max_tokens)
        self.ui.text_end()
        if usage and usage.get("total_tokens"):
            self.session.usage = (int(usage["total_tokens"]), len(self.session.messages) + 1)
        return msg

    def user_turn(self, text, attachments=()):
        content = text
        for label, body in attachments:
            content += f"\n\n[{label}]\n{body}"
        msg = {"role": "user", "content": content}
        if attachments:
            msg["_bulk"] = True
        self.session.add(msg)
        try:
            self.check_budget()
        except GenaiError:
            self.session.drop_last()
            raise
        try:
            ended = self.loop(checked=True)
            if ended != "command":      # a proposed command has already said so
                self.notify("reply")    # the turn is over: genai now waits for the person
            return ended
        finally:
            self.session.save()

    def loop(self, checked=False):
        for step in range(STEP_LIMIT):
            if step or not checked:
                self.check_budget()
            msg = self.send()
            self.session.add(msg)
            self.session.save()
            calls = msg.get("tool_calls")
            if not calls:
                return "reply"
            props = [self.make_proposal(tc) for tc in calls]
            self.decide(props)
            ended = False
            for p in props:
                result = self.perform(p)
                tool_msg = {"role": "tool", "tool_call_id": p.call_id, "content": result}
                if p.kind in ("read", "list", "external") and p.decision == "accept":
                    tool_msg["_bulk"] = True
                self.session.add(tool_msg)
                if p.kind == "command" and not p.error:
                    ended = True
            self.session.save()
            if ended:
                return "command"
        self.ui.notice(f"step limit ({STEP_LIMIT}) reached; send a message to continue")
        return "step_limit"

    # -- proposals

    def make_proposal(self, tc):
        self.counter += 1
        pid = f"p{self.counter}"
        name = tc["function"]["name"]
        try:
            args = json.loads(tc["function"].get("arguments") or "{}")
            if not isinstance(args, dict):
                raise ValueError
        except ValueError:
            p = Proposal(pid, "invalid", tc["id"], tool=name)
            p.error = "arguments were not a JSON object"
            return p
        reason = str(args.get("reason", ""))
        try:
            if name == "propose_command":
                cmd = args.get("command")
                if not isinstance(cmd, str) or not cmd.strip():
                    raise ValueError("command is required")
                p = Proposal(pid, "command", tc["id"], command=cmd, reason=reason)
                self.commands.append(p)
                return p
            if name in ("read_file", "list_dir"):
                path = args.get("path", ".")
                parts = split_rel(path) if not (name == "list_dir" and path in (".", "./", "")) else []
                kind = "read" if name == "read_file" else "list"
                p = Proposal(pid, kind, tc["id"], path=path, reason=reason)
                if kind == "read":
                    st = self.wd.stat(path)
                    p.fields["size"] = st.st_size if st else None
                if self.read_allowed(parts):
                    p.auto = True
                    if kind == "read":
                        try:
                            secret = looks_secret(self.wd.read(path))
                        except (ValueError, OSError):
                            secret = False
                        if secret:
                            p.auto = False
                            p.fields["secret"] = True
                            self.ui.notice(f"{path} looks like it contains secrets, "
                                           "so reading it needs your OK even in coding mode")
                return p
            if name == "write_file":
                path, content = args.get("path"), args.get("content")
                split_rel(path)
                if not isinstance(content, str):
                    raise ValueError("content must be a string")
                state = self.wd.state(path)
                exists = state is not None
                fields = {"path": path, "exists": exists, "content": content, "reason": reason, "_state": state,
                          "lines": content.count("\n") + (0 if content.endswith("\n") or not content else 1)}
                if exists:
                    try:
                        fields["diff"] = unified_diff(self.wd.read(path, WRITE_CAP), content, path)
                    except (ValueError, OSError) as e:
                        st = self.wd.stat(path)
                        fields.update(diff=f"(cannot diff the existing file: {e})", undiffable=str(e),
                                      mode=f"{stat.S_IMODE(st.st_mode):04o}" if st else None)
                return Proposal(pid, "write", tc["id"], **fields)
            if name == "edit_file":
                path, old, new = args.get("path"), args.get("old_text"), args.get("new_text")
                if not isinstance(old, str) or not isinstance(new, str) or not old:
                    raise ValueError("old_text and new_text are required")
                parts = split_rel(path)
                try:
                    current = self.wd.read(path, WRITE_CAP)
                    n = current.count(old)
                    if n != 1:
                        raise ValueError(f"old_text appears {n} times in {path}; it must appear exactly once")
                except (ValueError, OSError) as e:
                    if self.read_allowed(parts):
                        raise
                    # The model may not learn anything about this file, so it only hears "declined".
                    p = Proposal(pid, "invalid", tc["id"], tool=name)
                    p.error = f"edit of {show_exact(path)} not applied, and the model was only told it was declined: {e}"
                    p.reply = "declined by the user"
                    return p
                updated = current.replace(old, new, 1)
                return Proposal(pid, "edit", tc["id"], path=path, diff=unified_diff(current, updated, path),
                                reason=reason, _old=old, _new=new,
                                _state="sha256:" + hashlib.sha256(current.encode()).hexdigest())
            if name == "propose_plan":
                return Proposal(pid, "plan", tc["id"], **parse_plan(args))
            if name in self.external:
                return Proposal(pid, "external", tc["id"], tool=name, args=args)
            raise ValueError(f"unknown tool '{name}'")
        except (ValueError, OSError) as e:
            p = Proposal(pid, "invalid", tc["id"], tool=name)
            p.error = str(e)
            if isinstance(e, (DiskError, OSError)):
                try:
                    parts = split_rel(args.get("path", "."))
                except ValueError:
                    parts = [".hidden"]
                if not self.read_allowed(parts):    # on-disk facts are for the user, not the model
                    p.error = f"{name} of {show_exact(str(args.get('path')))} failed, and the model was only told " \
                              f"it was declined: {e}"
                    p.reply = "declined by the user"
            return p

    def files(self, path):
        """One directory as a file tree shows it: each entry, whether it looks like it holds secrets, and
        whether reading it would ask first. Contents are read only to classify them; none of this reaches
        the model. secret is None when genai would not read the file at all (too big, binary, unreadable)."""
        parts = split_rel(path) if path not in ("", ".", "./") else []
        rows = []
        for name, kind, size in sorted(self.wd.list(path)):
            sub = parts + [name]
            row = {"name": name, "kind": kind, "size": size, "hidden": is_hidden(sub)}
            if kind == "file":
                try:
                    row["secret"] = looks_secret(self.wd.read("/".join(sub)))
                except (ValueError, OSError):
                    row["secret"] = None
                row["asks"] = not self.read_allowed(sub) or row["secret"] is not False
            rows.append(row)
        return rows

    def read_allowed(self, parts):
        """Would reading this path be allowed without asking? (coding mode, not hidden)"""
        return bool(self.session.coding and not is_hidden(parts) and self.ui.performs)

    def decide(self, props):
        for p in props:
            if not p.error:
                self.match_plan(p)
        for p in props:
            p.decision = None
            if p.error:
                self.audit.log("invalid_call", id=p.id, tool=p.fields.get("tool"), error=p.error)
                if p.reply:
                    self.ui.notice(f"[{p.id}] {p.error}")
                continue
            rec = {k: v for k, v in p.event().items() if k not in ("type", "content", "diff", "command", "steps")}
            if p.kind == "command":
                rec.update(command_fingerprint(p.fields["command"]))
            if p.kind == "plan":
                rec["steps"] = [audit_step(st) for st in p.fields["steps"]]
            self.audit.log("proposal", **rec)
        live = [p for p in props if not p.error]
        for p in live:
            if p.kind == "command":
                self.ui.show_command(p)
            elif p.auto:
                p.decision = "accept"
                self.ui.show_auto(p)
        if any(p.kind == "command" for p in live):
            self.notify("command")      # once, however many commands were shown
        pending = [p for p in live if p.kind != "command" and not p.auto]
        if pending:
            self.notify("approval", count=len(pending), kinds=sorted({p.kind for p in pending}))
            self.ui.decide(pending)
        for p in pending:
            if p.kind != "external":
                p.decision = p.decision if p.decision in ("accept", "decline") else "decline"
                self.audit.log("decision", id=p.id, decision=p.decision)
            if p.kind == "plan" and p.decision == "accept":
                self.adopt_plan(p)

    def match_plan(self, p):
        """Hold a proposal to the approved plan. A planned read needs no approval (unless the file is hidden or
        looks secret); a planned command, word for word as approved, is marked preapproved, for the wrapper to run
        without asking again; a planned edit or write is labelled, and still asks. A command, edit or write the
        plan doesn't name is flagged off_plan. genai still runs nothing itself."""
        if not self.plan or p.kind not in ("command", "read", "list", "edit", "write"):
            return
        steps = [st for st in self.plan["steps"] if st["approved"]]
        if p.kind == "command":
            hit = next((st for st in steps if st["kind"] == "command" and st["command"] == p.fields["command"]), None)
        else:
            try:
                where = "/".join(split_rel(p.fields["path"])) if p.fields["path"] not in (".", "./", "") else ""
            except ValueError:
                return
            kinds = ("read",) if p.kind in ("read", "list") else ("edit", "write")
            hit = next((st for st in steps if st["kind"] in kinds and st["_where"] == where), None)
        if hit is None:
            if p.kind in ("command", "edit", "write"):
                p.fields["off_plan"] = True
            return
        p.fields["plan_step"] = hit["n"]
        if p.kind == "command":
            p.fields["preapproved"] = True
            hit["status"] = "done"
        elif p.kind in ("read", "list") and not p.auto:
            parts = split_rel(p.fields["path"]) if hit["_where"] else []
            secret = None
            if p.kind == "read" and not is_hidden(parts):
                try:
                    secret = looks_secret(self.wd.read(p.fields["path"]))
                except (ValueError, OSError):
                    secret = False
            if is_hidden(parts) or secret:
                if secret:
                    p.fields["secret"] = True
                return                                  # in the plan, but still asks
            p.auto = True
        self.audit.log("plan_match", id=p.id, step=hit["n"], kind=p.kind)
        self.ui.plan(self.plan)

    def adopt_plan(self, p):
        approve = getattr(p, "approve", None)
        edits = getattr(p, "edits", None) or {}
        steps = []
        for st in p.fields["steps"]:
            st = dict(st)
            st["approved"] = approve is None or st["n"] in approve
            if st["kind"] == "command" and st["approved"] and edits.get(st["n"]):
                st["command"], st["edited"] = edits[st["n"]], True
            st["status"] = "todo" if st["approved"] else "left out"
            st["_where"] = "/".join(split_rel(st["path"])) if st.get("path") not in (None, ".", "./", "") else ""
            steps.append(st)
        self.plan = {"id": p.id, "goal": p.fields["goal"], "steps": steps}
        self.audit.log("plan", id=p.id, approved=[st["n"] for st in steps if st["approved"]],
                       edited=[st["n"] for st in steps if st.get("edited")])
        self.ui.plan(self.plan)

    def clear_plan(self):
        if self.plan:
            self.audit.log("plan_cleared", id=self.plan["id"])
        self.plan = None
        self.ui.plan(None)

    def notify(self, event, **fields):
        """Tell the notify hook, if there is one, that genai is now waiting for the person."""
        if self.notifier:
            self.notifier.fire(event, **fields)

    def perform(self, p):
        if p.error:
            return p.reply or f"error: {p.error}"
        if p.kind == "command":
            return "shown to the user, not run. If they run it, they may send you the output."
        if p.kind == "plan":
            if p.decision != "accept" or not self.plan or self.plan["id"] != p.id:
                return "declined by the user: the plan was not approved. Ask what they want instead."
            return ("The user approved this plan. Carry it out step by step, without asking first.\n"
                    + plan_text(self.plan))
        if p.kind == "external":
            status = p.decision if p.decision in ("ok", "declined", "error") else "declined"
            out, counts = redact(str(p.result or ""), self.secrets())
            self.audit.log("external_result", id=p.id, tool=p.fields["tool"], status=status,
                           chars=len(out), redacted=counts)
            return f"{status}" + (f":\n{clip(out)}" if out else "")
        if p.decision != "accept":
            return "declined by the user"
        try:
            if p.kind == "read":
                text = self.wd.read(p.fields["path"])
                result = text
                note = f"read {len(text)} characters"
                if looks_secret(text):
                    self.ui.notice(f"warning: {p.fields['path']} looks like it contains secrets; it was sent as is")
            elif p.kind == "list":
                rows = self.wd.list(p.fields["path"])
                lines = [f"{n}/" if k == "dir" else f"{n}  ({s} bytes)" if k == "file" else f"{n}  [{k}]"
                         for n, k, s in rows[:LIST_CAP]]
                if len(rows) > LIST_CAP:
                    lines.append(f"... {len(rows) - LIST_CAP} more entries")
                result = "\n".join(lines) or "(empty directory)"
                note = f"listed {len(rows)} entries"
            elif p.kind in ("write", "edit") and self.wd.state(p.fields["path"]) != p.fields["_state"]:
                self.audit.log("file_op", id=p.id, kind=p.kind, path=p.fields["path"], status="stale")
                self.ui.result(p, "error", f"{p.fields['path']} changed after you reviewed it "
                                           "(another proposal or an editor), so nothing was written")
                return (f"not applied: {p.fields['path']} changed since the user reviewed your proposal; "
                        "propose the change again")
            elif p.kind == "write":
                n = self.wd.write(p.fields["path"], p.fields["content"])
                result = note = f"wrote {p.fields['path']} ({n} bytes)"
            elif p.kind == "edit":
                current = self.wd.read(p.fields["path"], WRITE_CAP)
                if current.count(p.fields["_old"]) != 1:
                    raise ValueError("the file changed before the edit was applied")
                self.wd.write(p.fields["path"], current.replace(p.fields["_old"], p.fields["_new"], 1))
                result = note = f"edited {p.fields['path']}"
            else:
                return "error: unknown proposal"
        except (ValueError, OSError) as e:
            self.audit.log("file_op", id=p.id, kind=p.kind, path=p.fields.get("path"), status="error", error=str(e))
            self.ui.result(p, "error", str(e))
            return f"error: {e}"
        self.audit.log("file_op", id=p.id, kind=p.kind, path=p.fields.get("path"), status="ok", auto=p.auto)
        self.ui.result(p, "ok", note)
        step = p.fields.get("plan_step")
        if step and self.plan:
            for st in self.plan["steps"]:
                if st["n"] == step:
                    st["status"] = "done"
            self.ui.plan(self.plan)
        return result

    # -- sharing output and compaction

    def share(self, source, text, ref=None):
        """Record that reviewed output is being sent to the model."""
        self.audit.log("shared", source=source, ref=ref, chars=len(text))

    def secrets(self):
        """Exact values to mask in text bound for the model: the endpoint key."""
        return [getattr(self.client, "_key", None)]

    def compact(self, edit_summary=None):
        """Prune old bulk, then summarize older turns only if still over the warning line."""
        msgs = self.session.messages
        user_idx = [i for i, m in enumerate(msgs) if m.get("role") == "user"]
        keep_from = user_idx[-KEEP_TURNS] if len(user_idx) >= KEEP_TURNS else 0
        before = self.used()
        pruned = 0
        for i in range(keep_from):
            m = msgs[i]
            if m.get("_bulk") and not m.get("_pruned"):
                if m.get("role") == "tool":
                    m["content"] = "[contents dropped by compaction; read again if needed]"
                else:
                    first = (m.get("content") or "").split("\n\n[", 1)[0]
                    m["content"] = first + "\n\n[attached contents dropped by compaction; ask for them again if needed]"
                m["_pruned"] = True
                pruned += 1
        self.session.usage = None
        after = self.used()
        report = {"pruned": pruned, "before": before, "after": after, "summary": None}
        if after >= WARN_FRACTION * self.endpoint.context_limit and keep_from > 0:
            older, tail = msgs[:keep_from], msgs[keep_from:]
            req = wire(older) + [{"role": "user", "content":
                   f"Summarize the conversation so far in at most {SUMMARY_WORDS} words for your own later use: "
                   "facts learned, decisions made, files touched, and open questions. Plain text only."}]
            saved_msgs = self.session.messages
            self.session.messages = req
            try:
                summary = (self.send(max_tokens=SUMMARY_WORDS * 3, tools=False).get("content") or "").strip()
            finally:
                self.session.messages = saved_msgs
                self.session.usage = None
            if edit_summary:
                summary = edit_summary(summary)
            if summary:
                first = dict(tail[0])
                first["content"] = f"[Summary of the earlier conversation]\n{summary}\n\n[Next message]\n{first['content']}"
                self.session.messages = [first] + tail[1:]
                self.session.usage = None
                report["summary"] = summary
                report["after"] = self.used()
        self.audit.log("compact", **{k: v for k, v in report.items() if k != "summary"},
                       summarized=bool(report["summary"]))
        self.session.save()
        return report


# --------------------------------------------------------------------------
# Front ends

class PlainUI:
    """No terminal, not JSON: print text and command proposals; perform nothing."""
    performs = False

    def __init__(self, out=sys.stdout):
        self.out = out
        self._open = False
        self._flagged = False

    def text(self, chunk):
        # Escaping is per character, so a chunk boundary can't split or hide anything.
        disp, flagged = exact(chunk)
        self._flagged = self._flagged or flagged
        self.out.write(disp)
        self.out.flush()
        self._open = True

    def text_end(self):
        if self._open:
            self.out.write("\n")
            self.out.flush()
            if self._flagged:      # stderr, so `genai ... > file` keeps only the reply
                eprint("  [!] hidden or control characters were escaped above")
            self._open = False
            self._flagged = False

    def notice(self, msg):
        eprint(f"genai: {one_line(msg)[0]}")

    def context(self, used, limit):
        pass

    def show_command(self, p):
        self.out.write(f"\n[proposed command {p.id}] {one_line(p.fields['reason'])[0]}\n"
                       f"    {show_exact(p.fields['command'])}\n")
        note = non_ascii_line(p.fields["command"])
        if note:
            self.out.write(note + "\n")
        self.out.flush()

    def show_auto(self, p):
        pass

    def decide(self, pending):
        for p in pending:
            p.decision = "decline" if p.kind != "external" else "declined"
            what = p.fields.get("path") or p.fields.get("tool") or p.fields.get("goal")
            self.notice(f"{p.kind} proposal {p.id} ({one_line(str(what))[0]}) declined: no terminal")

    def result(self, p, status, note):
        pass

    def plan(self, plan):
        pass


def margin(text):
    """Escape a multi-line body and put a margin on every line, so it can't pass for genai's own prompts."""
    return "\n".join("    | " + ln for ln in show_exact(text).splitlines() or [""])


class TtyUI(PlainUI):
    """A human at a terminal: ask about each file proposal."""
    performs = True

    def __init__(self, out=sys.stdout):
        super().__init__(out)

    def show_command(self, p):
        cmd = show_exact(p.fields["command"])
        note = non_ascii_line(p.fields["command"])
        self.out.write(f"\n\033[1mProposed command [{p.id}]\033[0m: {one_line(p.fields['reason'])[0]}\n\n    {cmd}\n"
                       + (note + "\n" if note else "") +
                       "\nPaste it into your shell, or type :run to review and run it.\n")
        self.out.flush()

    def show_auto(self, p):
        eprint(f"  (coding mode) {p.kind} {one_line(p.fields['path'])[0]}")

    def decide(self, pending):
        for p in pending:
            f = p.fields
            path = one_line(str(f.get("path", "")))[0]
            if p.kind == "read":
                size = "missing" if f.get("size") is None else f"{f['size']} bytes"
                head = f"Read {path} ({size})?"
            elif p.kind == "list":
                head = f"List directory {path}?"
            elif p.kind == "write":
                if f["exists"] and f.get("undiffable"):
                    mode = f.get("mode")
                    keep = f"keeps mode {mode} (executable)" if mode and int(mode, 8) & 0o111 else "keeps its mode"
                    head = (f"Overwrite {path}:\n  the existing file can't be diffed: {one_line(f['undiffable'])[0]}\n"
                            f"  it will be replaced entirely, and {keep}\n"
                            f"  the new content, {f['lines']} lines:\n{margin(f['content'])}")
                elif f["exists"]:
                    head = f"Overwrite {path}:\n{margin(f.get('diff') or '(no changes)')}"
                else:
                    head = f"New file {path}, {f['lines']} lines:\n{margin(f['content'])}"
            elif p.kind == "edit":
                head = f"Edit {path}:\n{margin(f['diff'])}"
            elif p.kind == "plan":
                self.out.write(f"\n\033[1m[{p.id}] plan\033[0m — {one_line(f['goal'])[0]}\n{margin(plan_steps(f['steps']))}\n"
                               "Planned reads won't ask again; a planned command proposed exactly as shown is "
                               "marked as approved; edits still ask.\n")
                self.out.flush()
                p.decision, p.approve = pick_steps(p, f["steps"])
                continue
            else:
                head = f"Call {p.kind}?"
            self.out.write(f"\n\033[1m[{p.id}] {p.kind}\033[0m — {one_line(f.get('reason', ''))[0]}\n{head}\n")
            self.out.flush()
            p.decision = "accept" if ask_yes(f"Accept {p.id}?") else "decline"

    def result(self, p, status, note):
        eprint(f"  [{p.id}] {status}: {one_line(note)[0]}")


def plan_steps(steps):
    return "\n".join(f"{st['n']:>2}. " + (f"run   {st['command']}" if st["kind"] == "command" else
                                          f"{st['kind']:5} {st['path']}") + f"\n      {st['why']}" for st in steps)


def pick_steps(p, steps):
    """Ask which steps of a plan to approve: (decision, approved step numbers or None for all)."""
    try:
        ans = input(f"Approve {p.id}? [a]ll, n[one], or step numbers such as 1,2,4: ").strip().lower()
    except EOFError:
        return "decline", None
    if ans in ("a", "all", "y", "yes"):
        return "accept", None
    nums = {int(x) for x in re.findall(r"[0-9]+", ans)} & {st["n"] for st in steps}
    return ("accept", sorted(nums)) if nums and re.fullmatch(r"[0-9 ,]+", ans) else ("decline", None)


def ask_yes(question):
    try:
        ans = input(f"{question} [y/N] ")
    except EOFError:
        return False
    return ans.strip().lower() in ("y", "yes")


def plan_choice(p, msg):
    """A wrapper's choice of steps (approve: [numbers], default all) and edited commands (edits: {number: command}).
    False if either is malformed."""
    numbers = {st["n"]: st for st in p.fields["steps"]}
    approve, edits = msg.get("approve"), msg.get("edits", {})
    if approve is not None and (not isinstance(approve, list) or not approve
                                or not all(type(n) is int and n in numbers for n in approve)):
        return False
    if not isinstance(edits, dict):
        return False
    p.approve, p.edits = (sorted(set(approve)) if approve is not None else None), {}
    for key, cmd in edits.items():
        n = int(key) if str(key).isdigit() else None
        if n not in numbers or numbers[n]["kind"] != "command" or not isinstance(cmd, str) or not cmd.strip():
            return False
        p.edits[n] = cmd
    return True


class JsonUI:
    """JSON Lines over stdio for wrappers and TUIs."""
    performs = True

    def __init__(self, inp=sys.stdin, out=sys.stdout):
        self.inp, self.out = inp, out
        self.queue = []          # attachments waiting for the next user message
        self.engine = None

    def emit(self, ev):
        self.out.write(json.dumps(ev, ensure_ascii=False) + "\n")
        self.out.flush()

    def error(self, message, code="error", **extra):
        ev = {"type": "error", "code": code, "message": message}
        ev.update(extra)
        self.emit(ev)

    def text(self, chunk):
        self.emit({"type": "text", "text": chunk})

    def text_end(self):
        pass

    def notice(self, msg):
        self.emit({"type": "notice", "message": msg})

    def context(self, used, limit):
        if used >= WARN_FRACTION * limit:
            self.emit({"type": "context", "used": used, "limit": limit})

    def show_command(self, p):
        ev = p.event()
        disp, flagged = exact(p.fields["command"])
        if flagged:
            ev["display"], ev["flagged"] = disp, True
        if non_ascii_chars(p.fields["command"]):
            ev["non_ascii"] = [f"U+{ord(c):04X}" for c in non_ascii_chars(p.fields["command"])]
        self.emit(ev)

    def show_auto(self, p):
        self.emit(p.event())

    def plan(self, plan):
        self.emit({"type": "plan", "plan": None if plan is None else {
            "id": plan["id"], "goal": plan["goal"],
            "steps": [{k: v for k, v in st.items() if not k.startswith("_")} for st in plan["steps"]]}})

    def decide(self, pending):
        """Emit every blocking proposal, then wait for decisions in any order.
        No answer, EOF, or an unknown ID means decline."""
        for p in pending:
            ev = p.event()
            for key in ("content", "diff", "path", "undiffable"):
                if isinstance(ev.get(key), str):
                    disp, flagged = exact(ev[key])
                    if flagged:
                        ev.setdefault("flagged", []).append(key)
            if p.kind == "plan" and any(exact(st.get("command") or st.get("path") or "")[1] for st in ev["steps"]):
                ev.setdefault("flagged", []).append("steps")
            self.emit(ev)
        waiting = {p.id: p for p in pending}
        while waiting:
            msg = self.read()
            if msg is None:
                break
            t = msg.get("type")
            pid = msg.get("id")
            if t == "decision" and pid in waiting and waiting[pid].kind != "external":
                p = waiting.pop(pid)
                p.decision = msg.get("decision") if msg.get("decision") in ("accept", "decline") else "decline"
                if p.kind == "plan" and p.decision == "accept" and not plan_choice(p, msg):
                    p.decision = "decline"
                    self.error(f"{pid}: approve must list step numbers, and edits map a command step's number to "
                               "its new command; the plan was declined", "bad_message")
            elif t == "result" and pid in waiting and waiting[pid].kind == "external":
                p = waiting.pop(pid)
                p.decision = msg.get("status") if msg.get("status") in ("ok", "declined", "error") else "declined"
                p.result = msg.get("output", "")
            elif t in ("decision", "result"):
                self.error(f"no pending proposal {pid!r} of that kind", "unknown_id")
            elif t == "attach":
                self.queue_attach(msg)
            elif t in ("trace", "system"):
                inspect(self.engine, self, msg)
            else:
                self.error(f"'{t}' is not allowed while proposals are pending", "busy")
        for p in waiting.values():
            p.decision = "declined" if p.kind == "external" else "decline"
            p.result = ""

    def queue_attach(self, msg):
        text = msg.get("text")
        if not isinstance(text, str):
            self.error("attach needs 'text'", "bad_message")
            return
        red, counts = redact(text, self.engine.secrets() if self.engine else ())
        red = clip(red)
        label = str(msg.get("label") or "attachment")
        self.queue.append((label, red, msg.get("ref")))
        self.emit({"type": "attached", "label": label, "chars": len(red), "redacted": counts})

    def result(self, p, status, note):
        self.emit({"type": "result", "id": p.id, "status": status, "detail": note})

    def read(self):
        while True:
            line = self.inp.readline()
            if not line:
                return None
            line = line.strip()
            if not line:
                continue
            try:
                msg = json.loads(line)
                if not isinstance(msg, dict) or not isinstance(msg.get("type"), str):
                    raise ValueError("a message must be an object with a 'type'")
                return msg
            except ValueError as e:
                self.error(f"bad message: {e}", "bad_message")


