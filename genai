  :context        show how full the context is
  :models         list the models the server offers   :model NAME   use one of them from now on
  :clear          start over: the model forgets this conversation (the saved session keeps it)
  :skills         list skills, marking the ones in use
  :skill NAME on|off  use a blessed skill from the next message on, or stop using it
  :bless PATH     bless a skill, endpoint or profile
  :sandbox        where genai and your commands run: in a sandbox or on this host
  :help           this text            :quit         leave"""


HOOK_BANNER = "hook: notify (runs {} when genai waits for you)"


def sandbox_work_host():
    """The host path of /work, as sandbox/run reported it. Display only, so it is escaped."""
    return one_line(os.environ.get("GENAI_SANDBOX_WORK_HOST", "").strip())[0]


class Repl:
    def __init__(self, engine):
        self.e = engine
        self.capture = False
        self.attachments = []

    def in_sandbox(self):
        """Is genai itself running in a sandbox? Then the prompt and banner say so."""
        return bool(getattr(self.e, "sandbox", None))

    def banner(self):
        p = self.e.endpoint
        print(f"genai {VERSION} — {one_line(p.name)[0]}: {one_line(p.model)[0]} at {one_line(p.base_url)[0]}")
        if self.in_sandbox():
            name = one_line(self.e.sandbox["name"])[0]
            host = sandbox_work_host()
            line = (f"IN THE {name.upper()} SANDBOX: /work" + (f" = {host}" if host else "") +
                    ", no host home (:sandbox for details)")
            print(f"\033[1m{line}\033[0m" if sys.stdout.isatty() else line)
        if os.geteuid() == 0:
            print(f"  [!] running as root on {one_line(socket.gethostname())[0]}: "
                  "every command it proposes would run as root")
        if self.e.profile:
            d = self.e.profile.description
            print(f"profile {one_line(self.e.profile.name)[0]}" + (f": {one_line(d)[0]}" if d else ""))
        s = self.e.session
        if s.id:
            print(f"session {s.id}" + (" (resumed)" if s.resumed else ""))
        if s.coding:
            print(f"coding mode is ON ({self.e.coding_from or 'session'}): "
                  "the model can read and list files here without asking")
            if self.e.coding_override:
                print(f"  [!] this is {self.e.coding_override}; --coding-anywhere allowed it")
        print(f"sandbox: commands you :run or :sh execute {where_runs(self.e.sandbox)}")
        if self.e.box:
            print("  " + self.box_line())
        if self.e.notifier:
            print("  " + HOOK_BANNER.format(short_path(self.e.notifier.path)))
        print("Type :help for commands. A line with only '..' sends.")

    def do_sandbox(self):
        sb = self.e.sandbox
        print(f"genai runs {where_runs(sb)}")
        if sb:
            host = sandbox_work_host()
            print(f"  working directory: {one_line(os.getcwd())[0]}"
                  + (f" (/work is {host} on the host, writable)" if host else ""))
            print("  the repo is at /opt/genai, read-only; the host's /usr and /etc are read-only; "
                  "nothing else from your home")
            print(f"  config: {one_line(short_path(self.e.cfg.home))[0]} (the sandbox's own, not your real one)")
            print("  changes outside /work and the config directory are discarded when it exits")
            try:
                host_name = urllib.parse.urlsplit(self.e.endpoint.base_url).hostname
                socket.getaddrinfo(host_name, None)
                print(f"  network: the endpoint's host {one_line(host_name)[0]} resolves, so the network looks available")
            except (OSError, ValueError, TypeError):
                print("  network: the endpoint's host does not resolve here, so the network looks off")
            print("  sandbox/run shell opens a shell in it (from the host)")
        else:
            print("  sandbox/run genai runs genai in a podman sandbox instead (see the README)")
        if self.e.box:
            print("  profile sandbox: " + self.box_line())

    def box_line(self):
        b = self.e.box
        problem = b.problem()
        if problem:
            return f"the profile's sandbox can't run here: {problem}"
        state = ("the model runs commands there itself, without asking" if self.e.can_run() else
                 "it is used in coding mode")
        return (f"podman sandbox ({one_line(b.conf['image'])[0]}), network {'ON: each run asks' if b.network else 'off'}"
                f"; {state}")

    def run(self):
        try:
            import readline  # noqa: F401  (line editing and in-memory history)
        except ImportError:
            pass
        self.banner()
        buf = []
        while True:
            try:
                mark = "(sandbox) " if self.in_sandbox() else ""
                line = input(mark + ("> " if not buf else ". "))
            except EOFError:
                print()
                if buf:
                    self.send("\n".join(buf))
                    buf = []
                    continue
                return EXIT_OK
            except KeyboardInterrupt:
                print("^C (buffer cleared)" if buf else "^C (:quit to leave)")
                buf = []
                continue
            if not buf and line.startswith(":"):
                if self.command(line) == "quit":
                    return EXIT_OK
                continue
            if line.strip() == "..":
                if buf:
                    self.send("\n".join(buf))
                buf = []
                continue
            buf.append(line)

    def send(self, text, attachments=None):
        att = attachments if attachments is not None else self.attachments
        self.attachments = []
        try:
            self.e.user_turn(text, att)
        except KeyboardInterrupt:
            print("\n(interrupted)")
        except GenaiError as err:
            print(f"genai: {exact(str(err))[0]}")

    def command(self, line):
        cmd, _, arg = line[1:].partition(" ")
        arg = arg.strip()
        try:
            if cmd in ("q", "quit", "exit"):
                return "quit"
            elif cmd == "help":
                print(HELP)
            elif cmd == "sandbox":
                self.do_sandbox()
            elif cmd == "run":
                self.do_run(arg)
            elif cmd == "sh":
                self.do_sh()
            elif cmd == "capture":
                self.capture = arg == "on"
                print(f":sh capture is {'on' if self.capture else 'off'}")
            elif cmd == "attach":
                self.do_attach(arg)
            elif cmd == "plan":
                if arg == "clear":
                    self.e.clear_plan()
                    print("plan dropped: everything asks again")
                elif not self.e.plan:
                    print("no plan approved")
                else:
                    print(show_exact(plan_text(self.e.plan)))
            elif cmd == "coding":
                self.e.set_coding(arg == "on")
                self.e.session.save()
                print(f"coding mode is {'ON' if self.e.session.coding else 'off'}")
            elif cmd == "network":
                if arg in ("on", "off"):
                    self.e.set_network(arg == "on")
                if not self.e.box:
                    print("no sandbox: the profile has no 'sandbox'")
                else:
                    print(self.box_line())
            elif cmd == "compact":
                self.do_compact(arg == "-e")
            elif cmd == "clear":
                n = self.e.clear()
                print(f"context cleared: the model starts over ({n} messages dropped; "
                      f"{'the saved session keeps them' if self.e.session.path else 'they were not saved'})")
            elif cmd == "models":
                for mid, n in self.e.client.model_list():
                    mark = "*" if mid == self.e.endpoint.model else " "
                    print(f" {mark} {mid}" + (f"  ({n} tokens)" if n else ""))
            elif cmd == "model":
                if not arg:
                    print(f"model: {self.e.endpoint.model} (:models lists the others, :model NAME switches)")
                else:
                    print(f"model: {self.e.set_model(arg, ':model')} from your next message")
            elif cmd == "context":
                print(f"context: {self.e.used()}/{self.e.endpoint.context_limit} tokens (estimated)")
            elif cmd == "skills":
                print("\n".join(skill_lines(skill_rows(self.e.cfg, [s.name for s in self.e.skills]), mark=True)))
            elif cmd == "skill":
                name, _, state = arg.partition(" ")
                if not name or state.strip() not in ("on", "off"):
                    print("usage: :skill NAME on|off")
                else:
                    self.e.set_skill(name, state.strip() == "on")
                    self.e.session.save()
                    print(f"skill {one_line(name)[0]} is {'on' if state.strip() == 'on' else 'off'} "
                          "from your next message")
            elif cmd == "bless":
                if bless(self.e.cfg, arg, ask_yes):
                    self.e.reload_skills()
            else:
                print(f"unknown command :{cmd} (try :help)")
        except GenaiError as err:
            print(f"genai: {exact(str(err))[0]}")

    def do_attach(self, path):
        data = read_attachment(path)
        self.attachments.append((f"file {path}", data))
        print(f"attached {one_line(path)[0]} ({len(data)} characters) to your next message")

    def do_run(self, pid):
        props = [p for p in self.e.commands if not pid or p.id == pid]
        if not props:
            print("no command proposal to run" + (f" with id {pid}" if pid else ""))
            return
        p = props[-1]
        reason = " ".join(exact(p.fields["reason"])[0].split())
        edited = edit_text(p.fields["command"], f"Proposed command [{p.id}]: {reason}",
                           "the command that will run, as you", "cancel")
        if not edited.strip():
            print("Cancelled.")
            return
        where = where_runs(self.e.sandbox)
        print(f"\nThis will run {where}, in your shell, as you:\n\n    {show_exact(edited)}\n")
        if not ask_yes("Run it?"):
            print("Cancelled.")
            return
        shell = os.environ.get("SHELL") or "/bin/sh"
        self.e.audit.log("run", id=p.id, **command_fingerprint(edited), edited=edited != p.fields["command"],
                         sandbox=self.e.sandbox)
        captured, proc = [], None
        try:
            proc = subprocess.Popen([shell, "-c", edited], stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            for chunk in iter(lambda: proc.stdout.read1(4096), b""):
                sys.stdout.buffer.write(chunk)
                sys.stdout.flush()
                if sum(len(c) for c in captured) < OUTPUT_CAP * 8:
                    captured.append(chunk)
            rc = proc.wait()
        except KeyboardInterrupt:
            if proc is None:
                return
            proc.kill()
            rc = proc.wait()
        self.e.audit.log("run_exit", id=p.id, exit=rc, sandbox=self.e.sandbox)
        print(f"\n[exit {rc}; ran {where}]")
        out = strip_ansi(b"".join(captured).decode("utf-8", "replace"))
        kept = review_output(self.e, "run", [f"I ran this command {where} (exit {rc}):", "```", edited, "```", "Output:"],
                             out, f"Output of: {' '.join(exact(edited)[0].split())} (exit {rc})")
        if kept:
            self.send(kept)

    def do_sh(self):
        shell = os.environ.get("SHELL") or "/bin/sh"
        self.e.audit.log("sh", capture=self.capture, sandbox=self.e.sandbox)
        print(f"[subshell runs {where_runs(self.e.sandbox)}]")
        if not self.capture:
            print("Subshell; exit to come back. Output is not captured (:capture on to share it).")
            subprocess.call([shell])
            return
        if not shutil.which("script"):
            print("capture needs the 'script' program; opening the subshell without capture")
            subprocess.call([shell])
            return
        fd, log = tempfile.mkstemp(prefix="genai-sh-")
        os.close(fd)
        os.chmod(log, 0o600)
        try:
            print("Subshell with capture; exit to come back and review what to share.")
            subprocess.call(["script", "-q", "-c", shell, log])
            with open(log, encoding="utf-8", errors="replace") as f:
                text = strip_ansi(f.read())
        finally:
            os.unlink(log)
        kept = review_output(self.e, "sh", [f"Output from my shell session, which ran {where_runs(self.e.sandbox)}:"],
                             text, "Output of: :sh session")
        if kept:
            self.send(kept)

    def do_compact(self, edit):
        report = self.e.compact(
            edit_summary=(lambda s: edit_text(s, "Compaction summary", "what the model keeps of older turns",
                                              "drop the summary")) if edit else None)
        print(f"pruned {report['pruned']} items: {report['before']} -> {report['after']} tokens (estimated)")
        if report["summary"]:
            print(f"\nSummary of older turns (sent instead of them):\n{show_exact(report['summary'])}\n")


_ANSI = re.compile(r"\x1b\[[0-9;?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]|\r")


def strip_ansi(text):
    return _ANSI.sub("", text)


def read_attachment(path):
    try:
        with open(os.path.expanduser(path), "rb") as f:
            data = f.read(ATTACH_CAP + 1)
    except OSError as e:
        raise GenaiError(f"cannot read {path}: {e.strerror}", EXIT_USAGE)
    if len(data) > ATTACH_CAP:
        raise GenaiError(f"{path} is larger than {ATTACH_CAP} bytes", EXIT_USAGE)
    if b"\0" in data[:8192]:
        raise GenaiError(f"{path} looks binary; refused", EXIT_USAGE)
    text = data.decode("utf-8", "replace")
    if looks_secret(text):
        eprint(f"genai: warning: {one_line(path)[0]} looks like it contains secrets; it is sent as is "
               "(files are not redacted)")
    return text


