# JSON mode driver

def inspect(engine, ui, msg):
    """trace and system: what was sent to the endpoint and what came back, or what the next request will
    carry besides the conversation. Read only, so allowed while proposals are pending."""
    if msg.get("type") == "system":
        ui.emit({"type": "system", "system": engine.system()["content"], "tools": engine.tools(),
                 "model": engine.endpoint.model, "params": getattr(engine.client, "params", {})})
        return
    trace = list(getattr(engine.client, "trace", []))
    lo, hi = msg.get("from"), msg.get("to")
    if type(lo) is not int or type(hi) is not int:
        lo = hi = trace[-1]["n"] if trace else 0
    ui.emit({"type": "trace", "from": lo, "to": hi, "kept": [trace[0]["n"], trace[-1]["n"]] if trace else None,
             "exchanges": [{k: v for k, v in ex.items() if k != "started"} for ex in trace if lo <= ex["n"] <= hi]})


def whoami():
    """The effective user's name (the uid if it has none) and uid."""
    uid = os.geteuid()
    try:
        import pwd
        return pwd.getpwuid(uid).pw_name, uid
    except (ImportError, KeyError):
        return str(uid), uid


def run_json(engine, ui, first_prompt, attachments, remote=False, after_hello=()):
    ui.engine = engine
    user, uid = whoami()
    ui.emit({"type": "hello", "protocol": PROTOCOL, "version": VERSION,
             "host": socket.gethostname(), "user": user, "uid": uid, "remote": remote,
             "features": ["proposals", "decisions", "attach", "register_tools", "compact", "context", "coding",
                          "set_coding", "skills", "files", "read", "trace", "system", "plan", "network", "clear",
                          "models", "plugins"],
             "endpoint": engine.endpoint.info(),
             "profile": {"name": engine.profile.name, "description": engine.profile.description}
             if engine.profile else None,
             "session": engine.session.id,
             "resumed": engine.session.resumed, "coding": engine.session.coding,
             "coding_from": engine.coding_from if engine.session.coding else None,
             "coding_override": engine.coding_override if engine.session.coding else None, "cwd": os.getcwd(),
             "sandbox": engine.sandbox, "audit": engine.audit.path,
             "runner": engine.box.info() if engine.box else None,
             "skills": [s.name for s in engine.skills],
             "plugins": [p.name for p in engine.plugins],
             "tools": list(INTRINSICS)})
    engine.audit.log("start", mode="json", endpoint=engine.endpoint.info(),
                     profile=engine.profile.name if engine.profile else None, session=engine.session.id,
                     sandbox=engine.sandbox)
    for n in after_hello:
        ui.notice(n)
    ui.emit({"type": "plugins", "plugins": plugin_rows(engine.cfg, [p.name for p in engine.plugins])})

    def turn(text, att):
        first = getattr(engine.client, "exchanges", 0) + 1
        try:
            reason = engine.user_turn(text, att)
            ui.emit({"type": "done", "reason": reason, "context": {"used": engine.used(),
                                                                    "limit": engine.endpoint.context_limit},
                     "exchanges": exchanges(first)})
        except GenaiError as err:
            ui.error(str(err), err.kind, exchanges=exchanges(first))

    def exchanges(first):
        """The numbers of this turn's exchanges with the endpoint, for the trace message; None if there were none."""
        last = getattr(engine.client, "exchanges", 0)
        return [first, last] if last >= first else None

    if first_prompt is not None:
        turn(first_prompt, attachments)
    while True:
        msg = ui.read()
        if msg is None:
            return EXIT_OK
        t = msg.get("type")
        if t == "user":
            text = msg.get("text")
            if not isinstance(text, str):
                ui.error("user message needs 'text'", "bad_message")
                continue
            att = [(f"{lbl}" + (f" (re {ref})" if ref else ""), body) for lbl, body, ref in ui.queue]
            for lbl, body, ref in ui.queue:
                engine.share("attach", body, ref)
            ui.queue = []
            turn(text, att)
        elif t == "attach":
            ui.queue_attach(msg)
        elif t == "register_tools":
            try:
                names = engine.register(msg.get("tools") or [])
                ui.emit({"type": "registered", "tools": names})
            except GenaiError as err:
                ui.error(str(err), "bad_tools")
        elif t == "compact":
            try:
                r = engine.compact()
                ui.emit({"type": "compacted", "pruned": r["pruned"], "before": r["before"], "after": r["after"],
                         "summary": r["summary"]})
            except GenaiError as err:
                ui.error(str(err), err.kind)
        elif t == "models":
            try:
                ui.emit({"type": "models", "current": engine.endpoint.model,
                         "models": [{"id": mid, "context": n} for mid, n in engine.client.model_list()]})
            except GenaiError as err:
                ui.error(str(err), "models")
        elif t == "model":
            name = msg.get("model")
            if not isinstance(name, str):
                ui.error("model needs 'model': a name from the models message", "bad_message")
                continue
            try:
                engine.set_model(name, "wrapper")
                ui.emit({"type": "model", "endpoint": engine.endpoint.info(),
                         "context": {"used": engine.used(), "limit": engine.endpoint.context_limit}})
            except GenaiError as err:
                ui.error(str(err), err.kind)
        elif t == "clear":
            n = engine.clear()
            ui.emit({"type": "cleared", "dropped": n, "context": {"used": engine.used(),
                                                                   "limit": engine.endpoint.context_limit}})
        elif t == "coding":
            on = msg.get("on")
            if not isinstance(on, bool):
                ui.error("coding needs 'on': true or false", "bad_message")
                continue
            try:
                engine.set_coding(on, "wrapper")
                engine.session.save()
            except GenaiError as err:
                ui.error(str(err), "coding_refused")
            ui.emit({"type": "coding", "on": engine.session.coding, "coding_from": engine.coding_from,
                     "coding_override": engine.coding_override if engine.session.coding else None})
        elif t == "network":
            on = msg.get("on")
            if on is not None and not isinstance(on, bool):
                ui.error("network needs 'on': true or false, or nothing to ask", "bad_message")
                continue
            try:
                if on is not None:
                    engine.set_network(on, "wrapper")
            except GenaiError as err:
                ui.error(str(err), err.kind)
            ui.emit({"type": "network", "runner": engine.box.info() if engine.box else None,
                     "available": engine.can_run()})
        elif t == "skills":
            ui.emit({"type": "skills", "skills": skill_rows(engine.cfg, [s.name for s in engine.skills])})
        elif t == "skill":
            name, on = msg.get("name"), msg.get("on")
            if not isinstance(name, str) or not isinstance(on, bool):
                ui.error("skill needs 'name' and 'on': true or false", "bad_message")
                continue
            if remote:          # skills blessed on this host aren't ones the user's own machine vouched for
                ui.error("skills aren't available in remote mode yet", "remote")
                continue
            try:
                engine.set_skill(name, on)
                engine.session.save()
            except GenaiError as err:
                ui.error(str(err), err.kind)
            ui.emit({"type": "skills", "skills": skill_rows(engine.cfg, [s.name for s in engine.skills])})
        elif t == "plugins":
            ui.emit({"type": "plugins", "plugins": plugin_rows(engine.cfg, [p.name for p in engine.plugins])})
        elif t == "plugin":
            name, on = msg.get("name"), msg.get("on")
            if not isinstance(name, str) or not isinstance(on, bool):
                ui.error("plugin needs 'name' and 'on': true or false", "bad_message")
                continue
            if remote:          # plugins blessed on this host aren't ones the user's own machine vouched for
                ui.error("plugins aren't available in remote mode yet", "remote")
                continue
            try:
                engine.set_plugin(name, on)
            except GenaiError as err:
                ui.error(str(err), err.kind)
            ui.emit({"type": "plugins", "plugins": plugin_rows(engine.cfg, [p.name for p in engine.plugins])})
        elif t == "run":
            rid = msg.get("id")
            if type(rid) not in (int, str):
                ui.error("run needs 'id': a string or a number, which the answer repeats", "bad_message")
                continue
            try:
                r = engine.run_user(msg.get("plugin"), msg.get("command"), msg.get("params", {}))
            except GenaiError as err:
                r = {"error": str(err)}
            if r["error"]:
                ui.emit({"type": "ran", "id": rid, "error": r["error"]})
            else:
                ui.emit({"type": "ran", "id": rid, "exit": r["exit"], "output": r["output"], "note": r["note"],
                         "cached": r["cached"] is not None, "ms": r["ms"], "redacted": r["redacted"]})
        elif t == "files":
            path = msg.get("path", ".")
            if not isinstance(path, str):
                ui.error("files needs 'path' as a string", "bad_message")
                continue
            try:
                entries, truncated = engine.files(path)
                ui.emit({"type": "files", "path": path, "entries": entries, "truncated": truncated})
            except (ValueError, OSError) as err:
                ui.error(f"cannot list {path}: {err}", "bad_path")
        elif t == "read":
            path = msg.get("path")
            if not isinstance(path, str):
                ui.error("read needs 'path' as a string", "bad_message")
                continue
            try:
                text, size, secret, counts = engine.view(path)
                ui.emit({"type": "file", "path": path, "text": text, "size": size, "secret": secret,
                         "redacted": counts})
            except (ValueError, OSError) as err:
                ui.error(f"cannot read {path}: {err}", "bad_path", path=path)
        elif t in ("trace", "system"):
            inspect(engine, ui, msg)
        elif t == "plan":
            if msg.get("clear") is True:
                engine.clear_plan()
            else:
                ui.plan(engine.plan)
        elif t in ("decision", "result"):
            ui.error(f"no pending proposal {msg.get('id')!r}", "unknown_id")
        else:
            ui.error(f"unknown message type '{t}'", "unknown_type")


