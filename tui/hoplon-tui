#!/usr/bin/env bash
# hoplon-tui: hoplon in tmux, as one coding agent. The conversation, the prompt you type into below
# it, and an info panel on the right. Your own shell runs hidden: Ctrl-` shows it above the
# conversation, or hides it again. /run types a proposed command into that shell, /share sends
# what it printed, and right-clicking the shell marks where shell context starts. Clicking a proposed
# command, or Alt+1..Alt+9 (Alt+1 the newest), opens its menu: run it, edit it, paste it or copy it.
# In the shell, hoplon-ssh [ssh options] HOST connects to another host in a way hoplon-tui can follow.
# Features (/model, /copy, /decline, /raw, /system and /files, hoplon-ssh's handshake) can be switched off: {"disable":
# ["copy", "model"]} in ${XDG_CONFIG_HOME:-~/.config}/hoplon/tui.json, or HOPLON_TUI_DISABLE=copy,model.
# /files shows or hides a file tree on the left (--files starts with it shown): browsing sends nothing to the model.
# --remote [USER@]HOST [--dir PATH] [--as USER] [-- ssh options] keeps this screen and the API key here and runs hoplon
# (and the shell pane) on that host over ssh; see "Remote mode" in docs/hoplon-tui.md.
# Usage: hoplon-tui [-h] [-p PROFILE] [-e ENDPOINT] [-S SESSION] [-k SKILL] [--coding] [--no-panel] [--files]
#                  [--remote [USER@]HOST [--dir PATH] [--as USER] [-- SSH-OPTION...]]
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
die() { [ -z "${splash_at:-}" ] || printf '\e[?25h\e[?1049l'; echo "hoplon-tui: $*" >&2; exit 1; }

py=${HOPLON_PYTHON:-}
if [ -z "$py" ]; then
  for c in python3 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$c" >/dev/null && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
      py=$c
      break
    fi
  done
fi
[ -n "$py" ] || die "Python 3.10 or newer is required (SLES: zypper install python311 python311-curses; RHEL 9: dnf install python3.11)"
# Options are checked here, in your terminal, before anything starts: -h prints help, a mistake an error.
for a in "$@"; do
  case $a in -h|--help) exec "$py" "$here/conversation.py" --help ;; esac
done
# It prints what the launcher needs, one value per line: locally the session (new_session= when it made a name up,
# session_file=); for --remote dest=, as=, dir=, profile=, endpoint=, skill=, ssh=.
chk=$("$py" "$here/conversation.py" --check "$@") || exit 2
remote= r_as= r_dir= r_profile= r_endpoint= session_file=
ssh_opts=() r_skills=()
while IFS= read -r line; do
  case $line in
    dest=*) remote=${line#dest=} ;;
    as=*) r_as=${line#as=} ;;
    dir=*) r_dir=${line#dir=} ;;
    profile=*) r_profile=${line#profile=} ;;
    endpoint=*) r_endpoint=${line#endpoint=} ;;
    skill=*) r_skills+=("${line#skill=}") ;;
    ssh=*) ssh_opts+=("${line#ssh=}") ;;
    new_session=*) set -- "$@" -S "${line#new_session=}" ;;
    session_file=*) session_file=${line#session_file=} ;;
  esac
done <<<"$chk"
panel=1
files=0
for a in "$@"; do
  [ "$a" = --no-panel ] && panel=0
  [ "$a" = --files ] && files=1
done

command -v tmux >/dev/null || die "tmux is not installed"
read -r maj min < <(tmux -V | sed -nE 's/[^0-9]*([0-9]+)\.([0-9]+).*/\1 \2/p') || true
(( ${maj:-0} * 100 + ${min:-0} >= 302 )) || die "tmux 3.2 or newer is required (found $(tmux -V))"
"$py" -c 'import curses' 2>/dev/null || die "$py has no curses module (on SUSE it is a separate package, such as python311-curses)"
if [ -n "${TMUX:-}" ] && [ "${HOPLON_TUI_NESTED:-}" != 1 ]; then
  die "you are already inside tmux, whose prefix key would reach the outer tmux. Set HOPLON_TUI_NESTED=1 to start it anyway."
fi

# Private to this run: a tmux server (your own tmux and its config are never touched), and a
# directory only you can open, for the socket the panes talk over (tui/ipc.py). It goes in
# $XDG_RUNTIME_DIR (per user, in memory, cleared at logout) or else /tmp: never a shared filesystem
# such as home on a cluster, where a socket can only be reached from one node anyway.
sock="${HOPLON_TUI_SOCKET:-hoplon-tui-$$}"
t() { tmux -L "$sock" "$@"; }
base=${XDG_RUNTIME_DIR:-}
{ [ -n "$base" ] && [ -d "$base" ] && [ -w "$base" ]; } || base=/tmp
state=$(mktemp -d "$base/hoplon-tui.XXXXXX")
chmod 700 "$state"
q() { printf '%q' "$1"; }

# Remote mode. Everything that can ask you something (ssh's password or second factor) happens here, in your own
# terminal, before tmux starts. What is set up, and why it keeps the API key on this machine (SECURITY.md):
#   1. hoplon --remote-config: your endpoint and profile, and the skills and plugins in use, checked and blessed
#      here, without any key.
#   2. an ssh master connection, whose control socket lives in the private state directory.
#   3. tui/keyproxy.py on a Unix socket there: it adds the key to requests that carry this session's token.
#   4. a reverse forward: a port on the remote host's loopback leads to that socket.
#   5. $state/remote.json: how the conversation pane starts hoplon over the master, with the config it reads first.
remote_q() { ssh -S "$state/cm" ${ssh_opts[@]+"${ssh_opts[@]}"} "$remote" "$@"; }
remote_cleanup() {
  [ -z "${kpfd:-}" ] || exec {kpfd}>&-         # the key proxy ends when its stdin does
  [ -z "${kp_pid:-}" ] || kill "$kp_pid" 2>/dev/null || true
  [ -z "${started:-}" ] || tmux -L "$sock" kill-server 2>/dev/null || true
  [ ! -S "$state/cm" ] || ssh -S "$state/cm" -O exit "$remote" >/dev/null 2>&1 || true
  rm -rf "$state"
}
if [ -n "$remote" ]; then
  trap remote_cleanup EXIT
  trap 'exit 130' INT TERM HUP
  sudo_as=
  [ -z "$r_as" ] || sudo_as="sudo -n -H -u $(q "$r_as") -- "
  echo "hoplon-tui: checking your endpoint, profile, skills and plugins (hoplon --remote-config)" >&2
  gcmd=("$py" "$here/../hoplon")
  [ -z "${HOPLON_BIN:-}" ] || gcmd=("$HOPLON_BIN")
  gargs=(--remote-config)
  [ -z "$r_profile" ] || gargs+=(-p "$r_profile")
  [ -z "$r_endpoint" ] || gargs+=(-e "$r_endpoint")
  for k in ${r_skills[@]+"${r_skills[@]}"}; do gargs+=(-k "$k"); done
  "${gcmd[@]}" "${gargs[@]}" > "$state/export.json" || exit 3
  chmod 600 "$state/export.json"
  epname=$("$py" -c 'import json, sys; print(json.load(open(sys.argv[1]))["endpoint_name"])' "$state/export.json")
  echo "hoplon-tui: connecting to $remote (ssh asks here if it needs a password or a second factor)" >&2
  # -a: never forward your ssh agent to that host (use ProxyJump, -J, for a bastion). ControlPersist=no: the master
  # lasts as long as this launcher does, and not a moment longer.
  ssh -M -S "$state/cm" -o ControlPersist=no -a -x -fN ${ssh_opts[@]+"${ssh_opts[@]}"} "$remote" \
    || die "could not connect to $remote"
  ssh -S "$state/cm" -O check "$remote" >/dev/null 2>&1 || die "the ssh connection to $remote is not up"
  if [ -n "$r_as" ]; then
    remote_q "sudo -n -u $(q "$r_as") true" >/dev/null 2>&1 \
      || die "--as needs sudo to $r_as without a password on $remote (sudo -n)"
  fi
  # The first of these that is Python 3.10 or newer, as the user hoplon will run as (their PATH may differ).
  probe='for c in python3 python3.13 python3.12 python3.11 python3.10; do command -v $c >/dev/null 2>&1 && '
  probe+='$c -c "import sys; sys.exit(sys.version_info < (3, 10))" 2>/dev/null && { echo $c; exit 0; }; done; exit 1'
  rpy=$(remote_q "${sudo_as}sh -c $(q "$probe")" 2>/dev/null | tail -n 1) || true
  [[ $rpy =~ ^python3(\.[0-9]+)?$ ]] || die "hoplon needs Python 3.10+ on $remote${r_as:+ (as $r_as)}"
  if [ -n "$r_dir" ]; then
    remote_q "${sudo_as}test -d $(q "$r_dir")" >/dev/null 2>&1 \
      || die "$r_dir is not a directory on $remote${r_as:+ (as $r_as)}"
  fi
  # The token is what lets a request through the key proxy: 32 random bytes, only in memory and in 0600 files.
  token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
  mkfifo -m 600 "$state/kp.in"
  "$py" "$here/keyproxy.py" "$epname" "$state/kp.sock" < "$state/kp.in" > "$state/kp.out" 2> "$state/kp.err" &
  kp_pid=$!
  exec {kpfd}> "$state/kp.in"                  # held open until we exit
  printf '%s\n' "$token" >&"$kpfd"
  for _ in $(seq 100); do
    grep -qx ready "$state/kp.out" 2>/dev/null && break
    kill -0 "$kp_pid" 2>/dev/null || die "the key proxy did not start: $(cat "$state/kp.err")"
    sleep 0.1
  done
  grep -qx ready "$state/kp.out" 2>/dev/null || die "the key proxy did not start in time"
  fwd=$(ssh -S "$state/cm" -O forward -R "127.0.0.1:0:$state/kp.sock" "$remote" 2>&1) \
    || die "$remote would not forward a port back to this machine ($fwd). Is AllowTcpForwarding off there?"
  port=$(printf '%s\n' "$fwd" | sed -nE 's/^(Allocated port )?([0-9]+)( for remote forward.*)?$/\2/p' | head -n 1)
  [[ $port =~ ^[0-9]+$ ]] || die "could not read the forwarded port from ssh's answer: $fwd"
  printf '%s\n' "$token" | "$py" "$here/remote.py" write "$state" "$remote" "$r_as" "$r_dir" "$port" "$rpy" -- \
    ${ssh_opts[@]+"${ssh_opts[@]}"}
  unset token
  echo "hoplon-tui: hoplon will run on $remote${r_as:+ as $r_as}${r_dir:+ in $r_dir}, using $rpy there" >&2
fi

read -r rows cols < <(stty size 2>/dev/null) || true
cols=${cols:-120}
# The splash, on the terminal's alternate screen while tmux starts: only on a terminal at least 60x24,
# and not with NO_COLOR or HOPLON_TUI_SPLASH=0 set. tui/splash.ans is drawn to fit 60 columns.
splash_at=
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${HOPLON_TUI_SPLASH:-1}" != 0 ] && [ "${rows:-0}" -ge 24 ] && [ "$cols" -ge 60 ] && [ -r "$here/splash.ans" ]; then
  printf '\e[?1049h\e[?25l\e[H\e[2J'
  printf '\e[%dH' $(( (rows - 24) / 2 + 1 ))     # no newline after the last line: on 24 rows it would scroll
  nl=
  while IFS= read -r l; do printf '%s%*s%s' "$nl" $(( (cols - 60) / 2 )) '' "$l"; nl=$'\n'; done < "$here/splash.ans"
  splash_at=${EPOCHREALTIME/./}
fi
# In remote mode the shell pane is a hoplon-ssh session to the same host, as the same user, in the same directory,
# started below: see __hoplon_remote_shell in shellrc.
shell_env=()
[ -z "$remote" ] || shell_env=(-e "HOPLON_TUI_REMOTE_DEST=$remote" -e "HOPLON_TUI_SSH_CM=$state/cm"
  -e "HOPLON_TUI_SSH_AS=$r_as" -e "HOPLON_TUI_SSH_DIR=$r_dir")
# The panes' TERM. screen-256color, not tmux-256color: an ssh from the shell pane takes TERM with it, and
# many hosts (SLES among them) have no tmux-256color, where the shell then draws erased characters as
# blanks. It has to be set before the first pane starts, so the server starts first.
t -f /dev/null start-server \; set -g default-terminal screen-256color \; \
  new-session -d -s hoplon -n hoplon -x "$cols" -y "${rows:-40}" -c "$PWD" \
  -e "HOPLON_TUI_TOGGLE=$here/shell-toggle" -e "HOPLON_TUI_STATE=$state" -e "HOPLON_TUI_PY=$py" \
  -e "HOPLON_TUI_SHARE=$here/share.py" ${shell_env[@]+"${shell_env[@]}"} "bash --rcfile $(q "$here/shellrc") -i"
started=1
shell=$(t display -p -t hoplon '#{pane_id}')
# tmux copies what the shell prints into a FIFO the conversation pane reads, in memory, to know each
# command's output (tui/recorder.py). The shell waits for this before its first prompt.
mkfifo -m 600 "$state/shell.out"
t pipe-pane -O -t "$shell" "exec cat > $(q "$state/shell.out")"
# The file tree, on the left of everything. It starts in a window of its own, made first so that
# leaving it doesn't resize the other panes.
tree=$(t split-window -d -h -b -f -l 34 -t "$shell" -e "HOPLON_TUI_STATE=$state" -P -F '#{pane_id}' \
  "$(q "$py") $(q "$here/files.py")")
[ "$files" = 1 ] || t break-pane -d -s "$tree" -n files
side=$(t split-window -d -h -f -l 42 -t "$shell" -e "HOPLON_TUI_STATE=$state" -P -F '#{pane_id}' \
  "$(q "$py") $(q "$here/panel.py")")
# Top to bottom: the shell, the conversation, the prompt. The shell is hidden once it all exists.
prompt=$(t split-window -d -v -l 3 -t "$shell" -e "HOPLON_TUI_STATE=$state" -e "HOPLON_TUI_SHELL=$shell" \
  -e "HOPLON_TUI_TOGGLE=$here/shell-toggle" -P -F '#{pane_id}' "$(q "$py") $(q "$here/prompt.py")")
conv_env=()
[ -z "$remote" ] || conv_env=(-e "HOPLON_TUI_REMOTE=$state/remote.json")
conv_cmd="$(q "$py") $(q "$here/conversation.py")"
[ $# -eq 0 ] || conv_cmd+=" $(printf '%q ' "$@")"     # printf with no arguments would still print ''
conv=$(t split-window -d -v -l 60% -t "$shell" -c "$PWD" -e "HOPLON_TUI_SHELL=$shell" -e "HOPLON_TUI_PANEL=$side" \
  -e "HOPLON_TUI_FILES=$tree" -e "HOPLON_TUI_TOGGLE=$here/shell-toggle" \
  -e "HOPLON_TUI_STATE=$state" -e "HOPLON_TUI_PROMPT=$prompt" ${conv_env[@]+"${conv_env[@]}"} -P -F '#{pane_id}' \
  "$conv_cmd; rc=\$?; if [ \$rc -ne 0 ]; then echo; echo \"hoplon-tui: the conversation ended with code \$rc. Press Enter.\"; read -r _; fi; tmux kill-server")
if [ "$panel" = 0 ] || [ "$cols" -lt 100 ]; then
  t break-pane -d -s "$side" -n panel
fi

t set -g escape-time 10
t set -g history-limit 50000
t set -g mouse on
t set -g focus-events on
t set -g pane-border-status top
# The right column's active pane shows its tabs (tui/dock.py) instead of its title when there are two or more.
t set -g pane-border-format ' #{?#{@hoplon_tabs},#{@hoplon_tabs},#{@hoplon_title}} '
t set -g pane-border-lines single
# The palette (tui/palette.py, "bronze on iron"): the brand badge and focused border in bronze, the host in
# bronze, quiet hints and unfocused borders in grey. NO_COLOR keeps only bold.
if [ -z "${NO_COLOR:-}" ]; then
  bronze='#D4A05A' iron='#0E1113' dim='#7E858E' line='#2A3036'
  t set -g pane-border-style "fg=$line"
  t set -g pane-active-border-style "fg=$bronze,bold"
  badge="#[fg=$iron,bg=$bronze,bold] (H) hoplon #[default] " hint="#[fg=$dim]" host="#[fg=$bronze,bold]"
else
  t set -g pane-border-style 'default'
  t set -g pane-active-border-style 'bold'
  badge='#[bold] (H) hoplon #[default] ' hint='' host='#[bold]'
fi
# The header: tmux's status line, at the top. hoplon's badge, then what the conversation pane reports
# (endpoint and model, profile, session, state, mode, context); on the right, what waits on you, the
# sandbox, the host, and the keys when the terminal is wide enough for them.
t set -g status-position top
if [ -z "${NO_COLOR:-}" ]; then t set -g status-style 'bg=#161B1F,fg=default'; else t set -g status-style 'bg=default,fg=default'; fi
t set -g status-left "$badge#{@hoplon_header}"
t set -g status-left-length 120
keys="#{?#{e|>:#{client_width},170},$hint│ Ctrl-\` shell · Ctrl-b o other pane · Ctrl-b d detach #[default],}"
if [ -n "$remote" ]; then       # the host that matters is the one hoplon runs on
  t set -g status-right "#{@hoplon_sandbox} ${hint}hoplon on#[default] $host${remote//#/##}#[default] $keys"
else
  t set -g status-right "#{@hoplon_sandbox} $host#H#[default] $keys"
fi
t set -g window-status-format ''          # hidden panes live in other windows; don't list them
t set -g window-status-current-format ''
t set -g status-right-length 130
t set -g @hoplon_prompt_pane "$prompt"
t set -g @hoplon_shell_pane "$shell"
t set -g @hoplon_conv_pane "$conv"
t set -p -t "$conv" @hoplon_title 'hoplon'
t set -p -t "$shell" @hoplon_title 'shell · Ctrl-` hides it · right-click: shell context'
t set -p -t "$prompt" @hoplon_title 'you'
t set -p -t "$side" @hoplon_title 'info · /panel hides it'
t set -p -t "$tree" @hoplon_title 'files · /files hides it'

# Right-click in the shell pane: tmux's own menu for shell context. -O keeps it open when the button is
# released off an item (tmux 3.2 has it); a click chooses. Each request goes to the
# conversation pane over the socket, through request.py. Marking records the line clicked, which the
# conversation pane at once turns into a count of logical lines, one that resizing doesn't change.
req="$(q "$py") $(q "$here/request.py")"
cat > "$state/menu.conf" <<EOF
bind -n MouseDown3Pane {
  if -F "#{==:#{pane_id},$shell}" {
    display-menu -O -t= -x M -y M -T " shell context " \\
      "Mark start of context here" m { set -gF @hoplon_ctx_mark "#{e|-:#{e|+:#{history_size},#{mouse_y}},#{?scroll_position,#{scroll_position},0}}" ; run-shell -b "$req mark" } \\
      "Share from the mark" s { run-shell -b "$req share mark" } \\
      "Share all shell history" a { run-shell -b "$req share all" } \\
      "Share the last command" l { run-shell -b "$req share last" } \\
      "" \\
      "Clear the mark" c { set -gu @hoplon_ctx_mark ; run-shell -b "$req unmark" ; display-message "hoplon: shell context mark cleared" }
  } {
    select-pane -t= ; send-keys -M
  }
}
EOF
# A click on the model in the header (its range, "model") opens the /model drop-down; elsewhere on the
# status line a click does what tmux's does.
# A click on the top border of a pane with tabs opens the tab menu, on the button's release: a menu a program
# opens closes at the next mouse event, which on a press would be its release.
echo "bind -n MouseUp1Border if -F \"#{@hoplon_tabs}\" { run-shell -b \"$req tabs\" }" >> "$state/menu.conf"
echo "bind -n MouseDown1Status if -F \"#{==:#{mouse_status_range},model}\" { run-shell -b \"$req models\" } { switch-client -t= }" >> "$state/menu.conf"
# Alt+1 .. Alt+9: the menu of a command proposal, from the keyboard. In the shell pane they stay the shell's.
for n in 1 2 3 4 5 6 7 8 9; do
  echo "bind -n M-$n if -F \"#{==:#{pane_id},$shell}\" { send-keys M-$n } { run-shell -b \"$req menu open $n\" }"
done >> "$state/menu.conf"
t set-environment -g HOPLON_TUI_STATE "$state"
t source-file "$state/menu.conf"
t set-environment -g HOPLON_TUI_TOGGLE "$here/shell-toggle"
# Ctrl-` shows the shell, or hides it, from any pane. Most terminals send it as NUL, the same byte as
# Ctrl-Space, which tmux names C-Space; a terminal that reports keys in full sends C-`.
for k in C-Space C-\`; do t bind -n "$k" run-shell "$(q "$here/shell-toggle") toggle --focus"; done
t run-shell "$(q "$here/shell-toggle") hide"
t select-pane -t "$prompt"
# The shell pane runs hoplon-ssh to the host at once, as a command, so it is followed like any hoplon-ssh session.
[ -z "$remote" ] || t send-keys -t "$shell" -l ' __hoplon_remote_shell' \; send-keys -t "$shell" Enter
if [ -n "$splash_at" ]; then                     # keep it up for at least 1.2 s, then hand the screen to tmux
  left=$(( 1200000 - (${EPOCHREALTIME/./} - splash_at) ))
  [ "$left" -le 0 ] || sleep "$(( left / 1000000 )).$(printf %06d $(( left % 1000000 )))"
  printf '\e[?25h\e[?1049l'
  splash_at=
fi
t attach -t hoplon || true
if t has-session 2>/dev/null; then
  if [ -n "$remote" ]; then
    # Leaving would close the key proxy and the ssh connection with it, so the session can't outlive this command.
    echo "hoplon-tui: detached. This command keeps the ssh connection and the key proxy up: Ctrl-C ends the session." >&2
    echo "Reattach from another terminal: tmux -L $sock attach" >&2
    while t has-session 2>/dev/null; do sleep 1; done
  else
    echo "hoplon-tui is still running in the background. Reattach: tmux -L $sock attach"
  fi
fi
if [ -n "$session_file" ] && [ -f "$session_file" ] && ! t has-session 2>/dev/null; then
  again=$(printf '%q ' "$@")
  echo "Resume this conversation: hoplon-tui ${again% }"
fi
# (Remote mode removes it in its exit trap, after it has closed the ssh master whose socket is in it.)
[ -n "$remote" ] || t has-session 2>/dev/null || rm -rf "$state"
