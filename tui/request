#!/usr/bin/env bash
# Send one request from a tmux menu to the conversation pane, through genai-tui's private pipe.
# Usage: request share-mark|share-all|share-last
case ${1:-} in
  share-mark) msg='{"type": "share", "what": "mark"}' ;;
  share-all)  msg='{"type": "share", "what": "all"}' ;;
  share-last) msg='{"type": "share", "what": "last"}' ;;
  *) exit 2 ;;
esac
[ -p "${GENAI_TUI_STATE:-}/requests" ] || exit 1
printf '%s\n' "$msg" > "$GENAI_TUI_STATE/requests"
