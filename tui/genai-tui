#!/usr/bin/env bash
# genai-tui: genai in tmux, as one coding agent. The conversation, the prompt you type into below
# it, and an info panel on the right. Your own shell runs hidden: `` on an empty line shows it above
# the conversation, or hides it again. /run types a proposed command into that shell, /share sends
# what it printed, and right-clicking the shell marks where shell context starts. Clicking a proposed
# command, or Alt+1..Alt+9 (Alt+1 the newest), opens its menu: run it, edit it, paste it or copy it.
# In the shell, genai-ssh [ssh options] HOST connects to another host in a way genai-tui can follow.
# Features (/model, /copy, /decline, /raw, /system and /files, genai-ssh's handshake) can be switched off: {"disable":
# ["copy", "model"]} in ${XDG_CONFIG_HOME:-~/.config}/genai/tui.json, or GENAI_TUI_DISABLE=copy,model.
# /files shows or hides a file tree on the left (--files starts with it shown): browsing sends nothing to the model.
# Usage: genai-tui [-h] [-p PROFILE] [-e ENDPOINT] [-S SESSION] [-k SKILL] [--coding] [--no-panel] [--files]
set -euo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
die() { echo "genai-tui: $*" >&2; exit 1; }

py=${GENAI_PYTHON:-}
if [ -z "$py" ]; then
  for c in python3 python3.13 python3.12 python3.11 python3.10; do
    if command -v "$c" >/dev/null && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 10))' 2>/dev/null; then
      py=$c
      break
    fi
  done
fi
[ -n "$py" ] || die "Python 3.10 or newer is required (SLES: zypper install python311 python311-curses; RHEL 9: dnf install python3.11)"
# Options are checked here, in your terminal, before anything starts: -h prints help, a mistake an error.
for a in "$@"; do
  case $a in -h|--help) exec "$py" "$here/conversation.py" --help ;; esac
done
"$py" "$here/conversation.py" --check "$@" || exit 2
panel=1
files=0
for a in "$@"; do
  [ "$a" = --no-panel ] && panel=0
  [ "$a" = --files ] && files=1
done

command -v tmux >/dev/null || die "tmux is not installed"
read -r maj min < <(tmux -V | sed -nE 's/[^0-9]*([0-9]+)\.([0-9]+).*/\1 \2/p') || true
(( ${maj:-0} * 100 + ${min:-0} >= 302 )) || die "tmux 3.2 or newer is required (found $(tmux -V))"
"$py" -c 'import curses' 2>/dev/null || die "$py has no curses module (on SUSE it is a separate package, such as python311-curses)"
if [ -n "${TMUX:-}" ] && [ "${GENAI_TUI_NESTED:-}" != 1 ]; then
  die "you are already inside tmux, whose prefix key would reach the outer tmux. Set GENAI_TUI_NESTED=1 to start it anyway."
fi

# Private to this run: a tmux server (your own tmux and its config are never touched), and a
# directory only you can open, for the socket the panes talk over (tui/ipc.py). It goes in
# $XDG_RUNTIME_DIR (per user, in memory, cleared at logout) or else /tmp: never a shared filesystem
# such as home on a cluster, where a socket can only be reached from one node anyway.
sock="${GENAI_TUI_SOCKET:-genai-tui-$$}"
t() { tmux -L "$sock" "$@"; }
base=${XDG_RUNTIME_DIR:-}
{ [ -n "$base" ] && [ -d "$base" ] && [ -w "$base" ]; } || base=/tmp
state=$(mktemp -d "$base/genai-tui.XXXXXX")
chmod 700 "$state"
q() { printf '%q' "$1"; }

read -r rows cols < <(stty size 2>/dev/null) || true
cols=${cols:-120}
# The panes' TERM. screen-256color, not tmux-256color: an ssh from the shell pane takes TERM with it, and
# many hosts (SLES among them) have no tmux-256color, where the shell then draws erased characters as
# blanks. It has to be set before the first pane starts, so the server starts first.
t -f /dev/null start-server \; set -g default-terminal screen-256color \; \
  new-session -d -s genai -n genai -x "$cols" -y "${rows:-40}" -c "$PWD" \
  -e "GENAI_TUI_TOGGLE=$here/shell-toggle" "bash --rcfile $(q "$here/shellrc") -i"
shell=$(t display -p -t genai '#{pane_id}')
# tmux copies what the shell prints into a FIFO the conversation pane reads, in memory, to know each
# command's output (tui/recorder.py). The shell waits for this before its first prompt.
mkfifo -m 600 "$state/shell.out"
t pipe-pane -O -t "$shell" "exec cat > $(q "$state/shell.out")"
# The file tree, on the left of everything. It starts in a window of its own, made first so that
# leaving it doesn't resize the other panes.
tree=$(t split-window -d -h -b -f -l 34 -t "$shell" -e "GENAI_TUI_STATE=$state" -P -F '#{pane_id}' \
  "$(q "$py") $(q "$here/files.py")")
[ "$files" = 1 ] || t break-pane -d -s "$tree" -n files
side=$(t split-window -d -h -f -l 42 -t "$shell" -e "GENAI_TUI_STATE=$state" -P -F '#{pane_id}' \
  "$(q "$py") $(q "$here/panel.py")")
# Top to bottom: the shell, the conversation, the prompt. The shell is hidden once it all exists.
prompt=$(t split-window -d -v -l 3 -t "$shell" -e "GENAI_TUI_STATE=$state" -e "GENAI_TUI_SHELL=$shell" \
  -e "GENAI_TUI_TOGGLE=$here/shell-toggle" -P -F '#{pane_id}' "$(q "$py") $(q "$here/prompt.py")")
conv_cmd="$(q "$py") $(q "$here/conversation.py")"
[ $# -eq 0 ] || conv_cmd+=" $(printf '%q ' "$@")"     # printf with no arguments would still print ''
conv=$(t split-window -d -v -l 60% -t "$shell" -c "$PWD" -e "GENAI_TUI_SHELL=$shell" -e "GENAI_TUI_PANEL=$side" \
  -e "GENAI_TUI_FILES=$tree" -e "GENAI_TUI_TOGGLE=$here/shell-toggle" \
  -e "GENAI_TUI_STATE=$state" -e "GENAI_TUI_PROMPT=$prompt" -P -F '#{pane_id}' \
  "$conv_cmd; rc=\$?; if [ \$rc -ne 0 ]; then echo; echo \"genai-tui: the conversation ended with code \$rc. Press Enter.\"; read -r _; fi; tmux kill-server")
if [ "$panel" = 0 ] || [ "$cols" -lt 100 ]; then
  t break-pane -d -s "$side" -n panel
fi

t set -g escape-time 10
t set -g history-limit 50000
t set -g mouse on
t set -g focus-events on
t set -g pane-border-status top
t set -g pane-border-format ' #{@genai_title} '
t set -g pane-border-lines single
t set -g pane-border-style 'fg=brightblack'
t set -g pane-active-border-style 'fg=blue,bold'
t set -g status-style 'bg=default,fg=default'
t set -g status-left ' genai │ '
t set -g status-left-length 20
t set -g status-right ' #H │ `` shows the shell │ Ctrl-b o: other pane │ Ctrl-b d: detach '
t set -g window-status-format ''          # hidden panes live in other windows; don't list them
t set -g window-status-current-format ''
t set -g status-right-length 100
t set -g @genai_prompt_pane "$prompt"
t set -g @genai_shell_pane "$shell"
t set -g @genai_conv_pane "$conv"
t set -p -t "$conv" @genai_title 'genai'
t set -p -t "$shell" @genai_title 'shell · `` hides it · right-click: shell context'
t set -p -t "$prompt" @genai_title 'you'
t set -p -t "$side" @genai_title 'info · /panel hides it'
t set -p -t "$tree" @genai_title 'files · /files hides it'

# Right-click in the shell pane: tmux's own menu for shell context. -O keeps it open when the button is
# released off an item (tmux 3.2 has it); a click chooses. Each request goes to the
# conversation pane over the socket, through request.py. Marking records the line clicked, which the
# conversation pane at once turns into a count of logical lines, one that resizing doesn't change.
req="$(q "$py") $(q "$here/request.py")"
cat > "$state/menu.conf" <<EOF
bind -n MouseDown3Pane {
  if -F "#{==:#{pane_id},$shell}" {
    display-menu -O -t= -x M -y M -T " shell context " \\
      "Mark start of context here" m { set -gF @genai_ctx_mark "#{e|-:#{e|+:#{history_size},#{mouse_y}},#{?scroll_position,#{scroll_position},0}}" ; run-shell -b "$req mark" } \\
      "Share from the mark" s { run-shell -b "$req share mark" } \\
      "Share all shell history" a { run-shell -b "$req share all" } \\
      "Share the last command" l { run-shell -b "$req share last" } \\
      "" \\
      "Clear the mark" c { set -gu @genai_ctx_mark ; run-shell -b "$req unmark" ; display-message "genai: shell context mark cleared" }
  } {
    select-pane -t= ; send-keys -M
  }
}
EOF
# Alt+1 .. Alt+9: the menu of a command proposal, from the keyboard. In the shell pane they stay the shell's.
for n in 1 2 3 4 5 6 7 8 9; do
  echo "bind -n M-$n if -F \"#{==:#{pane_id},$shell}\" { send-keys M-$n } { run-shell -b \"$req menu open $n\" }"
done >> "$state/menu.conf"
t set-environment -g GENAI_TUI_STATE "$state"
t source-file "$state/menu.conf"
t set-environment -g GENAI_TUI_TOGGLE "$here/shell-toggle"
t run-shell "$(q "$here/shell-toggle") hide"
t select-pane -t "$prompt"
t attach -t genai || true
if t has-session 2>/dev/null; then
  echo "genai-tui is still running in the background. Reattach: tmux -L $sock attach"
else
  rm -rf "$state"
fi
