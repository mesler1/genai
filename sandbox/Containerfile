# genai test sandbox: Python 3.10 (the target's minimum), no genai code baked in.
# The repo is mounted read-only at /opt/genai by sandbox/run.
FROM docker.io/library/python:3.10-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends vim-tiny ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /home/genai/.config /work \
 && chmod 0777 /home/genai /home/genai/.config /work

ENV HOME=/home/genai \
    XDG_CONFIG_HOME=/home/genai/.config \
    EDITOR=vi \
    PYTHONDONTWRITEBYTECODE=1 \
    GENAI_SANDBOX=podman

WORKDIR /work
