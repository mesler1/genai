#!/usr/bin/env python3
"""hoplon: a small client for OpenAI-compatible APIs.

The model never executes anything on your system. It proposes a command or a file operation,
the scaffold (this REPL, or a wrapper speaking JSON Lines) presents it, and a
human decides. The one exception is opt-in: in coding mode, a profile's sandbox lets the
model run commands in an offline container on a throwaway copy of the project.
Standard library only; Python 3.10 or newer.

This script is only the launcher. The program is the parts in hoplon_core/, which share one namespace: they are
joined, in the order PARTS gives, into one script (the bundle), and that is what runs, here and in remote mode alike.
Read hoplon_core/gate.py first: it alone decides whether anything happens (AUDIT.md maps each claim in SECURITY.md
to the code that keeps it). `hoplon --bundle` writes the bundle to stdout and its sha256 to stderr; every audit
log's start record names the sha256 of the bundle that ran.
"""

import hashlib
import os
import sys

# The order the parts are joined in: each is defined before a later part builds on it. It is not the reading order.
PARTS = ("base", "files", "client", "commands", "sandbox", "config", "leftovers", "gate", "turn", "front")


def bundle(root=None):
    """hoplon as one script: the parts as strings, each run in turn in one namespace, compiled under its own file name
    so a traceback points into it. Deterministic: the same parts give the same bytes, whatever their times."""
    root = root or os.path.join(os.path.dirname(os.path.realpath(__file__)), "hoplon_core")
    texts = []
    for name in PARTS:
        with open(os.path.join(root, f"{name}.py"), encoding="utf-8") as f:
            texts.append((f"hoplon_core/{name}.py", f.read()))
    return ("# hoplon, as one script: the parts of hoplon_core/, in order (made by hoplon --bundle)\n"
            "_PARTS = (\n" + "".join(f"    ({n!r}, {t!r}),\n" for n, t in texts) + ")\n"
            "for _PART in _PARTS:\n"
            "    exec(compile(_PART[1], _PART[0], 'exec'), globals())\n"
            "del _PART, _PARTS\n").encode("utf-8")


def bundle_digest(data):
    return "sha256:" + hashlib.sha256(data).hexdigest()


if __name__ == "__main__" and sys.argv[1:] == ["--bundle"]:
    _BUNDLE = bundle()
    sys.stdout.buffer.write(_BUNDLE)
    sys.stdout.flush()
    print(bundle_digest(_BUNDLE), file=sys.stderr)
    sys.exit(0)

_BUNDLE = bundle()                  # read once: what is hashed is what runs
BUNDLE_SHA256 = bundle_digest(_BUNDLE)
exec(compile(_BUNDLE, "hoplon bundle", "exec"), globals())
