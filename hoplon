def inspect(engine, ui, msg):
    """trace and system: what was sent to the endpoint and what came back, or what the next request will
    carry besides the conversation. Read only, so allowed while proposals are pending."""
    if msg.get("type") == "system":
        ui.emit({"type": "system", "system": engine.system()["content"], "tools": engine.tools(),
                 "model": engine.endpoint.model, "params": getattr(engine.client, "params", {})})
        return
    trace = list(getattr(engine.client, "trace", []))
    lo, hi = msg.get("from"), msg.get("to")
    if type(lo) is not int or type(hi) is not int:
        lo = hi = trace[-1]["n"] if trace else 0
    ui.emit({"type": "trace", "from": lo, "to": hi, "kept": [trace[0]["n"], trace[-1]["n"]] if trace else None,
             "exchanges": [{k: v for k, v in ex.items() if k != "started"} for ex in trace if lo <= ex["n"] <= hi]})


def whoami():
    """The effective user's name (the uid if it has none) and uid."""
    uid = os.geteuid()
    try:
        import pwd
        return pwd.getpwuid(uid).pw_name, uid
    except (ImportError, KeyError):
        return str(uid), uid


class Signals:
    held = 0            # > 0 while a work session's commits are fetched into your repository (signals_held)
    pending = None      # a signal that came meanwhile


@contextlib.contextmanager
def signals_held():
    """SIGTERM and SIGHUP wait until this is done: git killed in the middle of a fetch into your repository could
    leave a lock file behind. hoplon exits as soon as it is done."""
    Signals.held += 1
    try:
        yield
    finally:
        Signals.held -= 1
        if not Signals.held and Signals.pending:
            signum, Signals.pending = Signals.pending, None
            raise SystemExit(128 + signum)


def exit_on_signals():
    """SIGTERM and SIGHUP (a front end closing, a terminal going away) end hoplon the way the end of input does: the
    finally blocks run, so a work session commits what it has and removes its copy. A second one is ignored while
    that happens, and one that comes while commits are fetched into your repository waits for it (signals_held)."""
    def on_signal(signum, frame):
        for sig in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, signal.SIG_IGN)
        if Signals.held:
            Signals.pending = signum
            return
        raise SystemExit(128 + signum)
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)


def run_json(engine, ui, first_prompt, attachments, remote=False, after_hello=()):
    ui.engine = engine

    # SIGINT stops a sandboxed run, as Ctrl-C does in the REPL, and is ignored otherwise: the default would end
    # hoplon, and with it the conversation, wherever it happened to arrive.
    def on_sigint(signum, frame):
        if Sandbox.running:
            raise KeyboardInterrupt
    signal.signal(signal.SIGINT, on_sigint)
    user, uid = whoami()
    ui.emit({"type": "hello", "protocol": PROTOCOL, "version": VERSION,
             "host": socket.gethostname(), "user": user, "uid": uid, "remote": remote,
             "features": ["proposals", "decisions", "attach", "register_tools", "compact", "context", "coding",
                          "fixtures", "leftovers",
                          "set_coding", "skills", "files", "read", "trace", "system", "plan", "network", "clear",
                          "models", "command_sets", "interrupt", "edits", "stop", "digest", "work", "halt", "progress"],
             "endpoint": engine.endpoint.info(),
             "profile": dict({"name": engine.profile.name, "description": engine.profile.description},
                             **({"layout": engine.profile.layout} if engine.profile.layout else {}))
             if engine.profile else None,
             "session": engine.session.id,
             "resumed": engine.session.resumed, "coding": engine.session.coding,
             "coding_from": engine.coding_from if engine.session.coding else None,
             "coding_override": engine.coding_override if engine.session.coding else None, "cwd": os.getcwd(),
             "sandbox": engine.sandbox, "audit": engine.audit.path,
             "runner": engine.box.info() if engine.box else None, "edits": engine.edits_info(),
             "skills": [s.name for s in engine.skills],
             "command_sets": [p.name for p in engine.command_sets],
             "tools": list(INTRINSICS)})
    engine.audit.log("start", mode="json", endpoint=engine.endpoint.info(),
                     profile=engine.profile.name if engine.profile else None, session=engine.session.id,
                     sandbox=engine.sandbox)
    for n in after_hello:
        ui.notice(n)
    ui.emit({"type": "command_sets", "command_sets": engine.command_set_rows()})

    def turn(text, att, start=None):
        first = getattr(engine.client, "exchanges", 0) + 1
        with ui.lock:
            engine.halt, ui.busy, ui.starting_work = None, True, start is not None
            Sandbox.stop.clear()        # a stop from now on ends this turn's runs, even one about to start
        try:
            reason = start() if start else engine.user_turn(text, att)
            ui.emit({"type": "done", "reason": reason, "context": {"used": engine.used(),
                                                                    "limit": engine.active()[0].context_limit},
                     "exchanges": exchanges(first)})
        except HoplonError as err:
            ui.error(str(err), err.kind, exchanges=exchanges(first))
        finally:
            with ui.lock:
                ui.busy, ui.starting_work, why, engine.halt = False, False, engine.halt, None
        if why == "end" and engine.work:        # work_end came during the turn
            try:
                engine.end_work("ended")
            except HoplonError as err:
                ui.error(str(err), err.kind)

    def exchanges(first):
        """The numbers of this turn's exchanges with the endpoint, for the trace message; None if there were none."""
        last = getattr(engine.client, "exchanges", 0)
        return [first, last] if last >= first else None

    ui.start_listening()        # now, so a stop or the end of input is seen during a first turn too
    if first_prompt is not None:
        turn(first_prompt, attachments)
    while True:
        msg = ui.read()
        if msg is None:
            return EXIT_OK
        t = msg.get("type")
        if t == "user":
            text = msg.get("text")
            if not isinstance(text, str):
                ui.error("user message needs 'text'", "bad_message")
                continue
            att = [(f"{lbl}" + (f" (re {ref})" if ref else ""), body) for lbl, body, ref in ui.queue]
            for lbl, body, ref in ui.queue:
                engine.share("attach", body, ref)
            ui.queue = []
            turn(text, att)
        elif t == "work":
            task, steps, secs = msg.get("task"), msg.get("steps_per_item"), msg.get("time_limit")
            if not isinstance(task, str) or not task.strip():
                ui.error("work needs 'task': what the session is to do", "bad_message")
                continue
            turn(None, (), lambda: engine.start_work(task, steps, secs, "wrapper"))
        elif t == "work_end":
            try:
                engine.end_work("ended")
            except HoplonError as err:
                ui.error(str(err), err.kind)
        elif t == "attach":
            ui.queue_attach(msg)
        elif t == "register_tools":
            try:
                names = engine.register(msg.get("tools") or [])
                ui.emit({"type": "registered", "tools": names})
            except HoplonError as err:
                ui.error(str(err), "bad_tools")
        elif t == "compact":
            try:
                r = engine.compact()
                ui.emit({"type": "compacted", "pruned": r["pruned"], "before": r["before"], "after": r["after"],
                         "summary": r["summary"]})
            except HoplonError as err:
                ui.error(str(err), err.kind)
        elif t == "models":
            try:
                ui.emit({"type": "models", "current": engine.endpoint.model,
                         "models": [{"id": mid, "context": n} for mid, n in engine.client.model_list()]})
            except HoplonError as err:
                ui.error(str(err), "models")
        elif t == "model":
            name = msg.get("model")
            if not isinstance(name, str):
                ui.error("model needs 'model': a name from the models message", "bad_message")
                continue
            try:
                engine.set_model(name, "wrapper")
                ui.emit({"type": "model", "endpoint": engine.endpoint.info(),
                         "context": {"used": engine.used(), "limit": engine.endpoint.context_limit}})
            except HoplonError as err:
                ui.error(str(err), err.kind)
        elif t == "stop":
            ui.error("nothing is running", "not_running")
        elif t == "halt":
            pass            # a stop that came as a turn ended
        elif t == "clear":
            n = engine.clear()
            ui.emit({"type": "cleared", "dropped": n, "context": {"used": engine.used(),
                                                                   "limit": engine.active()[0].context_limit}})
        elif t == "coding":
            on = msg.get("on")
            if not isinstance(on, bool):
                ui.error("coding needs 'on': true or false", "bad_message")
                continue
            try:
                engine.set_coding(on, "wrapper")
                engine.session.save()
            except HoplonError as err:
                ui.error(str(err), "coding_refused")
            ui.emit({"type": "coding", "on": engine.session.coding, "coding_from": engine.coding_from,
                     "coding_override": engine.coding_override if engine.session.coding else None})
        elif t == "edits":
            mode, reset = msg.get("mode"), msg.get("reset")
            if (mode is not None and mode not in EDITS_MODES) or (reset is not None and not isinstance(reset, bool)):
                ui.error("edits takes 'mode': \"ask\" or \"approved-files\", and/or 'reset': true", "bad_message")
                continue
            if reset:
                engine.reset_approved_files("wrapper")
            if mode is not None:
                engine.set_edits(mode, "wrapper")
            ui.emit({"type": "edits", **engine.edits_info()})
        elif t == "fixtures":
            action, paths, digest = msg.get("action"), msg.get("paths") or [], msg.get("digest")
            if action not in (None, "add", "use", "drop", "clear") or not isinstance(paths, list) \
                    or not all(isinstance(x, str) and x for x in paths) or (action == "add") != bool(paths) \
                    or (action == "use" and not isinstance(digest, str)) or not isinstance(msg.get("cwd", ""), str):
                ui.error("fixtures takes 'action' (add with 'paths' and 'cwd', use with the listing's 'digest', drop "
                         "or clear), or nothing to list", "bad_message")
                continue
            try:
                info = engine.fixtures_action(action, "wrapper", paths, msg.get("cwd"), digest) if action \
                    else engine.fixtures_info()
            except (HoplonError, OSError) as err:
                ui.error(f"fixtures: {err}", getattr(err, "kind", None) or "fixtures")
                info = engine.fixtures_info()
            ui.emit({"type": "fixtures", **info})
        elif t == "leftovers":
            action, ids = msg.get("action"), msg.get("ids") or []
            if action not in (None, "clean") or not isinstance(ids, list) \
                    or not all(isinstance(x, str) and x for x in ids) or (action == "clean") != bool(ids):
                ui.error("leftovers takes nothing to list, or 'action': 'clean' with the listing's 'ids'",
                         "bad_message")
                continue
            done = clean_leftovers(engine.cfg, ids, engine.audit, "wrapper") if action else {}
            ui.emit({"type": "leftovers", "items": leftovers(engine.cfg, [engine.wd.root]), **done})
        elif t == "network":
            on = msg.get("on")
            if on is not None and not isinstance(on, bool):
                ui.error("network needs 'on': true or false, or nothing to ask", "bad_message")
                continue
            try:
                if on is not None:
                    engine.set_network(on, "wrapper")
            except HoplonError as err:
                ui.error(str(err), err.kind)
            ui.emit({"type": "network", "runner": engine.box.info() if engine.box else None,
                     "available": engine.can_run()})
        elif t == "skills":
            ui.emit({"type": "skills", "skills": engine.skill_rows()})
        elif t == "skill":
            name, on = msg.get("name"), msg.get("on")
            if not isinstance(name, str) or not isinstance(on, bool):
                ui.error("skill needs 'name' and 'on': true or false", "bad_message")
                continue
            if remote and name not in engine.offered["skills"]:   # only what the user's own machine vouched for
                ui.error(f"skill '{one_line(name)[0]}' wasn't sent from your machine: in remote mode, only the "
                         "skills hoplon-tui sent (the profile's, default_skills and -k) can be used", "remote")
                ui.emit({"type": "skills", "skills": engine.skill_rows()})
                continue
            try:
                engine.set_skill(name, on)
                engine.session.save()
            except HoplonError as err:
                ui.error(str(err), err.kind)
            ui.emit({"type": "skills", "skills": engine.skill_rows()})
        elif t == "command_sets":
            ui.emit({"type": "command_sets", "command_sets": engine.command_set_rows()})
        elif t == "command_set":
            name, on = msg.get("name"), msg.get("on")
            if not isinstance(name, str) or not isinstance(on, bool):
                ui.error("command_set needs 'name' and 'on': true or false", "bad_message")
                continue
            if remote and name not in engine.offered["command_sets"]:  # only what the user's own machine vouched for
                ui.error(f"command set '{one_line(name)[0]}' wasn't sent from your machine: in remote mode, only the "
                         "command sets hoplon-tui sent (the profile's and default_commands) can be used", "remote")
                ui.emit({"type": "command_sets", "command_sets": engine.command_set_rows()})
                continue
            try:
                engine.set_command_set(name, on)
            except HoplonError as err:
                ui.error(str(err), err.kind)
            ui.emit({"type": "command_sets", "command_sets": engine.command_set_rows()})
        elif t == "run":
            rid = msg.get("id")
            if type(rid) not in (int, str):
                ui.error("run needs 'id': a string or a number, which the answer repeats", "bad_message")
                continue
            try:
                r = engine.run_user(msg.get("set"), msg.get("command"), msg.get("params", {}))
            except HoplonError as err:
                r = {"error": str(err)}
            if r["error"]:
                ui.emit({"type": "ran", "id": rid, "error": r["error"]})
            else:
                ui.emit({"type": "ran", "id": rid, "exit": r["exit"], "output": r["output"], "note": r["note"],
                         "cached": r["cached"] is not None, "ms": r["ms"], "redacted": r["redacted"]})
        elif t == "files":
            path = msg.get("path", ".")
            if not isinstance(path, str):
                ui.error("files needs 'path' as a string", "bad_message")
                continue
            try:
                entries, truncated = engine.files(path)
                ui.emit({"type": "files", "path": path, "entries": entries, "truncated": truncated})
            except (ValueError, OSError) as err:
                ui.error(f"cannot list {path}: {err}", "bad_path")
        elif t == "read":
            path = msg.get("path")
            if not isinstance(path, str):
                ui.error("read needs 'path' as a string", "bad_message")
                continue
            try:
                text, size, secret, counts = engine.view(path)
                ui.emit({"type": "file", "path": path, "text": text, "size": size, "secret": secret,
                         "redacted": counts})
            except (ValueError, OSError) as err:
                ui.error(f"cannot read {path}: {err}", "bad_path", path=path)
        elif t in ("trace", "system"):
            inspect(engine, ui, msg)
        elif t == "plan":
            if msg.get("clear") is True:
                engine.clear_plan()
            else:
                ui.plan(engine.plan)
        elif t in ("decision", "result"):
            ui.error(f"no pending proposal {msg.get('id')!r}", "unknown_id")
        else:
            ui.error(f"unknown message type '{t}'", "unknown_type")


