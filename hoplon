    Kind("skills", "suggest_skills", "build_skills", "perform_skills"),
    Kind("sandbox", "run_in_sandbox", "build_sandbox", "run_sandboxed", bulk=True),
    Kind("search", "search_files", "search_proposal", "perform_file", bulk=True),
    Kind("read", "read_file", "build_read", "perform_file", bulk=True),
    Kind("list", "list_dir", "build_read", "perform_file", bulk=True),
    Kind("write", "write_file", "build_write", "perform_file"),
    Kind("edit", "edit_file", "build_edit", "perform_file"),
    Kind("plan", "propose_plan", "build_plan", "perform_plan", answered=True),
    Kind("work_plan", "propose_work_plan", "build_work_plan", "perform_work_plan"),
    Kind("finish", "finish_item", "build_finish", "perform_finish"),
