# Config, blessing, skills, endpoints and profiles

# Every setting hoplon reads from config.json, with its default. Keys starting with "_" are comments.
STARTER_CONFIG = {
    "_help": "default_profile: profile (persona) used when -p is not given. "
             "default_endpoint: endpoint used when neither -e nor the profile names one. "
             "default_skills: skills used when the profile doesn't list its own (-k adds more). "
             "default_commands: command sets (scoped commands) used when the profile doesn't list its own "
             "(--commands adds more). "
             "endpoint_dirs, profile_dirs, skill_dirs, command_dirs: extra directories to search, after the ones here. "
             "fixtures_dir: where /fixtures keeps real samples for the model's test runs (default: "
             "~/.local/state/hoplon/fixtures); outside any project. "
             "max_steps: model steps in a row that run without you deciding anything before the turn pauses "
             "(default 50; a step where you approve or decline something starts the count again). "
             "alerts: false keeps the notify hook quiet (:alerts on|off switches it for a session). "
             "Endpoints, profiles, skills and command sets must be blessed: hoplon --bless PATH",
    "default_profile": None,
    "default_endpoint": None,
    "default_skills": [],
    "default_commands": [],
    "endpoint_dirs": [],
    "profile_dirs": [],
    "skill_dirs": [],
    "command_dirs": [],
    "fixtures_dir": None,
    "max_steps": STEP_LIMIT,
    "alerts": True,
}


class Config:
    def __init__(self, home=None):
        self.home = state_directory(home or config_home())
        data = read_state_json(os.path.join(self.home, "config.json"), {}) or {}
        if not isinstance(data, dict):
            raise HoplonError("config.json must be a JSON object")
        unknown = sorted(k for k in data if k not in STARTER_CONFIG and not k.startswith("_"))
        if unknown:
            eprint(f"hoplon: warning: config.json: unknown setting(s) ignored: {', '.join(unknown)} "
                   f"(known: {', '.join(k for k in STARTER_CONFIG if not k.startswith('_'))})")
        for k in ("default_profile", "default_endpoint"):
            v = data.get(k)
            if v is not None and not (isinstance(v, str) and NAME_RE.fullmatch(v)):
                raise HoplonError(f"config.json: {k} must be a name or null")
        for k in ("default_skills", "default_commands", "endpoint_dirs", "profile_dirs", "skill_dirs", "command_dirs"):
            v = data.get(k, [])
            if not isinstance(v, list) or not all(isinstance(x, str) for x in v):
                raise HoplonError(f"config.json: {k} must be a list of strings")
        fx = data.get("fixtures_dir")
        if fx is not None and not (isinstance(fx, str) and fx.strip()):
            raise HoplonError("config.json: fixtures_dir must be a directory or null")
        self.fixtures_dir = os.path.abspath(os.path.expanduser(fx)) if fx else fixtures_home()
        if not isinstance(data.get("alerts", True), bool):
            raise HoplonError("config.json: alerts must be true or false")
        self.alerts = data.get("alerts", True)
        steps = data.get("max_steps", STEP_LIMIT)
        if type(steps) is not int or not 1 <= steps <= 1000:
            raise HoplonError("config.json: max_steps must be a whole number from 1 to 1000")
        self.max_steps = steps
        self.default_profile = data.get("default_profile")
        self.default_endpoint = data.get("default_endpoint")
        self.default_skills = list(data.get("default_skills", []))
        self.default_commands = list(data.get("default_commands", []))

        def dirs(name):
            return [os.path.join(self.home, name)] + [os.path.expanduser(p) for p in data.get(name[:-1] + "_dirs", [])]
        self.endpoint_dirs, self.profile_dirs, self.skill_dirs = dirs("endpoints"), dirs("profiles"), dirs("skills")
        self.command_dirs = dirs("commands")
        self.blessed_path = os.path.join(self.home, "blessed.json")
        self.not_secret_path = os.path.join(self.home, "not-secret.json")
        self.sessions = os.path.join(self.home, "sessions")
        state_directory(self.sessions)
        if os.path.islink(self.sessions):
            raise HoplonError(f"unsafe hoplon state directory {self.sessions}: symlinks are refused")
        self.audit = Audit(os.path.join(self.home, "audit.log"))

    def ensure(self):
        """First run: create the config tree (0700) and a starter config.json. Existing
        directories and files are left as they are; a failure is a warning, not an error."""
        fresh = not os.path.exists(self.home)
        try:
            missing, d = [], os.path.abspath(self.home)
            while not os.path.lexists(d):
                missing.append(d)
                d = os.path.dirname(d)
            for d in reversed(missing):                       # ~/.config too, whatever the umask
                os.mkdir(d, 0o700)
            state_directory(self.home)
            for d in (self.endpoint_dirs[0], self.profile_dirs[0], self.skill_dirs[0], self.command_dirs[0],
                      self.sessions):
                if not os.path.isdir(d):
                    os.mkdir(d, 0o700)
            conf = os.path.join(self.home, "config.json")
            if not os.path.exists(conf):
                write_private(conf, json.dumps(STARTER_CONFIG, indent=2) + "\n")
        except OSError as e:
            eprint(f"hoplon: warning: cannot create {self.home}: {e}")
            return
        if fresh:
            eprint(f"hoplon: created {self.home} (config.json, endpoints/, profiles/, skills/, commands/, sessions/)")

    def blessed(self):
        b = read_state_json(self.blessed_path, {}) or {}
        return b if isinstance(b, dict) else {}

    def set_blessed(self, path, entry):
        b = self.blessed()
        b[path] = entry
        write_private(self.blessed_path, json.dumps(b, indent=2, sort_keys=True) + "\n")

    def not_secret(self):
        """Contents you said hold no secrets though they look as if they do: sha256 of the text -> where you saw it.
        Only that exact text is excused; the endpoint key always counts."""
        n = read_state_json(self.not_secret_path, {}) or {}
        return n if isinstance(n, dict) else {}

    def set_not_secret(self, digest, path):
        n = self.not_secret()
        n[digest] = {"path": path, "when": datetime.datetime.now().isoformat(timespec="seconds")}
        write_private(self.not_secret_path, json.dumps(n, indent=2, sort_keys=True) + "\n")


def _hash_bytes(h, label, data):
    h.update(label.encode() + b"\0" + str(len(data)).encode() + b"\0" + data)


def read_regular(path):
    """Read a regular file once, refusing symlinks and special files, and return its bytes."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_NONBLOCK", 0))
    except OSError as e:
        raise HoplonError(f"{path}: must be a regular file (not a symlink): {e.strerror}")
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise HoplonError(f"{path}: must be a regular file (not a symlink)")
        return f.read()


def snapshot_skill(path):
    """Read every file of a skill directory once: {relative path: bytes}. Symlinks are refused."""
    if os.path.islink(path) or not os.path.isdir(path):
        raise HoplonError(f"{path}: a skill must be a real directory (not a symlink)")
    files = {}
    for root, dirs, names in os.walk(path, followlinks=False):
        for n in dirs + names:
            full = os.path.join(root, n)
            if os.path.islink(full):
                raise HoplonError(f"{full}: symlinks are not allowed inside a skill")
        for n in names:
            full = os.path.join(root, n)
            if not stat.S_ISREG(os.lstat(full).st_mode):
                raise HoplonError(f"{full}: only regular files are allowed inside a skill")
            files[os.path.relpath(full, path)] = read_regular(full)
    return files


def hash_snapshot(files):
    """The skill hash, computed from a snapshot's bytes: sorted relative paths plus contents."""
    h = hashlib.sha256()
    for rel in sorted(files):
        _hash_bytes(h, rel, files[rel])
    return "sha256:" + h.hexdigest()


def hash_skill(path):
    files = snapshot_skill(path)
    return hash_snapshot(files), sorted(files)


def hash_bytes(data):
    return "sha256:" + hashlib.sha256(data).hexdigest()


def hash_file(path):
    return hash_bytes(read_regular(path))


class Skill:
    """A skill, read once. Its hash and every byte used later come from this one snapshot;
    nothing reopens the files, so editing them afterwards changes nothing until the next load."""

    def __init__(self, name, path, files=None):
        """files: the skill's bytes as sent by hoplon-tui from your own machine (remote mode); path is then only a
        label, and nothing is read here."""
        self.name, self.path = name, path
        try:
            self.files = snapshot_skill(path) if files is None else files
            self.hash = hash_snapshot(self.files)
        except (HoplonError, OSError):
            self.files, self.hash = {}, None

    def text(self):
        return self.files.get("SKILL.md", b"").decode("utf-8", "replace")

    def description(self):
        for line in self.text().splitlines():
            if line.strip():
                return line.strip().lstrip("#").strip()
        return ""


def find_skills(cfg):
    seen = {}
    for d in cfg.skill_dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            p = os.path.join(d, n)
            if n not in seen and os.path.isfile(os.path.join(p, "SKILL.md")):
                seen[n] = Skill(n, os.path.abspath(p))
    return seen


def skill_status(cfg, skill):
    return bless_status(cfg, "skill", skill.path, skill.hash)


def shown_name(name):
    """A skill's name as listings show it: as it is when it is a usable name, else escaped and cut short."""
    if SKILL_NAME.fullmatch(name):
        return name
    text = one_line(name)[0]
    return text[:48] + ("…" if len(text) > 48 else "")


def shown_description(skill):
    """A skill's description as listings show it: one line, escaped, at most SKILL_DESC_MAX characters."""
    text = one_line(skill.description())[0]
    return text[:SKILL_DESC_MAX] + ("…" if len(text) > SKILL_DESC_MAX else "")


def skill_rows(cfg, active=None, found=None):
    """Every skill found, for listings. active: names in use, marked when given. found: the skills your own machine
    sent (remote mode), which are the only ones there, and blessed by being sent. A skill whose name isn't usable
    is listed as "bad name", escaped; it can't be blessed or switched on. Every name and description here is escaped
    and capped, so a listing can't be faked or broken by what a skill's files say."""
    rows = []
    for n, s in sorted((find_skills(cfg) if found is None else found).items()):
        bad = not SKILL_NAME.fullmatch(n)
        row = {"name": shown_name(n), "path": s.path, "description": shown_description(s),
               "status": "bad name" if bad else skill_status(cfg, s) if found is None else "blessed"}
        if active is not None:
            row["active"] = n in active
        rows.append(row)
    return rows


def skill_lines(rows, mark=False):
    """A skill listing for people: one line per skill, then its full path, which is what --bless takes.
    An unblessed or changed skill gets the whole command. mark: start each line with * if it is in use."""
    out = []
    for r in rows:
        lead = ("* " if r.get("active") else "  ") if mark else ""
        out.append(f"{lead}{one_line(r['name'])[0]:20} {r['status']:10} {one_line(r['description'])[0]}")
        path = one_line(shlex.quote(r["path"]))[0]
        if r["status"] == "bad name":
            out.append(f"{' ' * len(lead)}    {path}: rename the directory to use it ({SKILL_NAME_RULE})")
            continue
        out.append(f"{' ' * len(lead)}    " + (path if r["status"] == "blessed" else f"to bless: hoplon --bless {path}"))
    return out


def load_skills(cfg, names, notice):
    """Return the usable skills among names; skip and report the rest."""
    found, out = find_skills(cfg), []
    for n in names:
        s = found.get(n) if SKILL_NAME.fullmatch(n) else None
        if not s:
            notice(f"skill '{shown_name(n)}' not found; skipped")
            continue
        st = skill_status(cfg, s)
        if st != "blessed":
            notice(f"skill '{n}' is {st}; skipped (read it, then: hoplon --bless {s.path})")
            continue
        out.append(s)
    return out


# --------------------------------------------------------------------------
# Command sets and scoped commands: programs you blessed once, with exactly the inputs they may take

COMMAND_SET_KEYS = {"name", "description", "search", "env", "pane", "commands"}
COMMAND_KEYS = {"describe", "usage", "argv", "params", "access", "timeout", "max_output", "min_interval", "cache"}
USAGE_MAX = 1200            # characters of a scoped command's usage section, all lines together
USAGE_LINES = 20
PARAM_KEYS = {"pattern", "enum", "int", "describe"}
SET_NAME = re.compile(r"[a-z][a-z0-9-]{0,30}")
COMMAND_NAME = re.compile(r"[a-z][a-z0-9_]{0,30}")
TEMPLATE = re.compile(r"\{\{|\}\}|\{([A-Za-z0-9_]+)\}|[{}]")
DEFAULT_SEARCH = ("/usr/local/bin", "/usr/bin", "/bin")
PARAM_CAP = 256                # characters of one parameter value
TRUSTED_PER_MINUTE = 30        # real runs across all command sets; more are refused until the minute is up
TRUSTED_CACHE = 256            # results kept for repeated calls


def show_argv(argv):
    """An argument list as one readable line, quoted where needed. For people: nothing is run through a shell."""
    return " ".join(a if re.fullmatch(r"[A-Za-z0-9_@%+=:,./{}-]+", a) else shlex.quote(a) for a in argv)


def _text(data, key, where, default=""):
    v = data.get(key, default)
    if not isinstance(v, str) or len(v) > 1000 or "\0" in v:
        raise ValueError(f"{where}{key} must be text of at most 1000 characters")
    return v


def _usage(v, where):
    """A command's usage section: a list of lines (or one string) of plain text, short enough to send with the
    command every time. No control characters: it goes to the model, and to the blessing screen."""
    lines = [v] if isinstance(v, str) else v
    if not isinstance(lines, list) or not all(isinstance(ln, str) for ln in lines):
        raise ValueError(f"{where} must be a list of lines of text")
    lines = [ln for part in lines for ln in part.split("\n")]
    if len(lines) > USAGE_LINES or sum(len(ln) for ln in lines) > USAGE_MAX:
        raise ValueError(f"{where} must be at most {USAGE_LINES} lines and {USAGE_MAX} characters")
    if any(exact(ln)[1] or one_line(ln)[1] for ln in lines):
        raise ValueError(f"{where} must not hold control or hidden characters")
    return [ln.rstrip() for ln in lines]


def _number(data, key, where, default, lo, hi):
    v = data.get(key, default)
    if type(v) is not int or not lo <= v <= hi:
        raise ValueError(f"{where}{key} must be a whole number from {lo} to {hi}")
    return v


def _object(data, allowed, where):
    if not isinstance(data, dict):
        raise ValueError(f"{where} must be an object")
    unknown = sorted(set(data) - allowed)
    if unknown:
        raise ValueError(f"{where}: unknown field(s): {', '.join(unknown)}")
    return data


def _strings(value, where):
    if not isinstance(value, list) or not value or not all(isinstance(x, str) and "\0" not in x for x in value):
        raise ValueError(f"{where} must be a non-empty list of strings")
    return value


def split_template(text, where):
    """An argument split into (is_placeholder, text) parts. '{{' and '}}' are literal braces; any other brace
    that is not part of a {name} placeholder is an error."""
    parts, pos = [], 0
    for m in TEMPLATE.finditer(text):
        parts.append((False, text[pos:m.start()]))
        if m.group(1):
            parts.append((True, m.group(1)))
        elif m.group(0) in ("{{", "}}"):
            parts.append((False, m.group(0)[0]))
        else:
            raise ValueError(f"{where}: a single '{m.group(0)}' is not allowed (write it doubled to mean a brace)")
        pos = m.end()
    parts.append((False, text[pos:]))
    return parts


class TrustedParam:
    """What one placeholder accepts: a regular expression (the whole value must match), a list of values,
    or a whole number from 0 up. A value that doesn't fit is refused, never cleaned. No value may start with '-':
    one that did could be read by the program as an option (another cluster, an output file), not as data."""

    def __init__(self, data, where):
        _object(data, PARAM_KEYS, where)
        kinds = [k for k in ("pattern", "enum", "int") if k in data]
        if len(kinds) != 1:
            raise ValueError(f"{where}: needs exactly one of pattern, enum, int")
        self.kind, self.rule = kinds[0], data[kinds[0]]
        self.describe = _text(data, "describe", where + ".")
        if self.kind == "pattern":
            try:
                self.rx = re.compile(self.rule)
            except (re.error, TypeError):
                raise ValueError(f"{where}.pattern is not a valid regular expression") from None
            if self.rx.fullmatch(""):
                raise ValueError(f"{where}.pattern matches the empty string")
            if any(self.rx.fullmatch(v) for v in ("-", "-a", "-1", "--a", "--a=b")):
                raise ValueError(f"{where}.pattern accepts a value starting with '-', which a program reads as an option")
        elif self.kind == "enum":
            _strings(self.rule, where + ".enum")
            if any(v.startswith("-") for v in self.rule):
                raise ValueError(f"{where}.enum has a value starting with '-', which a program reads as an option")
        elif not (isinstance(self.rule, list) and len(self.rule) == 2 and all(type(n) is int for n in self.rule)
                  and 0 <= self.rule[0] <= self.rule[1]):
            raise ValueError(f"{where}.int must be [min, max], from 0 up")

    def check(self, value):
        """The value as a string, or ValueError saying why it is refused."""
        if self.kind == "int" and type(value) is int:
            value = str(value)
        if not isinstance(value, str):
            raise ValueError("must be a string")
        if len(value) > PARAM_CAP or "\0" in value or "\n" in value or "\r" in value:
            raise ValueError(f"must be at most {PARAM_CAP} characters, on one line")
        if value.startswith("-"):          # whatever the pattern says: it would be an option, not data
            raise ValueError("must not start with '-'")
        if self.kind == "pattern" and not self.rx.fullmatch(value):
            raise ValueError(f"does not match {self.rule}")
        if self.kind == "enum" and value not in self.rule:
            raise ValueError(f"must be one of: {', '.join(self.rule)}")
        if self.kind == "int" and not (re.fullmatch(r"[0-9]{1,18}", value)
                                       and self.rule[0] <= int(value) <= self.rule[1]):
            raise ValueError(f"must be a whole number from {self.rule[0]} to {self.rule[1]}")
        return value

    def schema(self):
        s = {"type": "string"}
        if self.kind == "pattern":
            s["pattern"] = self.rule
        elif self.kind == "enum":
            s["enum"] = self.rule
        else:
            s["pattern"] = "^[0-9]{1,18}$"
        text = self.describe
        if self.kind == "int":
            text = f"{text} (a whole number from {self.rule[0]} to {self.rule[1]})".strip()
        if text:
            s["description"] = text
        return s

    def rules(self):
        return {self.kind: self.rule, "describe": self.describe}


def trusted_binary(argv0, search):
    """Where a scoped command's program is: argv[0] if it is a path, else the first search directory that has it.
    The user's PATH is never used. The file and its directory must belong to you or root and not be writable
    by group or others, or whoever can write there could swap the program. Returns (path, identity)."""
    paths = [argv0] if os.path.isabs(argv0) else [os.path.join(d, argv0) for d in search]
    path = next((p for p in paths if os.path.exists(p)), None)
    if path is None:
        raise HoplonError(f"{argv0}: not found in {', '.join(search)}", EXIT_USAGE, "not_found")
    real = os.path.realpath(path)
    st = os.stat(real)
    if not stat.S_ISREG(st.st_mode) or not os.access(real, os.X_OK):
        raise HoplonError(f"{real}: not an executable file")
    for p in dict.fromkeys([real, os.path.dirname(real), os.path.dirname(path)]):
        s = os.stat(p)
        if s.st_mode & 0o022 or s.st_uid not in (0, os.geteuid()):
            raise HoplonError(f"{p}: writable by group or others, or owned by another user, so the program there "
                             "could be replaced; refused")
    return real, (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)


class TrustedCommand:
    """One command of a command set: a fixed argument list with named placeholders, and what each accepts."""

    def __init__(self, cset, name, data, search, env):
        where = f"commands.{name}"
        _object(data, COMMAND_KEYS, where)
        self.set, self.name, self.search, self.env_names = cset, name, search, env
        w = where + "."
        self.describe = _text(data, "describe", w)
        self.usage = _usage(data.get("usage", []), w + "usage")
        self.argv = _strings(data.get("argv"), w + "argv")
        self.access = data.get("access")
        if self.access not in ("read", "write"):
            raise ValueError(f'{w}access must be "read" (it only looks) or "write" (it changes something)')
        self.read_only = self.access == "read"
        self.auto = self.read_only       # a write command too, if the user chose so when blessing (allow_auto)
        self.timeout = _number(data, "timeout", w, 15, 1, 120)
        self.max_output = _number(data, "max_output", w, 65536, 1, 1048576)
        self.min_interval = _number(data, "min_interval", w, 2, 0, 3600)
        self.cache = _number(data, "cache", w, 0, 0, 3600)
        params = data.get("params", {})
        if not isinstance(params, dict) or not all(COMMAND_NAME.fullmatch(k) for k in params):
            raise ValueError(f"{w}params must be an object named by parameter names (a-z, 0-9, _)")
        self.params = {k: TrustedParam(v, f"{w}params.{k}") for k, v in params.items()}
        first = self.argv[0]
        if not (re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", first) or (first.startswith("/") and "{" not in first)):
            raise ValueError(f"{w}argv[0] must be a program name without '/' or placeholders, or an absolute path")
        self.parts = [split_template(a, f"{w}argv[{i}]") for i, a in enumerate(self.argv)]
        used = {text for parts in self.parts[1:] for is_param, text in parts if is_param}
        if used - set(self.params):
            raise ValueError(f"{w}argv uses undeclared placeholder(s): {', '.join(sorted(used - set(self.params)))}")
        if set(self.params) - used:
            raise ValueError(f"{w}params not used in argv: {', '.join(sorted(set(self.params) - used))}")
        self.tool = f"{cset.replace('-', '_')}__{name}"        # at most 31 + 2 + 31 characters
        self.binary = self.identity = None

    def resolve(self):
        self.binary, self.identity = trusted_binary(self.argv[0], self.search)

    def changed(self):
        """Why the program may not run now, or None. It must be the very file found at load time."""
        try:
            st = os.stat(self.binary)
        except OSError:
            return "the program is gone since hoplon started; restart hoplon"
        if (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns) != self.identity:
            return "the program changed since hoplon started; restart hoplon"
        return None

    def check(self, args):
        """The arguments as {name: string}, or ValueError. Every parameter is required; none is added or cleaned."""
        if not isinstance(args, dict):
            raise ValueError("params must be an object")
        for k in sorted(set(args) - set(self.params)):
            raise ValueError(f"unknown parameter '{one_line(str(k))[0]}'")
        values = {}
        for k, spec in self.params.items():
            if k not in args:
                raise ValueError(f"missing parameter '{k}'")
            try:
                values[k] = spec.check(args[k])
            except ValueError as e:
                raise ValueError(f"parameter '{k}' {e}") from None
        return values

    def build(self, values):
        """The argument list to run: each placeholder becomes its value, and one argument stays one argument."""
        return [self.binary] + ["".join(values[t] if is_param else t for is_param, t in parts)
                                for parts in self.parts[1:]]

    def shown(self, values=None):
        """The command as shown to people: the program's name, then the values (or the {placeholders})."""
        if values is None:
            return show_argv(self.argv)
        return show_argv([self.argv[0]] + self.build(values)[1:])

    def env(self):
        user = whoami()[0]
        env = {"PATH": ":".join(self.search), "LANG": "C.UTF-8",
               "HOME": os.environ.get("HOME") or os.path.expanduser("~"), "USER": user, "LOGNAME": user}
        env.update({n: os.environ[n] for n in self.env_names if n in os.environ})
        return env

    def schema(self, host):
        how = ("read-only" if self.read_only else "changes something; runs without asking, as the user chose"
               if self.auto else "changes something; the user is asked first")
        props = {k: p.schema() for k, p in self.params.items()}
        text = f"{self.describe} (runs `{self.shown()}` on {host}; {how})".strip()
        if self.usage:
            text += "\n\nUsage:\n" + "\n".join(self.usage)
        return _tool(self.tool, text, props, list(props))

    def info(self):
        return {"name": self.name, "describe": self.describe, "usage": self.usage,
                "params": {k: p.rules() for k, p in self.params.items()},
                "access": self.access, "auto": self.auto, "argv": self.argv}


class CommandSet:
    """A command set, read once like a skill: its hash and manifest come from one snapshot of the directory, so editing
    the files afterwards changes nothing until the next load. error is set when the manifest is refused."""

    def __init__(self, name, path, files=None):
        """files: the command set's bytes as sent by hoplon-tui from your own machine (remote mode); path is then only a
        label, and nothing is read here."""
        self.name, self.path = name, path
        self.error = self.hash = self.pane = None
        self.description, self.commands, self.files = "", {}, {}
        try:
            self.files = snapshot_skill(path) if files is None else files
            self.hash = hash_snapshot(self.files)
        except (HoplonError, OSError) as e:
            self.error = str(e)
            return
        try:
            self.parse(self.files)
        except ValueError as e:
            self.error, self.commands = f"commands.json: {e}", {}

    def parse(self, files):
        data = _object(json.loads(files.get("commands.json", b"").decode("utf-8")), COMMAND_SET_KEYS, "commands.json")
        if data.get("name") != self.name or not SET_NAME.fullmatch(data.get("name", "")):
            raise ValueError("name must be lowercase letters, digits and '-', and the same as the directory's name")
        self.description = _text(data, "description", "")
        search = data.get("search", list(DEFAULT_SEARCH))
        _strings(search, "search")
        if not all(os.path.isabs(d) for d in search):
            raise ValueError("search must list absolute directories")
        env = data.get("env", [])
        if env:
            bad = [n for n in _strings(env, "env")
                   if not ENV_NAME_RE.fullmatch(n) or n == "PATH" or n.startswith("LD_")]
            if bad:
                raise ValueError(f"env: not allowed: {', '.join(bad)} (PATH and LD_* are never passed on)")
        pane = data.get("pane")
        if pane is not None and not (isinstance(pane, str) and NAME_RE.fullmatch(pane) and pane in files):
            raise ValueError("pane must be the name of a file in the command set directory")
        self.pane = pane
        cmds = data.get("commands")
        if not isinstance(cmds, dict) or not cmds or not all(COMMAND_NAME.fullmatch(k) for k in cmds):
            raise ValueError("commands must be an object of commands named a-z, 0-9, _")
        self.commands = {k: TrustedCommand(self.name, k, v, search, env) for k, v in cmds.items()}

    def tools(self):
        return {c.tool: c for c in self.commands.values()}

    def allow_auto(self, names):
        """The write commands the user chose, when blessing, to run without asking; read commands always do."""
        names = set(names) if isinstance(names, list) else set()
        for c in self.commands.values():
            c.auto = c.read_only or c.name in names

    def writes(self):
        return [c for c in self.commands.values() if not c.read_only]

    def resolve(self):
        """Find every command's program now, refusing the command set if one can't be trusted. A program that isn't
        installed here (a cluster without accounting has no sacct) only leaves out its commands; the names of
        those are returned."""
        missing = []
        for c in list(self.commands.values()):
            try:
                c.resolve()
            except HoplonError as e:
                if e.kind != "not_found":
                    raise HoplonError(f"command set '{self.name}', command {c.name}: {e}", EXIT_USAGE, "bad_commands") from None
                missing.append(c.name)
                del self.commands[c.name]
            except OSError as e:
                raise HoplonError(f"command set '{self.name}', command {c.name}: {e}", EXIT_USAGE, "bad_commands") from None
        if not self.commands:
            raise HoplonError(f"command set '{self.name}': none of its programs is installed here", EXIT_USAGE, "bad_commands")
        return missing

    def summary(self):
        """The review screen for blessing: every command with what it may run, and the programs it would use."""
        c0 = next(iter(self.commands.values()))
        lines = [f"  set:      {one_line(self.name)[0]}", f"  about:    {one_line(self.description)[0]}"]
        if self.pane:
            lines.append(f"  pane:     {one_line(self.pane)[0]} (for hoplon-tui; hoplon does not run it)")
        lines.append(f"  search:   {', '.join(one_line(d)[0] for d in c0.search)} (your PATH is never used)")
        lines.append(f"  env:      {', '.join(c0.env_names) or 'none'} passed on, besides PATH, LANG, HOME, USER "
                     "and LOGNAME")
        groups = (("read: these only look, and run without asking", [c for c in self.commands.values() if c.read_only]),
                  ("write: these change something, and ask every time unless you choose otherwise below",
                   self.writes()))
        for title, cmds in groups:
            if not cmds:
                continue
            lines.append(f"  {title}")
            lines += self.command_lines(cmds)
        lines.append("  [!] these commands run on this host as you, with no shell, and the read ones without "
                     "asking: their output goes to the model and the endpoint like any file the model reads")
        return "\n".join(lines)

    def command_lines(self, cmds):
        lines = []
        for c in cmds:
            flag = "runs without asking" if c.read_only else "[asks every time]"
            lines.append(f"  command {one_line(c.name)[0]}: {one_line(c.describe)[0]}  ({flag})")
            lines.append(f"    runs:    {one_line(c.shown())[0]}")
            for k, p in c.params.items():
                lines.append(f"    {k}: {p.kind} {one_line(json.dumps(p.rule))[0]}  {one_line(p.describe)[0]}".rstrip())
            if c.usage:
                lines.append("    usage (sent to the model with the command):")
                lines += [f"      | {ln}" for ln in c.usage]
            lines.append(f"    limits:  {c.timeout} s, {c.max_output} bytes of output, at most one run per "
                         f"{c.min_interval} s, results kept {c.cache} s")
            try:
                lines.append(f"    program: {one_line(trusted_binary(c.argv[0], c.search)[0])[0]}")
            except (HoplonError, OSError) as e:
                lines.append(f"    program: [!] {one_line(str(e))[0]} (the command set can't be used until this is fixed)")
        return lines


def find_command_sets(cfg):
    seen = {}
    for d in cfg.command_dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            p = os.path.join(d, n)
            if n not in seen and os.path.isfile(os.path.join(p, "commands.json")):
                seen[n] = CommandSet(n, os.path.abspath(p))
    return seen


def command_set_status(cfg, cset):
    return "invalid" if cset.hash is None else bless_status(cfg, "command_set", cset.path, cset.hash)


def command_set_rows(cfg, active=(), found=None):
    """Every command set found, for listings and the command sets message. found: the command sets your own machine sent (remote
    mode), which are the only ones there, and blessed by being sent."""
    rows = []
    for n, pl in sorted((find_command_sets(cfg) if found is None else found).items()):
        st = command_set_status(cfg, pl) if found is None else ("invalid" if pl.error else "blessed")
        rows.append({"name": n, "path": pl.path, "dir": pl.path, "description": pl.description or pl.error or "",
                     "status": st, "blessed": st == "blessed", "enabled": n in active, "active": n in active,
                     "error": pl.error, "pane": pl.pane, "commands": [c.info() for c in pl.commands.values()]})
    return rows


def run_program(argv, env, cwd, timeout, cap):
    """Run argv with no shell, no stdin and its own process group. Returns (exit code, stdout, stderr, note); the
    exit code is None when the program was killed. Output past cap bytes (both streams together) is dropped and
    ends the run."""
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE, cwd=cwd,
                            env=env, start_new_session=True)
    bufs, size, over = [bytearray(), bytearray()], [0], threading.Event()

    def drain(stream, buf):
        for chunk in iter(lambda: stream.read1(65536), b""):
            room = max(cap - size[0], 0)
            buf.extend(chunk[:room])
            size[0] += min(len(chunk), room)
            if len(chunk) > room:
                over.set()
                return

    readers = [threading.Thread(target=drain, args=(s, b), daemon=True)
               for s, b in zip((proc.stdout, proc.stderr), bufs)]
    for r in readers:
        r.start()
    deadline, killed = time.monotonic() + timeout, False
    try:
        while proc.poll() is None:
            if over.is_set() or time.monotonic() > deadline:
                killed = True
                break
            over.wait(0.02)
    finally:
        try:
            os.killpg(proc.pid, signal.SIGKILL)       # the program, and anything it left running
        except OSError:
            pass
        proc.wait()
        for r in readers:
            r.join(5)
        proc.stdout.close()
        proc.stderr.close()
    note = f"output cut at {cap} bytes" if over.is_set() else ""
    if killed and not over.is_set():
        note = f"killed after {timeout} s"
    return (None if killed else proc.returncode), bytes(bufs[0]), bytes(bufs[1]), note


def _is_loopback(host):
    if host in ("localhost", "localhost.localdomain") or host.endswith(".localhost"):
        return True
    try:
        return ipaddress.ip_address(host.strip("[]")).is_loopback
    except ValueError:
        return False


class Endpoint:
    """Where requests go and how they are authenticated."""

    def __init__(self, data, path):
        self.path = path
        self.data = data
        if not isinstance(data, dict):
            raise HoplonError(f"{path}: an endpoint must be a JSON object", EXIT_PROFILE)
        unknown = set(data) - ENDPOINT_KEYS
        if unknown:
            hint = " (persona fields belong in a profile, under profiles/)" if unknown & PROFILE_KEYS else ""
            raise HoplonError(f"{path}: unknown endpoint fields: {', '.join(sorted(unknown))}{hint}", EXIT_PROFILE)
        for k in ("name", "base_url", "model"):
            if not isinstance(data.get(k), str) or not data[k]:
                raise HoplonError(f"{path}: '{k}' is required", EXIT_PROFILE)
        self.name, self.base_url, self.model = data["name"], data["base_url"].rstrip("/"), data["model"]
        if "key_env" in data and "key_file" in data:
            raise HoplonError(f"{path}: give key_env or key_file, not both", EXIT_PROFILE)
        self.key_env, self.key_file = data.get("key_env"), data.get("key_file")
        if self.key_env is not None and not (isinstance(self.key_env, str) and ENV_NAME_RE.fullmatch(self.key_env)):
            raise HoplonError(f"{path}: 'key_env' must be a plain variable name (letters, digits, underscore)",
                             EXIT_PROFILE)
        self.context_limit = int(data.get("context_limit", 32000))
        self.timeout = float(data.get("timeout", 120))
        self.ca_bundle = data.get("ca_bundle")
        self.headers = data.get("headers", {}) or {}
        self.params = dict(data.get("params", {}) or {})
        self.allow_http = bool(data.get("allow_http", False))
        self.proxy = data.get("proxy")
        self.token = None       # remote mode: the session token the key proxy requires (see remote_config)
        if not isinstance(self.headers, dict) or not all(isinstance(v, str) for v in self.headers.values()):
            raise HoplonError(f"{path}: 'headers' must map names to strings", EXIT_PROFILE)
        if any(k.lower() in ("authorization", "proxy-authorization", "cookie") for k in self.headers):
            raise HoplonError(f"{path}: credentials don't belong in an endpoint's headers; use key_env or key_file",
                             EXIT_PROFILE)
        for k in ("model", "messages", "tools"):
            if k in self.params:
                raise HoplonError(f"{path}: params may not set '{k}'", EXIT_PROFILE)
        u = urllib.parse.urlsplit(self.base_url)
        if u.scheme not in ("https", "http") or not u.hostname:
            raise HoplonError(f"{path}: base_url must be an http(s) URL", EXIT_PROFILE)
        if u.username or u.password:
            raise HoplonError(f"{path}: base_url must not contain credentials", EXIT_PROFILE)
        if u.scheme == "http" and not (_is_loopback(u.hostname) or self.allow_http):
            raise HoplonError(f"{path}: plain HTTP to {u.hostname} needs \"allow_http\": true", EXIT_PROFILE)
        if self.proxy is not None:
            pu = urllib.parse.urlsplit(str(self.proxy))
            if pu.scheme not in ("http", "https") or not pu.hostname:
                raise HoplonError(f"{path}: 'proxy' must be an http(s) URL", EXIT_PROFILE)

    @classmethod
    def load(cls, path):
        return cls.parse(read_bytes_or_missing(path, "endpoint"), path)

    @classmethod
    def parse(cls, raw, path):
        return cls(parse_json_bytes(raw, path), os.path.abspath(path))

    def destination_id(self):
        """Fingerprint where a conversation goes, without storing endpoint headers or proxy credentials: the server
        (scheme, host and port), and the proxy, CA bundle and headers that reach it. Not the model or the URL's
        path, so switching models on the same server doesn't need consent each time."""
        u = urllib.parse.urlsplit(self.base_url)
        port = u.port or {"https": 443, "http": 80}.get(u.scheme)
        fields = [u.scheme, (u.hostname or "").lower(), port, self.proxy, self.ca_bundle, self.headers]
        return hash_bytes(json.dumps(fields, sort_keys=True).encode())

    def key_source(self):
        """Where the key comes from, escaped for one line. Returns (text, flagged)."""
        if self.key_env:
            d, f = one_line(self.key_env)
            return f"environment variable ${d}", f
        if self.key_file:
            d, f = one_line(self.key_file)
            return f"file {d} (must be mode 0600)", f
        return "none (no Authorization header is sent)", False

    def key(self):
        if self.key_env:
            v = os.environ.get(self.key_env)
            if not v:
                raise HoplonError(f"endpoint '{self.name}' reads its key from ${self.key_env}, which is not set",
                                 EXIT_PROFILE)
            return v.strip()
        if self.key_file:
            p = os.path.expanduser(self.key_file)
            try:
                st = os.stat(p)
            except OSError as e:
                raise HoplonError(f"key file {p}: {e.strerror}", EXIT_PROFILE)
            if st.st_mode & 0o077:
                raise HoplonError(f"key file {p} must be mode 0600 (it is {stat.S_IMODE(st.st_mode):04o})",
                                 EXIT_PROFILE)
            if st.st_uid != os.getuid():
                raise HoplonError(f"key file {p} is not owned by you", EXIT_PROFILE)
            with open(p, encoding="utf-8") as f:
                return f.read().strip()
        return None

    def summary(self):
        """The review screen, every field escaped to one line. Returns (text, flagged)."""
        flags = []

        def one(v):
            d, f = one_line(str(v))
            flags.append(f)
            return d

        url = one(self.base_url)
        host = urllib.parse.urlsplit(self.base_url).hostname or ""
        if not host.isascii():
            try:
                url += f"  (punycode: {host.encode('idna').decode('ascii')})"
            except UnicodeError:
                url += "  (this host name cannot be converted to punycode)"
        key, kflag = self.key_source()
        lines = [f"  endpoint: {one(self.name)}", f"  url:      {url}", f"  model:    {one(self.model)}",
                 f"  key from: {key}", f"  context:  {self.context_limit} tokens"]
        flags.append(kflag)
        if self.allow_http:
            lines.append("  [!] allow_http: prompts, files and the key may travel unencrypted")
        if self.proxy:
            lines.append(f"  proxy:    {one(self.proxy)}")
        if self.ca_bundle:
            lines.append(f"  CA:       {one(self.ca_bundle)}")
        if self.headers:
            lines.append(f"  headers:  {', '.join(one(k) for k in sorted(self.headers))}")
        if self.params:
            lines.append(f"  params:   {json.dumps(self.params, sort_keys=True)}")
        return "\n".join(lines), any(flags)

    def info(self):
        return {"name": self.name, "base_url": self.base_url, "model": self.model}


class Profile:
    """A persona: which endpoint, what to tell the model, which skills, sampling params, coding mode, and the
    sandbox the model may run commands in."""

    def __init__(self, data, path):
        self.path, self.data = path, data
        if not isinstance(data, dict):
            raise HoplonError(f"{path}: a profile must be a JSON object", EXIT_PROFILE)
        unknown = set(data) - PROFILE_KEYS
        if unknown:
            hint = " (this looks like an endpoint; endpoints go under endpoints/)" if "base_url" in data else ""
            raise HoplonError(f"{path}: unknown profile fields: {', '.join(sorted(unknown))}{hint}", EXIT_PROFILE)
        if not isinstance(data.get("name"), str) or not NAME_RE.fullmatch(data["name"]):
            raise HoplonError(f"{path}: 'name' is required (letters, digits, '.', '_', '-')", EXIT_PROFILE)
        self.name = data["name"]
        self.description = data.get("description", "")
        self.endpoint = data.get("endpoint")
        self.persona = data.get("persona", "")
        self.skills = data.get("skills")          # None: the profile leaves skills to default_skills
        self.command_sets = data.get("commands")       # likewise for default_commands
        self.params = data.get("params", {})
        self.coding = data.get("coding", False)
        if self.endpoint is not None and not (isinstance(self.endpoint, str) and NAME_RE.fullmatch(self.endpoint)):
            raise HoplonError(f"{path}: 'endpoint' must be an endpoint name", EXIT_PROFILE)
        if not isinstance(self.description, str) or not isinstance(self.persona, str):
            raise HoplonError(f"{path}: 'description' and 'persona' must be text", EXIT_PROFILE)
        if self.skills is not None and not (isinstance(self.skills, list) and all(isinstance(x, str) for x in self.skills)):
            raise HoplonError(f"{path}: 'skills' must be a list of skill names", EXIT_PROFILE)
        if self.command_sets is not None and not (isinstance(self.command_sets, list)
                                             and all(isinstance(x, str) for x in self.command_sets)):
            raise HoplonError(f"{path}: 'commands' must be a list of command set names", EXIT_PROFILE)
        if not isinstance(self.params, dict):
            raise HoplonError(f"{path}: 'params' must be an object", EXIT_PROFILE)
        for k in ("model", "messages", "tools"):
            if k in self.params:
                raise HoplonError(f"{path}: params may not set '{k}'", EXIT_PROFILE)
        if not isinstance(self.coding, bool):
            raise HoplonError(f"{path}: 'coding' must be true or false", EXIT_PROFILE)
        self.edits = data.get("edits", "ask")
        if self.edits not in EDITS_MODES:
            raise HoplonError(f"{path}: 'edits' must be \"ask\" or \"approved-files\"", EXIT_PROFILE)
        self.sandbox = parse_sandbox(data["sandbox"], path) if "sandbox" in data else None
        self.work = parse_work(data["work"], path) if "work" in data else None
        if self.work and not self.sandbox:
            raise HoplonError(f"{path}: 'work' needs a 'sandbox': a work session tests in it", EXIT_PROFILE)
        self.layout = data.get("layout", {})       # for hoplon-tui: which of its panes start shown
        if not (isinstance(self.layout, dict) and set(self.layout) <= set(LAYOUT_PANES)
                and all(v in ("shown", "hidden") for v in self.layout.values())):
            raise HoplonError(f"{path}: 'layout' must map {', '.join(LAYOUT_PANES)} to \"shown\" or \"hidden\"",
                              EXIT_PROFILE)

    @classmethod
    def load(cls, path):
        return cls.parse(read_bytes_or_missing(path, "profile"), path)

    @classmethod
    def parse(cls, raw, path):
        return cls(parse_json_bytes(raw, path), os.path.abspath(path))

    def summary(self):
        """The review screen. One-line fields are escaped; the persona carries its own warning.
        Returns (text, flagged), where flagged covers the one-line fields."""
        flags = []

        def one(v):
            d, f = one_line(str(v))
            flags.append(f)
            return d

        lines = [f"  profile:  {one(self.name)}"]
        if self.description:
            lines.append(f"  about:    {one(self.description)}")
        lines.append(f"  endpoint: {one(self.endpoint) if self.endpoint else '(none; -e or default_endpoint decides)'}")
        if self.skills is None:
            lines.append("  skills:   (not set; default_skills apply)")
        else:
            lines.append(f"  skills:   {', '.join(one(k) for k in self.skills) or 'none'}")
        if self.command_sets:
            lines.append(f"  commands: {', '.join(one(k) for k in self.command_sets)} (scoped commands; each command set "
                         "must be blessed on its own)")
        if self.params:
            lines.append(f"  params:   {json.dumps(self.params, sort_keys=True)}")
        if self.coding:
            lines.append("  [!] grants coding mode: the model reads and lists files in your working directory "
                         "without asking (writes still ask)")
        if self.edits == "approved-files":
            lines.append("  [!] edits: approved-files: after you approve an edit or write to a file, further edits to "
                         "it apply without asking, for the rest of the session")
        if self.sandbox:
            b = self.sandbox
            lines.append(f"  sandbox:  podman, image {one(b['image'])}, {b['timeout']} s limit: in coding mode the model "
                         "runs commands on a throwaway copy of the project, without asking")
            if b["network"]:
                lines.append("  [!] the sandbox starts with the network ON: code the model writes could send your "
                             "project anywhere, so each run asks first")
        if self.work:
            w = self.work
            test = f"test command {one(w['test'])}" if w["test"] else "no test command"
            lines.append(f"  work:     {w['steps_per_item']} steps per plan item, {w['time_limit'] // 60} min unattended, "
                         f"{test}")
            pl = w["planner"]
            if pl and pl["endpoint"]:
                lines.append(f"            plans with endpoint {one(pl['endpoint'])}"
                             + (f", model {one(pl['model'])}" if pl["model"] else "") + ", which also sees the project")
            elif pl:
                lines.append(f"            plans with model {one(pl['model'])}, on the same endpoint")
        if self.persona:
            lines.append("  persona (sent to the model with every request):")
            lines += ["    | " + ln for ln in show_exact(self.persona).splitlines()]
        else:
            lines.append("  persona:  (none)")
        return "\n".join(lines), any(flags)


KINDS = {"endpoint": Endpoint, "profile": Profile}


def kind_dirs(cfg, kind):
    return cfg.endpoint_dirs if kind == "endpoint" else cfg.profile_dirs


def _locate(cfg, kind, name):
    for d in kind_dirs(cfg, kind):
        p = os.path.join(d, name + ".json")
        if os.path.exists(p):
            return os.path.abspath(p)
    for path, entry in sorted(cfg.blessed().items()):
        if entry.get("kind") == kind and entry.get("name") == name and os.path.exists(path):
            return path
    return None


def find_named(cfg, kind, name):
    """Find an endpoint or profile by name: in its directories first, then wherever one was blessed."""
    if not isinstance(name, str) or not NAME_RE.fullmatch(name):
        raise HoplonError(f"bad {kind} name '{name}'", EXIT_PROFILE)
    path = _locate(cfg, kind, name)
    if path:
        return path
    other = "profile" if kind == "endpoint" else "endpoint"
    hint = ""
    if _locate(cfg, other, name):
        flag = "-p" if other == "profile" else "-e"
        hint = f"\n  There is {'an' if other == 'endpoint' else 'a'} {other} by that name: use {flag} {name} " \
               f"(or default_{other} in config.json)."
    raise HoplonError(f"no {kind} named '{name}'. Nothing was sent.{hint}", EXIT_PROFILE)


def bless_status(cfg, kind, path, h=None):
    """Compare a hash with the blessed one. For a skill, pass the hash of the snapshot in use;
    for a file, pass the hash of the bytes in use (or None to hash the file now)."""
    entry = cfg.blessed().get(path)
    if not entry or entry.get("kind") != kind:
        return "unblessed"
    try:
        if h is None:
            h = hash_skill(path)[0] if kind in ("skill", "command_set") else hash_file(path)
    except (HoplonError, OSError):
        return "invalid"
    return "blessed" if h == entry.get("hash") else "changed"


def load_named(cfg, kind, path):
    """Read an endpoint or profile file once; return the parsed object and its status.
    The hash and the parse both come from the same bytes."""
    raw = read_bytes_or_missing(path, kind)
    return KINDS[kind].parse(raw, path), bless_status(cfg, kind, path, hash_bytes(raw))


def select_named(cfg, kind, name):
    """Load and check a blessed endpoint or profile."""
    path = find_named(cfg, kind, name)
    obj, st = load_named(cfg, kind, path)
    if st == "unblessed":
        raise HoplonError(f"{kind} '{name}' ({path}) is not blessed. Nothing was sent.\n"
                         f"  Review it, then: hoplon --bless {path}", EXIT_PROFILE)
    if st != "blessed":
        raise HoplonError(f"{kind} '{name}' ({path}) changed since it was blessed. Nothing was sent.\n"
                         f"  Review it again, then: hoplon --bless {path}", EXIT_PROFILE)
    return obj


REMOTE_ITEM_CAP = 1 << 20      # bytes of one skill or command set sent to a remote hoplon


def remote_items(raw, kind, bad):
    """The skills or command sets in a config line: {name: Skill or Command set}, made from the bytes your machine sent. Each
    one's hash is computed again here from those bytes and must be the one blessed there."""
    if raw is None:
        return {}
    if not isinstance(raw, list):
        raise bad(f"'{kind}s' must be a list")
    out = {}
    for item in raw:
        keys = {"name", "hash", "files"} | ({"auto"} if kind == "command_set" else set())
        if not isinstance(item, dict) or not {"name", "hash", "files"} <= set(item) <= keys:
            raise bad(f"each {kind} must have exactly 'name', 'hash' and 'files'"
                      + (" (and optionally 'auto')" if kind == "command_set" else ""))
        if not isinstance(item.get("auto", []), list) or not all(isinstance(x, str) for x in item.get("auto", [])):
            raise bad(f"{kind} '{one_line(str(item['name']))[0]}': 'auto' must be a list of command names")
        name, files = item["name"], item["files"]
        if (not isinstance(name, str) or not NAME_RE.fullmatch(name) or name in out
                or (kind == "skill" and not SKILL_NAME.fullmatch(name))):
            raise bad(f"{kind} names must be distinct names (letters, digits, . _ -)"
                      + (f"; a skill's: {SKILL_NAME_RULE}" if kind == "skill" else ""))
        if not isinstance(files, dict) or not files:
            raise bad(f"{kind} '{name}': 'files' must be an object of relative paths")
        data, size = {}, 0
        for rel, b64 in files.items():
            parts = rel.split("/") if isinstance(rel, str) else [""]
            if not isinstance(b64, str) or "\0" in rel or any(p in ("", ".", "..") for p in parts):
                raise bad(f"{kind} '{name}': bad file {one_line(str(rel))[0]!r}")
            try:
                data[rel] = base64.b64decode(b64, validate=True)
            except ValueError:
                raise bad(f"{kind} '{name}': a file is not base64") from None
            size += len(data[rel])
        if size > REMOTE_ITEM_CAP:
            raise bad(f"{kind} '{name}' is over {REMOTE_ITEM_CAP} bytes")
        if hash_snapshot(data) != item["hash"]:
            raise bad(f"{kind} '{name}': its files don't match the hash blessed on your machine")
        label = f"{name} (from your machine)"
        if kind == "skill":
            if "SKILL.md" not in data:
                raise bad(f"skill '{name}' has no SKILL.md")
            out[name] = Skill(name, label, data)
        else:
            out[name] = CommandSet(name, label, data)
            if out[name].error:
                raise bad(f"command set '{name}': {out[name].error}")
            out[name].allow_auto(item.get("auto", []))
    return out


def remote_config(line, audit):
    """Parse the config line hoplon-tui sends first with --config-stdin: an endpoint, a profile (or null), the
    session token, and the skills and command sets to use. hoplon-tui checked the user's blessed files on their machine,
    so nothing here is looked up or blessed on this host; the audit log records what arrived, with hashes. The key
    stays on the user's machine: the endpoint is a loopback port that ssh forwards to a proxy there, which adds the
    key when the token matches. Returns the endpoint, the profile and {"skills": {...}, "command_sets": {...}}."""
    def bad(why):
        return HoplonError(f"bad config from the wrapper: {why}. Nothing was sent.", EXIT_PROFILE, "bad_config")

    try:
        msg = json.loads(line)
    except ValueError:
        raise bad("the first line is not JSON") from None
    if not isinstance(msg, dict) or msg.get("type") != "config":
        raise bad("the first line must be a config message")
    ep, prof, token = msg.get("endpoint"), msg.get("profile"), msg.get("token")
    if not isinstance(token, str) or not TOKEN_RE.fullmatch(token):
        raise bad("'token' must be 32 to 128 hex characters")
    if not isinstance(ep, dict) or (prof is not None and not isinstance(prof, dict)):
        raise bad("'endpoint' and 'profile' must be objects")
    if "key_env" in ep or "key_file" in ep or ep.get("proxy") is not None:
        raise bad("the endpoint may not name a key or a proxy here: the key stays on your machine")
    try:
        endpoint = Endpoint(ep, "config endpoint")
        persona = Profile(prof, "config profile") if prof is not None else None
    except HoplonError as e:
        raise bad(str(e)) from None
    m = REMOTE_URL.fullmatch(endpoint.base_url)
    if not m or not 0 < int(m.group(1)) < 65536:
        raise bad("base_url must be http://127.0.0.1:PORT, optionally with a path")
    offered = {"skills": remote_items(msg.get("skills"), "skill", bad),
               "command_sets": remote_items(msg.get("command_sets"), "command_set", bad)}
    endpoint.token = token
    digest = lambda o: hash_bytes(json.dumps(o, sort_keys=True).encode())
    audit.log("remote_config", endpoint=endpoint.name, model=endpoint.model, endpoint_sha256=digest(ep),
              profile=persona.name if persona else None, profile_sha256=digest(prof) if persona else None,
              skills={n: s.hash for n, s in offered["skills"].items()},
              command_sets={n: p.hash for n, p in offered["command_sets"].items()})
    return endpoint, persona, offered


# Endpoint fields that never travel to a remote host: where the key is, the proxy (the key proxy uses the endpoint's
# own proxy, here, and a remote one would dial it from there), headers (they may hold secrets and are added here by
# the key proxy) and the local CA bundle path (the remote leg is plain HTTP over the tunnel).
REMOTE_STRIP = ("key_env", "key_file", "proxy", "headers", "ca_bundle")


def export_items(cfg, kind, names):
    """The blessed skills or command sets among names, with their bytes (base64) and hash, for a remote hoplon. One that
    is missing, not blessed, refused or too big is left out, and hoplon says so on stderr."""
    found, out = (find_skills(cfg) if kind == "skill" else find_command_sets(cfg)), []
    for n in dict.fromkeys(names):
        item = found.get(n)
        st = None if item is None else (skill_status(cfg, item) if kind == "skill" else command_set_status(cfg, item))
        why = ("not found" if item is None else f"{st} (hoplon --bless {item.path})" if st != "blessed" else
               getattr(item, "error", None) or
               (f"over {REMOTE_ITEM_CAP} bytes" if sum(map(len, item.files.values())) > REMOTE_ITEM_CAP else None))
        if why:
            eprint(f"hoplon: {kind} '{n}' is not sent to the remote host: {why}")
            continue
        out.append({"name": n, "hash": item.hash,
                    "files": {rel: base64.b64encode(b).decode() for rel, b in sorted(item.files.items())}})
        if kind == "command_set":
            out[-1]["auto"] = cfg.blessed().get(item.path, {}).get("auto", [])
    return out


def export_remote(cfg, profile_name, endpoint_name, skills=(), command_sets=()):
    """What hoplon-tui's remote mode needs from this machine's configuration, resolved and checked exactly as a
    normal start would (default profile and endpoint, default skills and command sets, blessing, changed files), and
    nothing secret: the skills and command sets in use go with their bytes, which the remote hoplon checks against the
    hashes blessed here."""
    pname = profile_name or cfg.default_profile
    persona = select_named(cfg, "profile", pname) if pname else None
    endpoint = select_endpoint(cfg, endpoint_name or (persona.endpoint if persona else None) or cfg.default_endpoint)
    path = urllib.parse.urlsplit(endpoint.base_url).path
    if not re.fullmatch(r"(?:/[A-Za-z0-9._~-]+)*", path):
        raise HoplonError(f"endpoint '{endpoint.name}': the path of base_url ({path!r}) can't be used in remote mode "
                         "(letters, digits and . _ ~ - only)", EXIT_PROFILE)
    skills = export_items(cfg, "skill", (persona.skills if persona and persona.skills is not None
                                         else cfg.default_skills) + list(skills))
    sets = export_items(cfg, "command_set", (persona.command_sets if persona and persona.command_sets is not None
                                           else cfg.default_commands) + list(command_sets))
    cfg.audit.log("remote_config_export", endpoint=endpoint.name, profile=persona.name if persona else None,
                  skills={s["name"]: s["hash"] for s in skills}, command_sets={p["name"]: p["hash"] for p in sets})
    return {"endpoint": {k: v for k, v in endpoint.data.items() if k not in REMOTE_STRIP},
            "profile": persona.data if persona else None, "endpoint_name": endpoint.name, "base_path": path,
            "skills": skills, "command_sets": sets}


def select_endpoint(cfg, name):
    if not name:
        raise HoplonError("no endpoint is configured. Nothing was sent.\n"
                         "  Add one to ~/.config/hoplon/endpoints/ and bless it, then use -e NAME, a profile that "
                         "names it, or default_endpoint in config.json.", EXIT_PROFILE)
    return select_named(cfg, "endpoint", name)


def list_named(cfg, kind):
    found = {}
    for d in kind_dirs(cfg, kind):
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            if n.endswith(".json") and n[:-5] not in found:
                found[n[:-5]] = os.path.abspath(os.path.join(d, n))
    for path, entry in sorted(cfg.blessed().items()):
        if entry.get("kind") == kind and entry.get("name") not in found and os.path.exists(path):
            found[entry.get("name")] = path
    rows = []
    for name, path in sorted(found.items()):
        try:
            obj, st = load_named(cfg, kind, path)
            if kind == "endpoint":
                desc = f"{obj.model} at {obj.base_url}"
            else:
                desc = (f"[{obj.endpoint}] " if obj.endpoint else "") + obj.description + \
                       (" (grants coding mode)" if obj.coding else "")
        except HoplonError as e:
            desc, st = str(e), "invalid"
        rows.append({"name": name, "path": path, "status": st, "description": desc})
    return rows


def bless(cfg, path, ask):
    """Show what is being blessed and record its hash if the user confirms."""
    path = os.path.abspath(os.path.expanduser(path))
    if is_hook_path(cfg, path):
        return bless_hook(cfg, ask)
    if os.path.isdir(path):
        files = snapshot_skill(path)
        cset = CommandSet(os.path.basename(path), path) if "commands.json" in files else None
        if cset and cset.error:
            raise HoplonError(f"{path}: {cset.error}")
        if not cset and "SKILL.md" not in files:
            raise HoplonError(f"{path}: a skill needs a SKILL.md, and a command set a commands.json")
        if not cset and not SKILL_NAME.fullmatch(os.path.basename(path)):
            raise HoplonError(f"{one_line(path)[0]}: a skill's name (its directory's) must be {SKILL_NAME_RULE}; "
                             "rename it, then bless it", EXIT_USAGE, "bad_name")
        h = hash_snapshot(files)
        print(f"{'Command set' if cset else 'Skill'} {one_line(os.path.basename(path))[0]} at {one_line(path)[0]}")
        for f in sorted(files):
            print(f"  {one_line(f)[0]} ({len(files[f])} bytes)")
        print(f"  hash: {h}")
        for f in sorted(files):
            try:
                text = files[f].decode("utf-8")
            except UnicodeDecodeError:
                print(f"  {one_line(f)[0]}: binary (not UTF-8); it cannot be shown or checked for hidden characters")
                continue
            found = hidden_found(text)
            if found:
                print(f"  [!] {one_line(f)[0]} has hidden or control characters: {found}")
        if any(one_line(x)[1] for x in [path, *files]):
            print("  [!] the name or a file name above had characters that were escaped; read carefully")
        if cset:
            print(cset.summary())
        entry = {"kind": "command_set" if cset else "skill", "name": os.path.basename(path), "hash": h}
        question = ("Have you read every command above, and may the model and you run them as shown?" if cset
                    else "Have you read every file above, and do you want to use this skill?")
    else:
        raw = read_regular(path)
        h = hash_bytes(raw)
        data = parse_json_bytes(raw, path)
        if isinstance(data, dict) and "base_url" in data:
            ep = Endpoint(data, path)
            text, flagged = ep.summary()
            print(f"Endpoint at {one_line(path)[0]}\n{text}\n  hash:     {h}")
            print("Everything you send to this endpoint (prompts, files, the key) goes to the URL above.")
            if flagged:
                print("  [!] some fields above had control or hidden characters that were escaped; "
                      "this file may be trying to mislead you")
            entry = {"kind": "endpoint", "name": ep.name, "hash": h}
            question = "Send your prompts, files and key to this endpoint?"
        else:
            prof = Profile(data, path)
            text, flagged = prof.summary()
            print(f"Profile at {one_line(path)[0]}\n{text}\n  hash:     {h}")
            if flagged:
                print("  [!] some fields above had control or hidden characters that were escaped; "
                      "this file may be trying to mislead you")
            print("The persona is sent to the model as instructions. The endpoint and skills it names "
                  "must be blessed on their own.")
            entry = {"kind": "profile", "name": prof.name, "hash": h}
            question = "Have you read the persona above, and do you want to use this profile" + \
                       (", including the coding mode it grants?" if prof.coding else "?")
    if not ask(question):
        print("Not blessed.")
        return False
    if os.path.isdir(path) and cset and cset.writes():
        print("Write commands ask you every time. You can let some of them run without asking; "
              "every run is still logged as trusted_run.")
        entry["auto"] = [c.name for c in cset.writes()
                         if ask(f"Let the model run {one_line(c.name)[0]} ({one_line(c.shown())[0]}) without asking you?")]
    entry["blessed_at"] = now()
    cfg.set_blessed(path, entry)
    cfg.audit.log("bless", path=path, kind=entry["kind"], hash=h, **({"auto": entry["auto"]} if "auto" in entry else {}))
    print("Blessed.")
    return True


# --------------------------------------------------------------------------
# The notify hook: a program of yours, run when hoplon waits for you (see HOOKS.md)

def hook_path(cfg):
    return os.path.abspath(os.path.join(cfg.home, "hooks", "notify"))


def is_hook_path(cfg, path):
    """Is this the config home's hooks/notify? Judged by where it is, not by what it holds."""
    want = hook_path(cfg)
    return (os.path.basename(path) == "notify"
            and os.path.realpath(os.path.dirname(path)) == os.path.realpath(os.path.dirname(want)))


def hook_mode_problem(path):
    """Why this file may not be a hook (not a regular file, not yours, writable by others), or None."""
    try:
        st = os.lstat(path)
    except OSError as e:
        return e.strerror
    if not stat.S_ISREG(st.st_mode):
        return "is not a regular file (a symlink is not allowed)"
    if st.st_uid != os.getuid():
        return "is not owned by you"
    if st.st_mode & 0o022:
        return "is writable by group or others"
    return None


def hook_problem(cfg, path):
    """Why the notify hook must not run right now, or None. The bytes are read once and hashed."""
    why = hook_mode_problem(path)
    if why:
        return why
    try:
        if not os.lstat(path).st_mode & 0o100:
            return "is not executable (chmod u+x)"
        h = hash_file(path)
    except (HoplonError, OSError):
        return "cannot be read"
    entry = cfg.blessed().get(path)
    if not entry or entry.get("kind") != "hook":
        return "is not blessed"
    return None if h == entry.get("hash") else "changed since it was blessed"


def bless_hook(cfg, ask):
    """Show the notify hook, whole, and record its hash if the user confirms."""
    path = hook_path(cfg)
    why = hook_mode_problem(path)
    if why:
        raise HoplonError(f"{path}: a hook {why}; it cannot be blessed")
    raw = read_regular(path)
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise HoplonError(f"{path}: a hook must be a UTF-8 text file, so that it can be shown; it cannot be blessed")
    h = hash_bytes(raw)
    print(f"Hook at {one_line(path)[0]}\n  a hook: a program hoplon will run as you when it is waiting for you\n"
          f"  size:     {len(raw)} bytes\n  hash:     {h}\n{margin(text)}")
    found = hidden_found(text)
    if found:
        print(f"  [!] the hook has hidden or control characters: {found}")
    if not os.lstat(path).st_mode & 0o100:
        print("  note: it is not executable, so it will not run until you: chmod u+x " + shlex.quote(path))
    if not ask("Have you read the whole hook above, and do you want hoplon to run it as you?"):
        print("Not blessed.")
        return False
    cfg.set_blessed(path, {"kind": "hook", "name": "notify", "hash": h, "blessed_at": now()})
    cfg.audit.log("bless", path=path, kind="hook", hash=h)
    print("Blessed.")
    return True


def short_path(path):
    home = os.path.expanduser("~")
    shown = "~" + path[len(home):] if home != "/" and path.startswith(home + "/") else path
    return one_line(shown)[0]


class Notifier:
    """Runs the notify hook. It only observes: hoplon never waits for it and never reads its answer."""

    def __init__(self, engine):
        self.e, self.path, self.dead = engine, hook_path(engine.cfg), False

    @classmethod
    def start(cls, engine):
        """The notifier for this run, or None. A hook that is present but not usable is reported once."""
        path = hook_path(engine.cfg)
        if not os.path.lexists(path):
            return None
        why = hook_problem(engine.cfg, path)
        if why:
            engine.ui.notice(f"the notify hook {short_path(path)} {why}, so it will not run. "
                             f"Review it, then: hoplon --bless {shlex.quote(path)}")
            return None
        return cls(engine)

    def fire(self, event, **fields):
        if self.dead:
            return
        why = hook_problem(self.e.cfg, self.path)
        if why:
            self.dead = True
            self.e.ui.notice(f"the notify hook {why}; it is not run for the rest of this session")
            return
        e = self.e
        line = json.dumps({"event": event, **fields, "session": e.session.id, "cwd": os.getcwd(),
                           "endpoint": e.endpoint.name, "sandbox": e.sandbox, "version": VERSION},
                          ensure_ascii=True)
        env = {k: v for k, v in os.environ.items() if k != e.endpoint.key_env}
        try:
            proc = subprocess.Popen([self.path], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, env=env, cwd=e.cfg.home if os.path.isdir(e.cfg.home)
                                    else "/", start_new_session=True, close_fds=True)
        except OSError as err:
            self.dead = True
            e.ui.notice(f"the notify hook could not be started ({err.strerror}); it is ignored")
            return
        try:        # a short line into an empty pipe does not block; done here so a quick exit still delivers it
            proc.stdin.write(line.encode() + b"\n")
            proc.stdin.close()
        except OSError:
            pass
        threading.Thread(target=self._reap, args=(proc,), daemon=True).start()
        e.audit.log("hook", hook="notify", when=event, **fields)

    @staticmethod
    def _reap(proc):
        """Wait for the hook; past the time limit kill its whole process group. Nothing here may raise."""
        try:
            try:
                proc.wait(HOOK_TIMEOUT)
            except subprocess.TimeoutExpired:
                os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()
        except Exception:
            pass


# --------------------------------------------------------------------------
# File tools, confined to the working directory

def split_rel(path):
    """Split a model-supplied path into components, or raise ValueError."""
    if not isinstance(path, str) or not path or "\0" in path:
        raise ValueError("path must be a non-empty string")
    if path.startswith("/") or path.startswith("~"):
        raise ValueError("absolute paths are not allowed; use a path relative to the working directory")
    parts = [p for p in path.split("/") if p not in ("", ".")]
    if any(p == ".." for p in parts):
        raise ValueError("'..' is not allowed in paths")
    return parts


def is_hidden(parts):
    """A path whose reads and writes always ask: a part starting with '.', or a name the sandbox hides as a secret
    (id_rsa, *.key and the like), so the file tools never take automatically what the sandbox keeps from a run."""
    return any(p.startswith(".") or secret_name(p) for p in parts)


class DiskError(ValueError):
    """A failure that reveals something about what is on disk (a symlink, a file where a directory was expected)."""


NO_HARD_LINKS = {errno.EPERM, errno.EOPNOTSUPP, errno.ENOTSUP, errno.ENOSYS}


class StaleApproval(ValueError):
    """The target no longer matches the approved snapshot."""


_UNCHECKED = object()


class Workdir:
    """Every operation walks the path one component at a time with O_NOFOLLOW,
    relative to a directory fd for the working directory."""

    def __init__(self, root):
        self.root = os.path.abspath(root)

    def _open_dir(self, parts, create=False):
        fd = os.open(self.root, os.O_RDONLY | os.O_DIRECTORY)
        try:
            for p in parts:
                try:
                    nfd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                except FileNotFoundError:
                    if not create:
                        raise
                    os.mkdir(p, 0o777, dir_fd=fd)
                    nfd = os.open(p, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                except OSError as e:
                    if e.errno in (20, 40):  # ENOTDIR, ELOOP (symlink)
                        raise DiskError(f"'{p}' is a symlink or not a directory")
                    raise
                os.close(fd)
                fd = nfd
            return fd
        except BaseException:
            os.close(fd)
            raise

    def stat(self, path):
        """lstat of a confined path, or None if it doesn't exist."""
        parts = split_rel(path)
        if not parts:
            return os.stat(self.root)
        try:
            dfd = self._open_dir(parts[:-1])
        except FileNotFoundError:
            return None
        try:
            return os.stat(parts[-1], dir_fd=dfd, follow_symlinks=False)
        except FileNotFoundError:
            return None
        finally:
            os.close(dfd)

    def read(self, path, cap=READ_CAP):
        parts = split_rel(path)
        if not parts:
            raise ValueError("that is a directory")
        dfd = self._open_dir(parts[:-1])
        try:
            try:
                fd = os.open(parts[-1], os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
            except OSError as e:
                if e.errno == 40:
                    raise ValueError("symlinks are not followed")
                raise
        finally:
            os.close(dfd)
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode):
                raise ValueError("not a regular file")
            if st.st_size > cap:
                raise ValueError(f"file is {st.st_size} bytes; the limit is {cap}")
            data = f.read(cap + 1)
        return self.decode(data, cap)

    @staticmethod
    def decode(data, cap):
        if len(data) > cap:
            raise ValueError(f"file exceeds the {cap}-byte limit")
        if b"\0" in data[:8192]:
            raise ValueError("binary files are refused")
        try:
            return data.decode("utf-8")
        except UnicodeDecodeError:
            raise ValueError("binary (non UTF-8) files are refused")

    @staticmethod
    def identity(st):
        return (st.st_dev, st.st_ino, st.st_mode, st.st_uid, st.st_gid, st.st_size, st.st_mtime_ns, st.st_ctime_ns)

    @classmethod
    def _snapshot(cls, dfd, name):
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dfd)
        except FileNotFoundError:
            return None, None
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode):
                raise DiskError("the target is not a regular file")
            if st.st_size > SNAPSHOT_CAP:
                raise DiskError(f"existing file exceeds the {SNAPSHOT_CAP}-byte overwrite limit")
            identity = cls.identity(st)
            data = f.read(SNAPSHOT_CAP + 1)
            if len(data) != st.st_size or identity != cls.identity(os.fstat(f.fileno())):
                raise StaleApproval("the target changed while being read")
        return (identity, hashlib.sha256(data).digest()), data

    def snapshot(self, path):
        parts = split_rel(path)
        if not parts:
            raise ValueError("that is a directory")
        try:
            dfd = self._open_dir(parts[:-1])
        except FileNotFoundError:
            return None, None
        try:
            return self._snapshot(dfd, parts[-1])
        finally:
            os.close(dfd)

    def list(self, path):
        parts = split_rel(path) if path not in ("", ".", "./") else []
        dfd = self._open_dir(parts)
        out = []
        try:
            with os.scandir(dfd) as it:
                for e in it:
                    if len(out) == LIST_CAP:
                        return sorted(out), True
                    st = e.stat(follow_symlinks=False)
                    kind = ("dir" if stat.S_ISDIR(st.st_mode) else "file" if stat.S_ISREG(st.st_mode)
                            else "symlink" if stat.S_ISLNK(st.st_mode) else "other")
                    out.append((e.name, kind, st.st_size if kind == "file" else None))
        finally:
            os.close(dfd)
        return sorted(out), False

    def walk(self, path):
        """The regular files under a directory, as relative paths, in order. Hidden names and symlinks are skipped
        (never followed), and directories are opened one component at a time like everything else here.
        A path naming one regular file gives just that file, unless its name is hidden."""
        start = split_rel(path) if path not in ("", ".", "./") else []
        if start:
            st = self.stat(path)                       # lstat: a symlink is not a regular file, and is refused below
            if st is not None and stat.S_ISREG(st.st_mode):
                if not is_hidden(start):
                    yield "/".join(start)
                return
        stack = [(start, self._open_dir(start))]
        try:
            while stack:
                parts, fd = stack.pop()
                files = []
                try:                                   # every fd is closed before anything is yielded
                    try:
                        with os.scandir(fd) as it:
                            entries = sorted((e.name, e.stat(follow_symlinks=False).st_mode) for e in it
                                             if not e.name.startswith("."))
                    except OSError:
                        entries = []
                    subdirs = [name for name, mode in entries if stat.S_ISDIR(mode)]
                    files = [name for name, mode in entries if stat.S_ISREG(mode)]
                    for name in reversed(subdirs):
                        try:
                            sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                        except OSError:
                            continue
                        stack.append((parts + [name], sub))
                finally:
                    os.close(fd)
                for name in files:
                    yield "/".join(parts + [name])
        finally:
            for _, fd in stack:
                os.close(fd)

    def write(self, path, content, expected=_UNCHECKED):
        data = content.encode("utf-8")
        if len(data) > WRITE_CAP:
            raise ValueError(f"content is {len(data)} bytes; the limit is {WRITE_CAP}")
        parts = split_rel(path)
        if not parts:
            raise ValueError("a file name is required")
        dfd = self._open_dir(parts[:-1], create=True)
        name, stage = parts[-1], f".hoplon-tmp-{secrets.token_hex(6)}"
        try:
            try:
                st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
            except FileNotFoundError:
                st = None
            if st is not None and not stat.S_ISREG(st.st_mode):
                raise StaleApproval("the target exists and is not a regular file")
            identity = self.identity(st) if st else None
            if expected is not _UNCHECKED and identity != (expected[0] if expected else None):
                raise StaleApproval("the target changed")
            os.mkdir(stage, 0o700, dir_fd=dfd)
            try:
                self._publish(dfd, stage, name, data, st, expected)
            finally:
                os.rmdir(stage, dir_fd=dfd)
        finally:
            os.close(dfd)
        return len(data)

    @staticmethod
    def _create_new(dfd, name, data):
        """Where the filesystem has no hard links (CIFS, some FUSE mounts): create the name only if it is still
        free, then write. Never replaces a file, but another program could see it half-written."""
        try:
            fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o666, dir_fd=dfd)
        except FileExistsError as e:
            raise StaleApproval("the target now exists") from e
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())

    def _publish(self, dfd, stage, name, data, st, expected):
        staging_fd = os.open(stage, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dfd)
        try:
            directory = os.fstat(staging_fd)
            if directory.st_uid != os.getuid() or directory.st_mode & 0o077:
                raise StaleApproval("the staging directory is not private")
            fd = os.open("file", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o666,
                         dir_fd=staging_fd)
            try:
                with os.fdopen(fd, "wb") as f:
                    f.write(data)
                    f.flush()
                    if st is not None:
                        os.fchmod(f.fileno(), stat.S_IMODE(st.st_mode))
                    os.fsync(f.fileno())
                if st is None:
                    try:
                        os.link("file", name, src_dir_fd=staging_fd, dst_dir_fd=dfd)
                    except FileExistsError as e:
                        raise StaleApproval("the target now exists") from e
                    except OSError as e:
                        if e.errno not in NO_HARD_LINKS:
                            raise
                        self._create_new(dfd, name, data)
                else:
                    if expected is not _UNCHECKED:
                        try:
                            actual, _ = self._snapshot(dfd, name)
                            latest = os.stat(name, dir_fd=dfd, follow_symlinks=False)
                        except (OSError, DiskError) as e:
                            raise StaleApproval("the target changed") from e
                        if actual != expected or self.identity(latest) != expected[0]:
                            raise StaleApproval("the target changed")
                    os.rename("file", name, src_dir_fd=staging_fd, dst_dir_fd=dfd)
            finally:
                try:
                    os.unlink("file", dir_fd=staging_fd)
                except FileNotFoundError:
                    pass
        finally:
            os.close(staging_fd)


def unified_diff(old, new, path):
    d = difflib.unified_diff(old.splitlines(True), new.splitlines(True), f"a/{path}", f"b/{path}")
    return "".join(x if x.endswith("\n") else x + "\n\\ No newline at end of file\n" for x in d)


