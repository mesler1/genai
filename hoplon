BY_TOOL = {k.tool: k for k in PROPOSAL_KINDS.values() if k.tool}


CODING_REFUSED_UNDER_HOME = (".ssh", ".gnupg", ".aws", ".kube", ".docker", ".password-store", ".config/gcloud")


CODING_RISKS = {     # what --coding-anywhere exposes, by the kind of place; shown when it is used
    "home": "every file under your home directory that is not hidden (documents, downloads, every project)",
    "above": "every file under here that is not hidden: your whole home directory, and other people's and the "
             "system's files where you can read them",
    "config": "your endpoint files, every saved session and the audit log; a key file here is read like any other",
    "credentials": "the credentials kept here; only the ones hoplon recognises as secrets will still ask",
}


def coding_refusal(cwd):
    """Why coding mode is refused in this directory, as (phrase, kind of place), or None. A project directory
    under your home is fine; these are the places that hold much more than one project. Real paths, compared
    by component."""
    def inside(path, root):
        return path == root or path.startswith(root.rstrip("/") + "/")
    here = os.path.realpath(cwd)
    home = os.path.realpath(os.path.expanduser("~"))
    if here == home:
        return "your home directory", "home"
    if inside(home, here):
        return "a directory that contains your home directory", "above"
    if inside(here, os.path.realpath(config_home())):
        return "hoplon's own config directory", "config"
    for d in CODING_REFUSED_UNDER_HOME:
        if inside(here, os.path.realpath(os.path.join(home, d))):     # ~/.ssh may be a link to elsewhere
            return f"~/{d}, which holds credentials", "credentials"
    return None


UNOFFERED = {"search_files": "is only available in coding mode",
             "propose_work_plan": "is only available in a work session",
             "finish_item": "is only available in a work session",
             "retry_item": "is only for reviewing an item that used its steps",
             "propose_command": "is not available in a work session: run_in_sandbox runs commands there",
             "propose_plan": "is not available in a work session: propose_work_plan plans one",
             "suggest_skills": "is not available now: no skill is left to suggest (each one is on, or the user "
                               "declined it), or nobody is there to answer"}


class Halted(Exception):
    """The user asked the turn to stop (Engine.halt), while the model's reply was coming in."""


class Engine:
    """The loop: send, turn tool calls into proposals, collect decisions, send again."""

    def __init__(self, cfg, endpoint, session, ui, client=None, coding=None, profile=None, anywhere=False,
                 command_sets=(), offered=None):
        """coding: None, or where the request for coding mode came from ("--coding", "profile NAME").
        anywhere: the user passed --coding-anywhere, which allows coding mode where it is normally refused.
        command sets: names of the command sets to enable; one that is missing, unblessed or refused is skipped with a notice.
        offered: remote mode's {"skills": {...}, "command_sets": {...}}, what your own machine sent (remote_config): the
        only skills and command sets there are, in place of those found on this host."""
        self.cfg, self.endpoint, self.session, self.ui = cfg, endpoint, session, ui
        self.profile = profile
        self.client = client or Client(endpoint, profile.params if profile else None)
        self.audit = cfg.audit
        self.wd = Workdir(os.getcwd())
        self.fixtures = None     # this job's samples folder (Fixtures), made when first needed
        self.external = {}       # name -> tool schema registered by a wrapper
        self.counter = 0
        self.warned = False
        self.sandbox = sandbox_info()
        self.box = Sandbox(profile.sandbox, os.getcwd(), ui.notice) if profile and profile.sandbox else None
        if self.box:
            self.box.excused = cfg.not_secret
        self.notifier = None     # the notify hook, set by main() when a person is at the terminal
        self.alerts = cfg.alerts  # False: the notify hook stays quiet (:alerts); it never runs under --json
        self.commands = []       # command proposals shown in this process, newest last
        self.offered = offered
        self.skills = []
        self.skill_index = []    # [(name, description)] of every blessed skill, for the model's list
        self.queued_skills = []  # switched on mid-conversation: their text goes with the next user message
        self.declined_skills = set()     # suggestions the user said no to; the model may not ask again
        self.reload_skills()
        self.command_sets = []        # enabled command sets; never saved with the session
        self.trusted = {}        # tool name -> TrustedCommand, for the enabled command sets
        self.cached = {}         # (command set, command, params) -> (when, exit, output, note): the last real result
        self.last_run = {}       # (command set, command) -> when it last really ran
        self.runs = collections.deque()      # when each real run started, for the per-minute cap
        for name in command_sets:
            try:
                self.set_command_set(name, True)
            except HoplonError as e:
                ui.notice(f"command set '{name}' skipped: {e}")
        self.anywhere = anywhere
        self.coding_override = None     # the refused place coding mode is on in, when --coding-anywhere allowed it
        self.plan = None                # the plan the user approved, if any; never saved with the session
        self.work = None                # the work session in progress (Work), if any; never saved
        self.edits = profile.edits if profile else "ask"
        self.approved_files = set()     # files an edit or write was approved for, this process only; never saved
        self.halt = None                # set from the JSON listener's thread: "stop" the turn, or "end" the work too
        self.coding_from = "session" if session.coding else None
        refused = coding_refusal(os.getcwd()) if session.coding else None
        if refused and not anywhere:    # an override is per run: a resumed session needs the flag again
            session.coding, self.coding_from = False, None
            ui.notice(f"coding mode was on for this session, but is refused in {refused[0]}; it is off")
        if coding:
            try:
                self.set_coding(True)
                self.coding_from = coding
            except HoplonError as e:
                if not coding.startswith("profile"):
                    raise
                ui.notice(f"{coding} asks for coding mode, but {e}; it is off")
        if endpoint.model == "auto":
            self.set_model(None, "auto")

    def planner_for(self, want):
        """(Endpoint, Client) for a work session's planning, from the profile's {"endpoint", "model"}, or None to plan
        on the session's own. Raises work_refused for a planner that can't be used."""
        name, model = want["endpoint"], want["model"]
        if name and name != self.endpoint.name and self.offered is not None:
            self.ui.notice(f"the profile plans with endpoint '{name}', but in remote mode only "
                           f"'{self.endpoint.name}' can be reached: it plans too")
            return None
        try:
            ep = select_endpoint(self.cfg, name) if name and name != self.endpoint.name else self.endpoint
        except HoplonError as e:
            raise HoplonError(f"the planner endpoint: {e}", EXIT_USAGE, "work_refused") from None
        if ep is self.endpoint and (not model or model == ep.model):
            return None
        same = ep is self.endpoint
        ep = copy.copy(ep)
        try:            # on the same endpoint, the profile's sampling settings still apply
            client = Client(ep, self.profile.params if same and self.profile else None)
        except HoplonError as e:
            raise HoplonError(f"the planner endpoint: {e}", EXIT_USAGE, "work_refused") from None
        if (model and model != ep.model) or ep.model == "auto":     # checked as :model checks, or resolved
            try:
                listed = client.model_list()
            except HoplonError as e:
                raise HoplonError(f"could not check that {ep.base_url} has the planner model: {e}", EXIT_USAGE,
                                 "work_refused") from None
            hit = (listed[0] if listed else None) if not model or model == "auto" else \
                next((m for m in listed if m[0] == model), None)
            if hit is None:
                raise HoplonError(f"the planner model '{one_line(model or 'auto')[0]}' is not one {ep.base_url} lists "
                                 "(:models lists them)", EXIT_USAGE, "work_refused")
            ep.model = hit[0]
            if hit[1]:
                ep.context_limit = hit[1]
        return ep, client

    def set_model(self, name, source):
        """Use another model on the same server: one it lists now, or with name None ("model": "auto") the first.
        The destination is the same, so the conversation needs no consent to go there (see destination_id)."""
        listed = self.client.model_list()
        if not listed:
            raise HoplonError(f"{self.endpoint.base_url} lists no models hoplon can use; set 'model' in the endpoint",
                             EXIT_API, "unknown_model")
        hit = listed[0] if name is None else next((m for m in listed if m[0] == name), None)
        if hit is None:
            raise HoplonError(f"the server doesn't list a model named '{one_line(name)[0]}' (:models lists them)",
                             EXIT_USAGE, "unknown_model")
        before = self.endpoint.model
        self.endpoint.model = hit[0]
        if hit[1]:
            self.endpoint.context_limit = hit[1]
        self.session.usage = None
        self.audit.log("model", model=hit[0], before=before, source=source, context_limit=self.endpoint.context_limit)
        return hit[0]

    # -- setup

    def reload_skills(self):
        if self.offered is not None:
            self.skills = [self.offered["skills"][n] for n in self.session.skills if n in self.offered["skills"]]
            found = {n: s for n, s in self.offered["skills"].items()}
        else:
            self.skills = load_skills(self.cfg, self.session.skills, self.ui.notice)
            found = {n: s for n, s in find_skills(self.cfg).items() if skill_status(self.cfg, s) == "blessed"}
        self.skill_index = [(n, shown_description(s)) for n, s in sorted(found.items())
                            if SKILL_NAME.fullmatch(n)]
        self.blessed_skills = found

    def carried_skills(self):
        """Skills whose text the conversation itself carries: switched on after it began, so the system prompt
        stays as it was (and the server's cache with it). Pruned or summarized away, a skill is carried no more and
        the system prompt has it again."""
        return {n for m in self.session.messages if not m.get("_pruned") for n in (m.get("_skills") or {})}

    def skill_block(self, s, why):
        return (f"\n\n[skill {s.name}: {why}; its text follows]\n# Skill: {s.name}\n\n{s.text().rstrip()}\n"
                f"[end of skill {s.name}]")

    def skills_open(self):
        """Blessed skills that are off and not declined: what suggest_skills may name."""
        on = {s.name for s in self.skills}
        return [n for n, _ in self.skill_index if n not in on and n not in self.declined_skills]

    def skill_rows(self):
        found = self.offered["skills"] if self.offered is not None else None
        return skill_rows(self.cfg, [s.name for s in self.skills], found)

    def command_set_rows(self):
        found = self.offered["command_sets"] if self.offered is not None else None
        return command_set_rows(self.cfg, [p.name for p in self.command_sets], found)

    def set_coding(self, on, source=":coding"):
        if self.work and not on:
            raise HoplonError("coding mode stays on during a work session; end the session first", EXIT_USAGE,
                             "work")
        refused = coding_refusal(os.getcwd()) if on else None
        if refused and not self.anywhere:
            raise HoplonError(f"coding mode is refused in {refused[0]}; cd into a project first "
                             "(--coding-anywhere overrides this, and says what that exposes)", EXIT_USAGE)
        self.coding_override = refused[0] if refused else None
        if refused:
            self.ui.notice(f"[!] --coding-anywhere: coding mode is ON in {refused[0]}, where it is normally "
                           f"refused. Without asking you, the model can now read {CODING_RISKS[refused[1]]}. "
                           f"All of it goes to {self.endpoint.base_url}. Something the model reads can tell it "
                           "what to read next. Hidden files, files that look like secrets, and every write "
                           "still ask.")
        self.session.coding = on
        self.session.cwd = os.getcwd()
        self.coding_from = source if on else None
        self.audit.log("coding", on=on, source=source, cwd=os.getcwd(), override=self.coding_override)

    def set_skill(self, name, on, source="user", carry=True):
        """Use a skill from the next request on, or stop using it. Only a blessed skill can be turned on. Once the
        conversation has begun, a skill switched on goes with the next user message (carry), not into the system
        prompt; one switched off has its text taken out of the conversation too."""
        if on:
            s = (find_skills(self.cfg) if self.offered is None else self.offered["skills"]).get(name)
            if not s or not SKILL_NAME.fullmatch(name):
                raise HoplonError(f"skill '{shown_name(name)}' not found" if not s else
                                 f"skill '{shown_name(name)}' can't be used: its name must be {SKILL_NAME_RULE}",
                                 EXIT_USAGE, "unknown_skill")
            st = skill_status(self.cfg, s) if self.offered is None else "blessed"
            if st != "blessed":
                raise HoplonError(f"skill '{name}' is {st}; read it, then: hoplon --bless {s.path}", EXIT_USAGE,
                                 "not_blessed")
            if name not in self.session.skills:
                self.session.skills.append(name)
                if carry and self.session.messages and name not in self.queued_skills:
                    self.queued_skills.append(name)
        else:
            if name in self.session.skills:
                self.session.skills.remove(name)
            if name in self.queued_skills:
                self.queued_skills.remove(name)
            for m in self.session.messages:
                block = (m.get("_skills") or {}).pop(name, None)
                if block is not None and isinstance(m.get("content"), str):
                    m["content"] = m["content"].replace(block, f"\n\n[skill {name}: switched off by the user; "
                                                               "its text was removed]")
        self.reload_skills()
        self.session.usage = None   # the system prompt changed, so the last measured size no longer holds
        self.audit.log("skill", name=name, on=on, source=source)

    def set_command_set(self, name, on):
        """Offer a command set's scoped commands to the model and the user from the next request on, or stop. Only a
        blessed command set whose programs can be trusted is turned on."""
        if on:
            pl = (find_command_sets(self.cfg) if self.offered is None else self.offered["command_sets"]).get(name)
            if not pl:
                raise HoplonError(f"command set '{name}' not found", EXIT_USAGE, "unknown_commands")
            st = command_set_status(self.cfg, pl) if self.offered is None else "blessed"
            if st != "blessed":
                raise HoplonError(f"command set '{name}' is {st}; read it, then: hoplon --bless {pl.path}", EXIT_USAGE,
                                 "not_blessed")
            if pl.error:
                raise HoplonError(f"command set '{name}': {pl.error}", EXIT_USAGE, "bad_commands")
            clash = sorted(set(pl.tools()) & set(self.external))
            if clash:
                raise HoplonError(f"command set '{name}': a registered tool already has the name {clash[0]}", EXIT_USAGE,
                                 "bad_commands")
            if self.offered is None:
                pl.allow_auto(self.cfg.blessed().get(pl.path, {}).get("auto", []))
            missing = pl.resolve()
            if missing:
                self.ui.notice(f"command set '{name}': {', '.join(missing)} left out, as the program isn't installed here")
            self.command_sets = [p for p in self.command_sets if p.name != name] + [pl]
        else:
            self.command_sets = [p for p in self.command_sets if p.name != name]
        self.trusted = {t: c for p in self.command_sets for t, c in p.tools().items()}
        self.session.usage = None   # the tools changed, so the last measured size no longer holds
        self.audit.log("command_set", name=name, on=on)

    def register(self, tools):
        added = []
        for t in tools:
            if not isinstance(t, dict):
                raise HoplonError("each registered tool must be an object")
            name, desc, params = t.get("name"), t.get("description"), t.get("parameters", {"type": "object"})
            if not isinstance(name, str) or not re.fullmatch(r"[A-Za-z0-9_-]{1,64}", name):
                raise HoplonError(f"bad tool name {name!r}")
            if name in INTRINSICS or name in self.trusted:
                raise HoplonError(f"tool '{name}' collides with an intrinsic or command set tool")
            if not isinstance(desc, str) or not isinstance(params, dict):
                raise HoplonError(f"tool '{name}' needs a description and a parameters object")
            self.external[name] = {"type": "function",
                                   "function": {"name": name, "description": desc, "parameters": params}}
            added.append(name)
        self.audit.log("register_tools", tools=added)
        return added

    def can_run(self):
        """Is run_in_sandbox offered? Coding mode, a sandbox that works here, and someone to see what runs."""
        return bool(self.box and self.session.coding and self.ui.performs and not self.box.problem())

    def set_edits(self, mode, source=":edits"):
        """"ask": every edit and write asks. "approved-files": a further edit or write to a file you approved one for,
        in this process, applies without asking (still shown, logged and bound to the file as it was)."""
        if mode not in EDITS_MODES:
            raise HoplonError(f"edits must be one of: {', '.join(EDITS_MODES)}", EXIT_USAGE, "bad_message")
        self.edits = mode
        self.audit.log("edits", mode=mode, source=source)
        if mode == "ask" and (self.approved_files or self.work and self.work.before and self.work.before["files"]):
            # off forgets them, those a work session set aside too: on again starts from none
            self.reset_approved_files(source)
        if mode == "approved-files":
            self.ui.notice("[!] edits: approved-files: a further edit or write to a file you approved one for applies "
                           "without asking, for the rest of this session; :edits reset forgets those files")

    def reset_approved_files(self, source=":edits reset"):
        """Forget the approved files: those set aside during a work session too, so they don't come back after."""
        put_aside = self.work.before["files"] if self.work and self.work.before else set()
        self.audit.log("edits_reset", files=sorted(self.approved_files | put_aside), source=source)
        self.approved_files.clear()
        put_aside.clear()

    def edits_info(self):
        return {"mode": self.edits, "files": sorted(self.approved_files)}

    @staticmethod
    def file_key(path):
        try:
            return "/".join(split_rel(path))
        except ValueError:
            return None

    def auto_edit(self, p):
        """Would this edit or write apply without asking? Only with edits "approved-files", for a file already in the
        approved set, and never for a new file, a hidden or secret-looking one, or a whole replacement."""
        if self.edits != "approved-files" or p.kind not in ("edit", "write") or not self.ui.performs:
            return False
        key = self.file_key(p.fields.get("path"))
        if key is None or key not in self.approved_files or is_hidden(key.split("/")):
            return False
        f = p.fields
        if p.kind == "write" and (not f.get("exists") or f.get("undiffable")):
            return False
        new = f.get("_content") if p.kind == "edit" else f.get("content")
        try:
            old = self.wd.read(f["path"])
        except (ValueError, OSError):
            return False
        excused = self.cfg.not_secret()
        return not any(self.secret_text(t, excused) for t in (old, new or ""))

    def work_edit(self, p):
        """Does this edit or write apply without asking, in a work session? Yes, in the copy, while an item of the
        approved plan is being worked on or the planner reviews it (both are held to the steps and the time limit),
        unless the file is hidden, or it or the new content looks secret. Before the plan is approved, every edit asks. So does a pyvenv.cfg, or anything
        under a directory of that name, which would change what the sandbox's secret scan looks at. In a work
        session these rules are the only ones: edits "approved-files" doesn't apply in the copy."""
        w = self.work
        if not w or not self.ui.performs or not w.items or not w.current or w.role not in ("item", "review"):
            return False
        key = self.file_key(p.fields.get("path"))
        if (key is None or is_hidden(key.split("/")) or p.fields.get("undiffable")
                or "pyvenv.cfg" in key.split("/")):
            return False
        new = p.fields.get("_content") if p.kind == "edit" else p.fields.get("content")
        texts = [new or ""]
        if p.kind == "edit" or p.fields.get("exists"):
            try:
                texts.append(self.wd.read(p.fields["path"]))
            except (ValueError, OSError):
                return False
        excused = self.cfg.not_secret()
        return not any(self.secret_text(t, excused) for t in texts)

    # -- work sessions

    def start_work(self, task, steps=None, seconds=None, source=":work"):
        """Start a work session on a copy of the project, and send the task. Returns how the turn ended."""
        if self.work:
            raise HoplonError(f"a work session is already on ({self.work.tree.branch}); end it first", EXIT_USAGE,
                             "work_refused")
        if not self.ui.performs:
            raise HoplonError("a work session needs someone to approve its plan: the REPL or hoplon-tui", EXIT_USAGE,
                             "work_refused")
        if not self.box:
            raise HoplonError("a work session needs a profile with a 'sandbox', to build and test in", EXIT_USAGE,
                             "work_refused")
        if self.box.network:
            raise HoplonError("the sandbox's network is on: turn it off first, so the work runs offline", EXIT_USAGE,
                             "work_refused")
        if not isinstance(task, str) or not task.strip():
            raise HoplonError("a work session needs a task", EXIT_USAGE, "bad_message")
        work = self.profile.work if self.profile and self.profile.work else \
            {"test": None, "steps_per_item": WORK_STEPS, "time_limit": WORK_TIME, "planner": None}
        steps, seconds = work_limits(steps, seconds, "work")
        planner = self.planner_for(work["planner"]) if work["planner"] else None
        problem = self.box.problem()
        if problem:
            raise HoplonError(f"the sandbox can't run here: {problem}", EXIT_USAGE, "work_refused")
        before = {"coding": (self.session.coding, self.coding_from, self.coding_override),
                  "files": set(self.approved_files), "messages": None, "queue": None}
        # a deep copy: pruning old tool output during the session rewrites the messages themselves
        self.session.held = {"coding": self.session.coding, "messages": copy.deepcopy(self.session.messages)}
        try:
            if not self.session.coding:
                try:
                    self.set_coding(True, source)
                except HoplonError as e:
                    raise HoplonError(str(e), EXIT_USAGE, "work_refused") from None
                self.ui.coding(True, source, self.coding_override)
            tree, untracked = Copy.create(os.getcwd())
            self.work = Work(tree, task.strip(), steps or work["steps_per_item"],
                             seconds or work["time_limit"], work["test"], self.wd)
        except BaseException:
            self.session.held = None
            self.put_back_coding(before)
            raise
        self.work.planner_ep = planner
        self.work.before = before
        self.approved_files.clear()     # approvals are for files in the project, not the copy; they come back after
        self.ui.edits(self.edits_info())
        if planner:     # the planner is elsewhere: it starts from the task alone, not the conversation so far,
            before["messages"] = self.session.messages      # and attachments queued for that wait for it
            self.session.messages, self.session.usage = [], None
            if getattr(self.ui, "queue", None):
                before["queue"], self.ui.queue = self.ui.queue, []
        self.clear_plan()
        self.wd = Workdir(tree.wd)
        self.box.root = os.path.realpath(tree.wd)
        self.audit.log("work_start", branch=tree.branch, base=tree.base, path=tree.path, steps=self.work.steps,
                       planner=({"name": planner[0].name, "base_url": planner[0].base_url, "model": planner[0].model}
                                if planner else None),
                       seconds=self.work.seconds, source=source,
                       **(command_fingerprint(self.work.test) if self.work.test else {}))
        self.ui.work({"state": "started", **self.work.info()})
        if untracked:
            self.ui.notice(f"{untracked} untracked file{'s are' if untracked != 1 else ' is'} not in the copy: "
                           "the work starts from your last commit")
        return self.user_turn(f"Work session. The task:\n\n{self.work.task}")

    def put_back_coding(self, before):
        """Coding mode as it was before a work session (it turns it on for the session), and say so."""
        on, frm, override = before["coding"]
        if on == self.session.coding:
            return
        self.session.coding, self.coding_from, self.coding_override = on, frm, override
        self.session.save()
        self.ui.coding(on, frm, override)

    def end_work(self, why="ended"):
        """End the work session: commit what is left (each commit is on the branch in the project as soon as it is
        made), remove the copy, and go back to the project. If git fails at any point, or a file the model wrote
        would be lost (git ignores it), the copy stays, and the user is told where it is. Returns what happened, for
        the user."""
        w = self.work
        if not w:
            raise HoplonError("no work session is on", EXIT_USAGE, "not_running")
        return self._end_work(w, why)

    def _end_work(self, w, why):
        left, problems, commits, stat = None, [], [], ""
        try:
            left = w.tree.commit("Unfinished work, left when the session ended")
        except HoplonError as e:
            problems.append(f"what was left could not be committed: {e}")
        try:
            lost = w.tree.missing(w.written)
            if lost:
                problems.append(f"{len(lost)} file{'s' if len(lost) != 1 else ''} the model wrote "
                                f"{'are' if len(lost) != 1 else 'is'} not in its commits (git ignores "
                                f"{'them' if len(lost) != 1 else 'it'}, or a submodule holds the directory): "
                                + ", ".join(lost[:5]) + (" …" if len(lost) > 5 else ""))
        except HoplonError as e:
            problems.append(f"could not check that the files the model wrote were committed: {e}")
        try:
            commits, stat = w.tree.summary()
        except HoplonError as e:
            problems.append(f"the commits could not be read: {e}")
            stat = f"(could not read the commits: {e})"
        published = True
        try:
            w.tree.publish()                # what is committed goes to the branch, whatever else went wrong
        except HoplonError as e:
            published = False
            problems.append(f"the branch could not be updated: {e}")
        keep = published and w.tree.published != w.tree.base     # the branch has all the session's commits
        removed = False
        if not problems:            # before anything is said: if the front end has gone, saying it fails
            try:
                w.tree.remove()
                removed = True
            except HoplonError as e:
                problems.append(f"the copy could not be removed: {e}")
        if not removed:
            w.tree.keep()
        self.audit.log("work_end", why=why, branch=w.tree.branch, kept=keep, commits=len(commits), unfinished=left,
                       removed=removed, problems=problems)
        self.work, self.wd = None, w.home
        self.box.root = os.path.realpath(w.home.root)
        fx = getattr(self, "fixtures", None)
        if fx and fx.used_in_work:
            try:
                fx.clear()
                self.audit.log("fixtures_clear", dir=fx.dir, source="work_end")
            except OSError as e:
                self.ui.notice(f"the samples folder {fx.dir} could not be removed: {e}")
        self.session.held = None
        if w.before:
            self.approved_files.clear()
            self.approved_files.update(w.before["files"])
            if w.before["messages"] is not None:
                self.session.messages, self.session.usage = w.before["messages"], None
            if w.before["queue"]:
                self.ui.queue = w.before["queue"] + self.ui.queue
            self.put_back_coding(w.before)
        self.session.save()
        if not removed:
            self.ui.notice(f"[!] {'; '.join(problems)}. The copy is still at {w.tree.path}"
                           + (f", and its commits are on the branch {w.tree.branch}" if keep else ""))
        elif problems:
            self.ui.notice(f"[!] {'; '.join(problems)}")
        base = w.tree.base[:12]
        commands = [f"git log --stat {base}..{w.tree.branch}", f"git diff {base} {w.tree.branch}",
                    f"git merge {w.tree.branch}", f"git branch -D {w.tree.branch}"] if keep else []
        info = {"state": "ended", "why": why, "branch": w.tree.branch if keep else None, "base": base,
                "commits": commits, "stat": stat, "unfinished": left, "removed": removed, "commands": commands,
                "items": w.items, "path": None if removed else w.tree.path, "problems": problems}
        self.ui.work(info)
        self.ui.edits(self.edits_info())
        return info

    def leave_work(self):
        """hoplon is exiting: end a work session still on, so its work is committed to its branch."""
        if self.work:
            try:
                self.end_work("hoplon exited")
            except Exception:       # exiting anyway; the branch and the copy are still there to look at
                pass

    # -- a work session's contexts

    def swap_context(self, role, text, why, renew=True):
        """Send a different context from the next step on: a fresh one for the current item (text: a hint), or the
        planner's, to review a stuck item (text: the report). The planner's context is kept, its bulk dropped."""
        w = self.work
        before = len(self.session.messages)
        if w.role in ("plan", "review"):
            w.planner = self.session.messages
            prune_bulk(w.planner, len(w.planner))
        msg = {"role": "user", "content": item_brief(w, text) if role == "item" else text}
        self.session.messages = ([] if role == "item" else list(w.planner or [])) + [msg]
        self.session.history.append(dict(msg))
        self.session.usage = None
        w.role, w.cleared_at = role, 0
        if role == "item" and renew:    # a context that filled up goes on with the steps it has left
            w.used = 0
        self.audit.log("work_context", role=role, item=w.current, why=why, dropped=before, tokens=self.used())
        self.ui.work({"state": "context", "role": role, "item": w.current, "why": why})

    def review_item(self):
        """The current item used its steps: give it to the planner, with what it changed and its last words."""
        w = self.work
        n = w.current
        w.reviewed.add(n)
        w.used = 0
        try:
            changed = w.tree.git(["status", "--short", "--untracked-files=all"])[1].strip()
        except HoplonError as e:
            changed = f"(could not tell: {e})"
        last = next((m.get("content") for m in reversed(self.session.messages)
                     if m.get("role") == "assistant" and (m.get("content") or "").strip()), "")
        report = (f"Item {n} ({w.items[n - 1]['title']}) used its budget of {w.steps} model steps without being "
                  f"finished. You planned this session: decide what happens next.\n\n"
                  f"Files changed since the last finished item:\n{changed or '(none)'}\n\n"
                  f"The last thing the attempt said:\n{clip(last.strip()) if last.strip() else '(nothing)'}\n\n"
                  "Choose one. If the item does what it says, call finish_item: the test runs and it is committed. "
                  "If not, call retry_item with a hint, and a fresh attempt starts (the changes so far stay). If the "
                  "plan is wrong, propose a new one with propose_work_plan. If you need the user, reply in plain text "
                  "and the session waits for them.")
        self.swap_context("review", report, "the item used its steps")

    def work_context(self):
        """Keep a work session's context small, before each step: drop old file contents and output once it is
        WORK_CLEAR_FRACTION full; if one item still fills it, start the item again in a fresh context, with notes."""
        w = self.work
        limit = self.active()[0].context_limit
        used = self.used()
        if used < WORK_CLEAR_FRACTION * limit or used < w.cleared_at + WORK_CLEAR_AGAIN * limit:
            return
        msgs = self.session.messages
        results = [i for i, m in enumerate(msgs) if m.get("role") == "tool"]
        n = prune_bulk(msgs, results[-WORK_KEEP_OUTPUTS]) if len(results) > WORK_KEEP_OUTPUTS else 0
        if n:
            self.session.usage = None
            after = self.used()
            self.audit.log("work_clear", item=w.current, role=w.role, pruned=n, before=used, after=after)
            used = after
        w.cleared_at = used
        if used >= WARN_FRACTION * limit and w.role == "item":
            self.session.messages = msgs + [{"role": "user", "content":
                "Your context is nearly full, so this item goes on in a fresh one. Write notes for it: what is done, "
                "what is left, and what you found out (files, names, commands). Plain text only."}]
            try:
                notes = (self.send(max_tokens=SUMMARY_WORDS * 3, tools=False).get("content") or "").strip()
            except HoplonError as e:
                notes = f"(none: asking for them failed: {e})"
            finally:
                self.session.messages = msgs
            self.swap_context("item", "Your previous attempt at this item filled its context, so this is a fresh "
                              "one. Its notes:\n" + (notes or "(none)"), "the context was full", renew=False)

    def set_network(self, on, source=":network"):
        if not self.box:
            raise HoplonError("there is no sandbox: the profile has no 'sandbox'", EXIT_USAGE, "no_sandbox")
        if on and self.work:
            raise HoplonError("the network stays off during a work session, whose tests run without asking; end the "
                             "session first", EXIT_USAGE, "work")
        self.box.network = on
        self.audit.log("network", on=on, source=source)
        if on:
            self.ui.notice("[!] the sandbox's network is ON for this session: code running there could send your "
                           "project anywhere, so each sandboxed command now asks first")

    def can_search(self):
        return self.read_allowed([])

    def trusted_tools(self):
        """The scoped commands on offer: only where someone can see what runs, as with run_in_sandbox."""
        return dict(self.trusted) if self.ui.performs else {}

    def tools(self):
        host = socket.gethostname()
        if self.work:       # the copy only: nothing for the real system, and the work session's own plan
            return ([t for t in TOOLS if t["function"]["name"] not in ("propose_command", "propose_plan")]
                    + [SEARCH_TOOL, RUN_TOOL, WORK_PLAN_TOOL, FINISH_TOOL]
                    + ([RETRY_TOOL] if self.work.role == "review" else []))
        return (TOOLS + ([SEARCH_TOOL] if self.can_search() else [])
                + ([RUN_TOOL, SAMPLES_TOOL] if self.can_run() else [])
                + ([SKILLS_TOOL] if self.can_suggest_skills() else [])
                + [c.schema(host) for c in self.trusted_tools().values()]
                + list(self.external.values()))

    def can_suggest_skills(self, index_only=False):
        """Someone is there to answer, outside a work session, and there are blessed skills to list (index_only)
        or ones left to suggest."""
        if not self.ui.performs or self.work or not self.skill_index:
            return False
        return index_only or bool(self.skills_open())

    def where(self):
        """The system prompt's "Where things are": what the model's tools reach, as it is now."""
        if self.work:
            runs = WHERE_RUNS.replace("{what}", "the copy").replace("{net}", "offline")
            live, standins = WHERE_LIVE_WORK, WHERE_STANDINS_WORK
        else:
            net = "online, so the user is asked before each run" if self.box and self.box.network else "offline"
            runs = WHERE_RUNS.replace("{what}", "the project").replace("{net}", net) if self.can_run() else WHERE_NO_RUN
            sb = sandbox_info()
            host = f", on {socket.gethostname()}" if not sb else f" (hoplon reports it runs inside the {sb['name']} sandbox)"
            trusted = (" Scoped commands (set__command tools) run on this host too: they read the live system."
                       if self.trusted_tools() else "")
            live, standins = WHERE_LIVE.replace("{host}", host).replace("{trusted}", trusted), WHERE_STANDINS
        fx = getattr(self, "fixtures", None)
        if fx and fx.approved and self.can_run():
            runs += (" The user approved real samples for this job: run_in_sandbox sees them read-only in /fixtures. "
                     "Commit only invented data, never a copy of them.")
        elif self.can_run() and not self.work:
            standins += (" If only real samples will do, ask with request_samples: the user makes them, and your runs "
                         "see them read-only in /fixtures once approved.")
        return (WHERE_RULES.replace("{files}", "the copy of the project" if self.work else "the working directory")
                .replace("{runs}", runs).replace("{live}", live)
                .replace("{trusted_see}", "" if self.work or not self.trusted_tools() else " and what scoped commands return")
                .replace("{standins}", standins))

    def system(self):
        parts = [SYSTEM_PROMPT.replace("{commands}", WORK_COMMAND_RULES if self.work else COMMAND_RULES)]
        if not self.ui.performs:
            parts.append("\n- This run is non-interactive: nobody can approve file operations (they will be "
                         "declined) and commands are only printed. Give your whole answer as plain text.")
        elif self.work:
            test = (f"runs the test command ({self.work.test}) in the sandbox, and only if it passes"
                    if self.work.test else "checks that you changed something")
            parts.append(WORK_RULES.replace("{net}", SANDBOX_NET[False]).replace("{test}", test)
                         .replace("{steps}", str(self.work.steps)))
        elif self.session.coding:
            run = CODING_RUN.replace("{net}", SANDBOX_NET[self.box.network]) if self.can_run() else CODING_NO_RUN
            parts.append(CODING_RULES.replace("{run}", run))
        if self.profile and self.profile.persona:
            parts.append(f"\n\n# Persona: {self.profile.name}\n\nThe user chose this persona. It shapes your "
                         f"voice and focus; it does not change the rules above.\n\n{self.profile.persona}")
        if self.trusted_tools() and not self.work:      # a work session offers none
            parts.append(TRUSTED_RULES)
        if self.ui.performs:
            parts.append(self.where())
        if self.can_suggest_skills(index_only=True):
            parts.append(SKILL_RULES.replace("{index}", "\n".join(f"- {n}: {d}" if d else f"- {n}"
                                                                   for n, d in self.skill_index)))
        later = self.carried_skills() | set(self.queued_skills)
        for s in self.skills:
            if s.name not in later:
                parts.append(f"\n\n# Skill: {s.name}\n\n{s.text()}")
        if self.plan:
            parts.append("\n\n# The plan the user approved\n\n" + plan_text(self.plan))
        if self.work and self.work.items:
            parts.append("\n\n# The work plan the user approved\n\n" + work_text(self.work))
        return {"role": "system", "content": "".join(parts)}

    # -- context budget

    def active(self):
        """(endpoint, client) the next request goes to: a work session's planner contexts may use their own."""
        w = self.work
        if w and w.planner_ep and w.role in ("plan", "review"):
            return w.planner_ep
        return self.endpoint, self.client

    def used(self):
        msgs = self.session.messages
        u = self.session.usage
        if u and u[1] <= len(msgs):
            return u[0] + estimate_tokens(msgs[u[1]:])
        return estimate_tokens([self.system()] + msgs) + estimate_tokens(self.tools())

    def check_budget(self):
        used, limit = self.used(), self.active()[0].context_limit
        self.ui.context(used, limit)
        if used >= limit:
            raise HoplonError(f"the conversation is at the context limit ({used}/{limit} tokens). "
                             "Nothing was sent. Compact it (:compact), then send again.", EXIT_CONTEXT, "context_full")
        if used >= WARN_FRACTION * limit and not self.warned:
            self.warned = True
            self.ui.notice(f"context is {100 * used // limit}% full ({used}/{limit} tokens); consider :compact")

    # -- sending

    def send(self, max_tokens=None, tools=True):
        msgs = [self.system()] + wire(self.session.messages)

        def text(chunk):
            if self.halt:
                raise Halted
            if chunk:
                self.ui.text(chunk)
        def progress(report):
            if self.halt:
                raise Halted
            self.ui.progress(report)
        client = self.active()[1]
        msg, usage = client.chat(msgs, self.tools() if tools else None, text, max_tokens, progress)
        self.ui.text_end()
        if client.generated:
            self.ui.generated(client.generated)
        if usage and usage.get("total_tokens"):
            self.session.usage = (int(usage["total_tokens"]), len(self.session.messages) + 1)
        return msg

    def user_turn(self, text, attachments=()):
        if self.work:
            self.work.fresh(renew=True)
        content = text
        for n, (label, body) in enumerate(attachments, 1):
            content += shared_block(n, label, body)
        content = content.lstrip("\n")         # only shared output, as :run and :sh send
        msg = {"role": "user", "content": content}
        if attachments:
            msg["_bulk"] = True
        carry = {}
        for s in self.skills:
            if s.name in self.queued_skills:
                carry[s.name] = self.skill_block(s, "switched on by the user")
        if carry:
            msg["content"] += "".join(carry.values())
            msg["_skills"] = carry
        self.session.add(msg)
        try:
            self.check_budget()
        except HoplonError:
            self.session.drop_last()
            raise
        self.queued_skills = [n for n in self.queued_skills if n not in carry]
        try:
            ended = self.loop(checked=True)
            if self.work and self.work.done() and ended == "reply":
                self.end_work("done")
            if ended != "command":      # a proposed command has already said so
                self.notify("reply")    # the turn is over: hoplon now waits for the person
            return ended
        finally:
            self.session.save()

    def halted(self):
        """The user asked the turn to stop: say so, and end it."""
        self.audit.log("halt", why=self.halt, item=self.work.current if self.work else None)
        self.ui.notice("stopped; " + ("the work session pauses: send a message to go on, or end it"
                                      if self.work and self.halt == "stop" else "send a message to continue"))
        return "stopped"

    def loop(self, checked=False):
        step = 0
        while True:
            if self.halt:
                return self.halted()
            if self.work and self.work.stuck():
                self.review_item()
            if self.work:
                why = self.work.limit()
                if why:
                    self.audit.log("work_pause", reason=why, item=self.work.current)
                    self.ui.notice(f"work session paused: {why}. Send a message to go on with a fresh budget, "
                                   "or end the session")
                    return "work_limit"
            elif step >= self.cfg.max_steps:
                self.ui.notice(f"{step} steps in a row ran without you deciding anything (max_steps in "
                               "config.json); send a message to continue")
                return "step_limit"
            if self.work:
                try:
                    self.work_context()
                except Halted:          # stopped while the model wrote notes for a fresh context
                    self.ui.text_end()
                    return self.halted()
            if step or not checked:
                self.check_budget()
            step += 1
            if self.work:
                self.work.used += 1
            try:
                msg = self.send()
            except Halted:
                self.ui.text_end()
                return self.halted()
            if self.halt:               # it came as the reply ended: nothing in it is shown or done
                return self.halted()
            self.session.add(msg)
            self.session.save()
            calls = msg.get("tool_calls")
            if not calls:
                return "reply"
            props = [self.make_proposal(tc) for tc in calls]
            self.decide(props)
            if any(not p.auto and not p.error for p in props):
                step = 0                # you decided something: you are the brake, so the count starts again
            ended = stopped = False
            moved = None        # a plan, finish or retry that took effect: what follows it was decided for before
            for p in props:
                stopped = stopped or bool(self.halt)
                if stopped or moved:
                    result = ("not run: the user stopped an earlier command" if stopped else
                              f"not run: it came after {moved} in the same reply, and the work session has moved on "
                              "since; call it again if it is still needed")
                    if not p.error:
                        self.ui.result(p, "stopped" if stopped else "skipped", result)
                else:
                    mark = (self.work.current, self.work.swap, len(self.work.reports)) if self.work else None
                    result = self.perform(p)
                    if (mark and self.work and p.kind in ("work_plan", "finish", "retry") and not p.error
                            and mark != (self.work.current, self.work.swap, len(self.work.reports))):
                        moved = PROPOSAL_KINDS[p.kind].tool
                tool_msg = {"role": "tool", "tool_call_id": p.call_id, "content": result}
                if getattr(p, "carry", None):
                    tool_msg["_skills"] = p.carry
                kind = PROPOSAL_KINDS.get(p.kind)
                if kind and kind.bulk and p.decision == "accept":
                    tool_msg["_bulk"] = True
                self.session.add(tool_msg)
                if kind and kind.shown and not p.error:
                    ended = True
                stopped = stopped or p.stopped
            if self.work and self.work.swap:
                role, hint, why = self.work.swap
                self.work.swap = None
                self.swap_context(role, hint, why)
            self.session.save()
            if stopped and self.halt:
                return self.halted()
            if stopped:
                self.ui.notice("stopped; send a message to continue")
                return "stopped"
            if ended:
                return "command"

    # -- proposals

    def make_proposal(self, tc):
        self.counter += 1
        pid = f"p{self.counter}"
        name = tc["function"]["name"]
        try:
            args = json.loads(tc["function"].get("arguments") or "{}")
            if not isinstance(args, dict):
                raise ValueError
        except ValueError:
            p = Proposal(pid, "invalid", tc["id"], tool=name)
            p.error = "arguments were not a JSON object"
            return p
        reason = str(args.get("reason", ""))
        try:
            kind = BY_TOOL.get(name) or (PROPOSAL_KINDS["external"] if name in self.external else
                                         PROPOSAL_KINDS["trusted"] if name in self.trusted_tools() else None)
            if kind is None:
                raise ValueError(f"unknown tool '{name}'")
            if name not in {t["function"]["name"] for t in self.tools()}:     # a tool not offered at this point
                raise ValueError(f"{name} {UNOFFERED.get(name, 'is not available now')}")
            return getattr(Engine, kind.build)(self, pid, tc["id"], args, reason, name)
        except (ValueError, OSError) as e:
            p = Proposal(pid, "invalid", tc["id"], tool=name)
            p.error = str(e)
            if isinstance(e, (DiskError, OSError)):
                try:
                    parts = split_rel(args.get("path", "."))
                except ValueError:
                    parts = [".hidden"]
                if not self.read_allowed(parts):    # on-disk facts are for the user, not the model
                    p.error = f"{name} of {show_exact(str(args.get('path')))} failed, and the model was only told " \
                              f"it was declined: {e}"
                    p.reply = "declined by the user"
            return p

    # Builders: one per kind (PROPOSAL_KINDS). Each turns a call's arguments into a proposal, deciding whether it
    # is automatic, or raises ValueError (or OSError) for a call that is not valid.

    def build_command(self, pid, call_id, args, reason, name):
        cmd = args.get("command")
        if not isinstance(cmd, str) or not cmd.strip():
            raise ValueError("command is required")
        p = Proposal(pid, "command", call_id, command=cmd, reason=reason)
        self.commands.append(p)
        return p

    def build_samples(self, pid, call_id, args, reason, name):
        what, files, suggest = args.get("what"), args.get("files"), args.get("suggest")
        if self.work or not self.can_run():
            raise ValueError("request_samples is not available now")
        if not isinstance(what, str) or not what.strip():
            raise ValueError("what is required")
        if not isinstance(files, list) or not files or not all(isinstance(f, str) and f.strip() for f in files):
            raise ValueError("files must list the file names your tests will read")
        if suggest is not None and not isinstance(suggest, str):
            raise ValueError("suggest must be a command, as text")
        fx = self.fixtures_store()
        return Proposal(pid, "samples", call_id, what=what, files=files[:20], suggest=suggest or "", reason=reason,
                        folder=fx.dir)

    def build_skills(self, pid, call_id, args, reason, name):
        names = args.get("names")
        if not self.can_suggest_skills(index_only=True):
            raise ValueError("suggest_skills is not available now")
        if not isinstance(names, list) or not names or not all(isinstance(n, str) for n in names):
            raise ValueError("names must list skills from 'Skills you can suggest'")
        names = list(dict.fromkeys(names))
        if len(names) > SKILL_SUGGEST_MAX:
            raise ValueError(f"suggest at most {SKILL_SUGGEST_MAX} skills at a time")
        on, index = {s.name for s in self.skills}, dict(self.skill_index)
        for n in names:
            if n not in index:
                raise ValueError(f"'{one_line(n)[0][:40]}' is not in the list of skills you can suggest")
            if n in on:
                raise ValueError(f"skill {n} is on already")
            if n in self.declined_skills:
                raise ValueError(f"the user declined skill {n}; don't suggest it again unless they ask")
        return Proposal(pid, "skills", call_id, names=names, about=[index[n] for n in names], reason=reason)

    def build_sandbox(self, pid, call_id, args, reason, name):
        cmd = args.get("command")
        if not self.can_run():
            raise ValueError("run_in_sandbox is not available now")
        if not isinstance(cmd, str) or not cmd.strip():
            raise ValueError("command is required")
        p = Proposal(pid, "sandbox", call_id, command=cmd, reason=reason, network=self.box.network,
                     image=self.box.conf["image"])
        p.auto = not self.box.network
        return p

    def build_read(self, pid, call_id, args, reason, name):
        """read_file and list_dir."""
        path = args.get("path", ".")
        parts = split_rel(path) if not (name == "list_dir" and path in (".", "./", "")) else []
        kind = "read" if name == "read_file" else "list"
        p = Proposal(pid, kind, call_id, path=path, reason=reason)
        if kind == "read":
            st = self.wd.stat(path)
            p.fields["size"] = st.st_size if st else None
        if self.read_allowed(parts):
            if kind == "read":
                self.prepare_auto_read(p)
            else:
                p.auto = True
        elif kind == "read" and any(secret_name(x) for x in parts):    # named like one: warned as content would be
            p.fields["secret"] = True
            p.fields["to"] = to = self.active()[0].base_url
            self.ui.notice(f"{path} is named like a file that holds secrets, so reading it needs your OK; allowing "
                           f"sends it to {to}")
        return p

    def no_git(self, path):
        """In a work session, the copy's .git is hoplon's alone: no file tool may write it."""
        if getattr(self, "work", None) and ".git" in split_rel(path):
            raise ValueError("in a work session, nothing under .git can be written: hoplon keeps the copy's git")

    def build_write(self, pid, call_id, args, reason, name):
        path, content = args.get("path"), args.get("content")
        split_rel(path)
        Engine.no_git(self, path)
        if not isinstance(content, str):
            raise ValueError("content must be a string")
        state, previous = self.wd.snapshot(path)
        exists = state is not None
        fields = {"path": path, "exists": exists, "content": content, "reason": reason, "_state": state,
                  "lines": content.count("\n") + (0 if content.endswith("\n") or not content else 1)}
        if exists:
            try:
                fields["diff"] = unified_diff(self.wd.decode(previous, WRITE_CAP), content, path)
            except ValueError as e:
                fields.update(diff=f"(cannot diff the existing file: {e})", undiffable=str(e),
                              mode=f"{stat.S_IMODE(state[0][2]):04o}")
        return Proposal(pid, "write", call_id, **fields)

    def build_edit(self, pid, call_id, args, reason, name):
        path, old, new = args.get("path"), args.get("old_text"), args.get("new_text")
        if not isinstance(old, str) or not isinstance(new, str) or not old:
            raise ValueError("old_text and new_text are required")
        parts = split_rel(path)
        Engine.no_git(self, path)
        try:
            state, previous = self.wd.snapshot(path)
            if state is None:
                raise FileNotFoundError(f"{path} does not exist")
            current = self.wd.decode(previous, WRITE_CAP)
            n = current.count(old)
            if n != 1:
                raise ValueError(f"old_text appears {n} times in {path}; it must appear exactly once")
        except (ValueError, OSError) as e:
            if self.read_allowed(parts):
                raise
            # The model may not learn anything about this file, so it only hears "declined".
            p = Proposal(pid, "invalid", call_id, tool=name)
            p.error = f"edit of {show_exact(path)} not applied, and the model was only told it was declined: {e}"
            p.reply = "declined by the user"
            return p
        updated = current.replace(old, new, 1)
        return Proposal(pid, "edit", call_id, path=path, diff=unified_diff(current, updated, path),
                        reason=reason, _content=updated, _state=state)

    def build_plan(self, pid, call_id, args, reason, name):
        return Proposal(pid, "plan", call_id, **parse_plan(args))

    def build_work_plan(self, pid, call_id, args, reason, name):
        if not self.work:
            raise ValueError("propose_work_plan is only available in a work session")
        goal, items = args.get("goal"), args.get("items")
        if not isinstance(goal, str) or not goal.strip():
            raise ValueError("goal is required")
        if (not isinstance(items, list) or not 1 <= len(items) <= PLAN_STEPS
                or not all(isinstance(x, str) and x.strip() for x in items)):
            raise ValueError(f"items must be a list of 1 to {PLAN_STEPS} lines of text")
        items = [plain_text(x).strip() for x in items]
        if any(len(x.splitlines()) != 1 or "\t" in x for x in items):     # any line break, U+2028 too
            raise ValueError("each item must be one line of text")
        goal = plain_text(goal).strip()
        return Proposal(pid, "work_plan", call_id, goal=goal, items=items, reason=goal)

    def build_finish(self, pid, call_id, args, reason, name):
        if not self.work:
            raise ValueError("finish_item is only available in a work session")
        if not self.work.items:
            raise ValueError("there is no approved plan yet: propose one with propose_work_plan")
        n, summary = args.get("n"), args.get("summary")
        if type(n) is not int or not isinstance(summary, str) or not summary.strip():
            raise ValueError("n (the item's number) and summary are required")
        if not self.work.current:
            raise ValueError("every item is done: reply with a short summary of the work")
        if n != self.work.current:
            raise ValueError(f"item {n} is not the current item: finish item {self.work.current} first")
        notes = args.get("notes")
        if notes is not None and not isinstance(notes, str):
            raise ValueError("notes must be text")
        summary = plain_text(summary).strip()
        if not summary:
            raise ValueError("n (the item's number) and summary are required")
        p = Proposal(pid, "finish", call_id, n=n, summary=one_line(summary)[0][:200], reason=summary,
                     test=self.work.test, notes=plain_text(notes or "").strip()[:WORK_NOTES_MAX])
        p.auto = True
        return p

    def build_retry(self, pid, call_id, args, reason, name):
        w = self.work
        if not w or w.role != "review":
            raise ValueError("retry_item is only for reviewing an item that used its steps")
        n, hint = args.get("n"), args.get("hint")
        if type(n) is not int or not isinstance(hint, str) or not hint.strip():
            raise ValueError("n (the item's number) and hint are required")
        if n != w.current:
            raise ValueError(f"item {n} is not the one under review: that is item {w.current}")
        p = Proposal(pid, "retry", call_id, n=n, hint=plain_text(hint).strip()[:WORK_NOTES_MAX], reason=hint)
        p.auto = True
        return p

    def build_external(self, pid, call_id, args, reason, name):
        return Proposal(pid, "external", call_id, tool=name, args=args)

    def build_trusted(self, pid, call_id, args, reason, name):
        cmd = self.trusted[name]
        values = cmd.check(args)
        p = Proposal(pid, "trusted", call_id, set=cmd.set, command=cmd.name, params=values,
                     argv=cmd.shown(values), access=cmd.access, reason=cmd.describe, _cmd=cmd)
        p.auto = cmd.auto
        return p

    def search_proposal(self, pid, call_id, args, reason, name="search_files"):
        if not self.can_search():
            raise ValueError("search_files is only available in coding mode")
        pattern, path, glob = args.get("pattern"), args.get("path", "."), args.get("glob")
        if not isinstance(pattern, str) or not pattern or "\n" in pattern or len(pattern) > 200:
            raise ValueError("pattern must be one line of text, at most 200 characters")
        if not isinstance(path, str) or (glob is not None and (not isinstance(glob, str) or len(glob) > 100)):
            raise ValueError("path and glob must be strings")
        parts = split_rel(path) if path not in ("", ".", "./") else []
        if is_hidden(parts):
            raise ValueError("hidden directories are not searched")
        fields = {"path": path or ".", "pattern": pattern, "reason": reason}
        if glob:
            fields["glob"] = glob
        if args.get("ignore_case") is True:
            fields["ignore_case"] = True
        p = Proposal(pid, "search", call_id, **fields)
        p.auto = True
        return p

    def search(self, p):
        """Run an automatic search_files: (what the model gets, a note for the user)."""
        f = p.fields
        fold = (lambda t: t.casefold()) if f.get("ignore_case") else (lambda t: t)
        needle, excused = fold(f["pattern"]), self.cfg.not_secret()
        hits, files, skipped, stopped = [], 0, {}, None
        deadline = time.monotonic() + SEARCH_SECONDS
        for rel in self.wd.walk(f["path"]):
            if f.get("glob") and not fnmatch.fnmatchcase(rel.rsplit("/", 1)[-1], f["glob"]):
                continue
            if files == SEARCH_FILES:
                stopped = f"after {SEARCH_FILES} files"
                break
            if time.monotonic() > deadline:
                stopped = f"after {SEARCH_SECONDS} seconds"
                break
            files += 1
            try:
                text = self.wd.read(rel)
            except (ValueError, OSError):
                skipped["binary, large or unreadable"] = skipped.get("binary, large or unreadable", 0) + 1
                continue
            if needle not in fold(text):
                continue
            if self.secret_text(text, excused):
                skipped["looking like secrets"] = skipped.get("looking like secrets", 0) + 1
                continue
            for n, line in enumerate(text.split("\n"), 1):
                at = fold(line).find(needle)
                if at >= 0:
                    start = max(0, min(at - SEARCH_LINE // 4, len(line) - SEARCH_LINE))     # the match stays in view
                    hits.append(f"{rel}:{n}: {'…' if start else ''}{line[start:start + SEARCH_LINE]}"
                                f"{'…' if start + SEARCH_LINE < len(line) else ''}")
                    if len(hits) == SEARCH_MATCHES:
                        stopped = f"at {SEARCH_MATCHES} matches"
                        break
            if stopped:
                break
        out, counts = redact("\n".join(hits), self.secrets())
        tail = [f"(stopped {stopped}; narrow it with path or glob)"] if stopped else []
        tail += [f"(skipped {n} file{'' if n == 1 else 's'} {why})" for why, n in sorted(skipped.items())]
        result = "\n".join(([out] if out else ["(no matches)"]) + tail)
        return result, f"{len(hits)} matches in {files} files" + (f", stopped {stopped}" if stopped else "")

    def files(self, path):
        """One directory as a file tree shows it: each entry, whether it looks like it holds secrets, and
        whether reading it would ask first. Contents are read only to classify them; none of this reaches
        the model. secret is None when hoplon would not read the file at all (too big, binary, unreadable)."""
        parts = split_rel(path) if path not in ("", ".", "./") else []
        rows = []
        entries, truncated = self.wd.list(path)
        excused = self.cfg.not_secret()
        for name, kind, size in entries:
            sub = parts + [name]
            row = {"name": name, "kind": kind, "size": size, "hidden": is_hidden(sub)}
            if kind == "file":
                try:
                    row["secret"] = self.secret_text(self.wd.read("/".join(sub)), excused)
                except (ValueError, OSError):
                    row["secret"] = None
                row["asks"] = not self.read_allowed(sub) or row["secret"] is not False
            rows.append(row)
        return rows, truncated

    def view(self, path):
        """A file for the user's viewer: read through the same checks as the model's reads, with the endpoint key
        masked. It goes to the wrapper only, never into the session. Returns (text, size, secret, redacted)."""
        text = self.wd.read(path)
        secret = self.secret_text(text)
        shown, counts = redact(text, self.secrets())
        self.audit.log("user_read", path=path, chars=len(text), secret=secret)
        return shown, len(text.encode()), secret, counts

    def prepare_auto_read(self, proposal):
        """Read the file now, so what is sent is exactly what was checked for secrets. A read that fails (a missing,
        binary or oversized file) stays automatic and reports its error: there is nothing secret to ask about."""
        path = proposal.fields["path"]
        try:
            text = self.wd.read(path)
        except (ValueError, OSError) as e:
            proposal.fields["_read_error"] = e
            proposal.auto = True
            return
        if self.secret_text(text):
            proposal.fields["secret"] = True
            proposal.fields["to"] = to = self.active()[0].base_url     # where it goes: a planner may be elsewhere
            self.ui.notice(f"{path} looks like it contains secrets, so reading it needs your OK; allowing sends it "
                           f"to {to}")
            return
        proposal.fields["_read_text"] = text
        proposal.auto = True

    def remember_not_secret(self, path, text):
        """You said this file holds no secrets: don't ask about this exact text again. Not when it holds the endpoint
        key, which always counts."""
        if any(k and k in text for k in self.secrets()):
            self.ui.notice(f"{path} holds the endpoint's key, so it will still ask")
            return
        digest = text_digest(text)
        where = os.path.join(self.wd.root, path)
        self.cfg.set_not_secret(digest, where)
        self.audit.log("not_secret", path=where, sha256=digest)
        self.ui.notice(f"{path}: you said it holds no secrets, so it won't ask again until the file changes")

    def read_allowed(self, parts):
        """Would reading this path be allowed without asking? (coding mode, not hidden)"""
        return bool(self.session.coding and not is_hidden(parts) and self.ui.performs)

    def decide(self, props):
        for p in props:
            if not p.error:
                self.match_plan(p)
        for p in props:
            p.decision = None
            if p.error:
                self.audit.log("invalid_call", id=p.id, tool=p.fields.get("tool"), error=p.error)
                if p.reply:
                    self.ui.notice(f"[{p.id}] {p.error}")
                continue
            rec = {k: v for k, v in p.event().items() if k not in ("type", "content", "diff", "command", "steps")}
            if p.kind in ("command", "sandbox"):
                rec.update(command_fingerprint(p.fields["command"]))
            if p.kind == "plan":
                rec["steps"] = [audit_step(st) for st in p.fields["steps"]]
            self.audit.log("proposal", **rec)
        live = [p for p in props if not p.error]
        for p in live:
            if p.kind in ("edit", "write") and self.work:
                p.fields["in_copy"] = True      # it lands in the copy, asked or not: the card says so
            if p.kind in ("edit", "write") and not p.auto and self.work_edit(p):
                p.auto, p.fields["work"] = True, True
                self.audit.log("auto_edit", id=p.id, kind=p.kind, path=p.fields["path"], work=True)
            elif p.kind in ("edit", "write") and not p.auto and not self.work and self.auto_edit(p):
                p.auto, p.fields["approved_file"] = True, True
                self.audit.log("auto_edit", id=p.id, kind=p.kind, path=p.fields["path"])
        for p in live:
            if p.kind == "samples":
                self.ui.show_samples(p)
            elif PROPOSAL_KINDS[p.kind].shown:
                self.ui.show_command(p)
            elif p.auto:
                p.decision = "accept"
                self.ui.show_auto(p)
        if any(PROPOSAL_KINDS[p.kind].shown for p in live):
            self.notify("command")      # once, however many commands were shown
        pending = [p for p in live if not PROPOSAL_KINDS[p.kind].shown and not p.auto]
        ep = self.active()[0] if self.work else None
        for p in pending:       # a read for a planner elsewhere: the question says where it goes
            if ep and ep is not self.endpoint and p.kind in ("read", "list", "search") and "to" not in p.fields:
                p.fields["to"] = ep.base_url
                self.ui.notice(f"allowing {p.id} sends what it reads to the planner, at {ep.base_url}")
        if pending:
            self.notify("approval", count=len(pending), kinds=sorted({p.kind for p in pending}))
            self.ui.decide(pending)
        for p in pending:
            if p.kind != "external":    # the wrapper's answer (ok, declined, error) is its result, not a decision
                p.decision = p.decision if p.decision in ("accept", "decline") else "decline"
                self.audit.log("decision", id=p.id, decision=p.decision)
                if p.kind == "skills" and p.decision != "accept":
                    self.declined_skills.update(p.fields["names"])     # the model may not suggest them again
            if p.kind in ("edit", "write") and self.edits == "approved-files":
                key = self.file_key(p.fields.get("path"))
                if p.decision == "accept" and key and key not in self.approved_files:
                    self.approved_files.add(key)
                    self.audit.log("edits_remember", path=key, id=p.id)
                    self.ui.edits(self.edits_info())
                elif p.decision != "accept" and key in self.approved_files:
                    self.approved_files.discard(key)        # a decline: that file asks again
                    self.audit.log("edits_forget", path=key, id=p.id)
                    self.ui.edits(self.edits_info())
            if p.kind == "plan" and p.decision == "accept":
                self.adopt_plan(p)

    def match_plan(self, p):
        """Hold a proposal to the approved plan. A planned read needs no approval (unless the file is hidden or
        looks secret); a planned command, word for word as approved, is marked preapproved, for the wrapper to run
        without asking again; a planned edit or write is labelled, and still asks. A command, edit or write the
        plan doesn't name is flagged off_plan. Each approved command step is preapproved once; proposed again, it is
        marked plan_repeat and asks. hoplon still runs nothing itself."""
        if not self.plan or p.kind not in ("command", "read", "list", "edit", "write"):
            return
        steps = [st for st in self.plan["steps"] if st["approved"]]
        if p.kind == "command":
            same = [st for st in steps if st["kind"] == "command" and st["command"] == p.fields["command"]]
            hit = next((st for st in same if st["status"] == "todo"), None)
            if hit is None and same:            # run once already: in the plan, but it asks again
                p.fields["plan_step"], p.fields["plan_repeat"] = same[0]["n"], True
                self.audit.log("plan_repeat", id=p.id, step=same[0]["n"])
                return
        else:
            try:
                where = "/".join(split_rel(p.fields["path"])) if p.fields["path"] not in (".", "./", "") else ""
            except ValueError:
                return
            kinds = ("read",) if p.kind in ("read", "list") else ("edit", "write")
            hit = next((st for st in steps if st["kind"] in kinds and st["_where"] == where), None)
        if hit is None:
            if p.kind in ("command", "edit", "write"):
                p.fields["off_plan"] = True
            return
        p.fields["plan_step"] = hit["n"]
        if p.kind == "command":
            p.fields["preapproved"] = True
            p.fields["plan_id"] = self.plan["id"]
            hit["status"] = "done"
        elif p.kind in ("read", "list") and not p.auto:
            parts = split_rel(p.fields["path"]) if hit["_where"] else []
            if is_hidden(parts):
                return
            if p.kind == "read":
                if not p.fields.get("secret"):
                    self.prepare_auto_read(p)
                if not p.auto:
                    return
            else:
                p.auto = True
        self.audit.log("plan_match", id=p.id, step=hit["n"], kind=p.kind)
        self.ui.plan(self.plan)

    def adopt_plan(self, p):
        approve = getattr(p, "approve", None)
        edits = getattr(p, "edits", None) or {}
        steps = []
        for st in p.fields["steps"]:
            st = dict(st)
            st["approved"] = approve is None or st["n"] in approve
            if st["kind"] == "command" and st["approved"] and edits.get(st["n"]):
                st["command"], st["edited"] = edits[st["n"]], True
            st["status"] = "todo" if st["approved"] else "left out"
            st["_where"] = "/".join(split_rel(st["path"])) if st.get("path") not in (None, ".", "./", "") else ""
            steps.append(st)
        self.plan = {"id": p.id, "goal": p.fields["goal"], "steps": steps}
        self.audit.log("plan", id=p.id, approved=[st["n"] for st in steps if st["approved"]],
                       edited=[st["n"] for st in steps if st.get("edited")])
        self.ui.plan(self.plan)

    def clear_plan(self):
        if self.plan:
            self.audit.log("plan_cleared", id=self.plan["id"])
        self.plan = None
        self.ui.plan(None)

    def notify(self, event, **fields):
        """Tell the notify hook, if there is one, that hoplon is now waiting for the person."""
        if self.notifier and self.alerts:
            self.notifier.fire(event, **fields)

    def set_alerts(self, on, source):
        if on != self.alerts:
            self.alerts = on
            self.audit.log("alerts", on=on, source=source)

    def perform(self, p):
        """Carry out a decided proposal and return what the model is told. A kind the wrapper answers runs whatever
        the answer; any other runs only if accepted."""
        if p.error:
            return p.reply or f"error: {p.error}"
        kind = PROPOSAL_KINDS[p.kind]
        if not (kind.shown or kind.answered) and p.decision != "accept":
            return "declined by the user"
        return getattr(Engine, kind.perform)(self, p)

    def perform_command(self, p):
        return "shown to the user, not run. If they run it, they may send you the output."

    def perform_skills(self, p):
        """Switch them on, carried by this call's result. A skill that can't be (its blessing changed since) is
        reported, and the others still go on."""
        p.carry, failed = {}, []
        for n in p.fields["names"]:
            try:
                self.set_skill(n, True, source="suggestion", carry=False)
            except HoplonError as e:
                failed.append(f"{n} ({e})")
                continue
            s = next(s for s in self.skills if s.name == n)
            p.carry[n] = self.skill_block(s, "switched on by the user at your suggestion")
        self.ui.skills_changed(self.skill_rows())
        head = (f"switched on: {', '.join(p.carry)}." if p.carry else "none was switched on.") + \
            (f" Not switched on: {'; '.join(failed)}." if failed else "")
        return head + "".join(p.carry.values())

    def perform_samples(self, p):
        return ("shown to the user, not run: nothing runs for a sample request. Wait for them: once they have put the samples in the folder and approved them, "
                "run_in_sandbox sees them read-only at /fixtures.")

    def fixtures_store(self):
        """This job's samples folder (not created until something is added)."""
        if getattr(self, "fixtures", None) is None:
            root = os.path.realpath(self.wd.root if not self.work else self.work.home.root)
            self.fixtures = Fixtures(self.cfg.fixtures_dir, root, self.session.id or f"run-{os.getpid()}")
        return self.fixtures

    def fixtures_info(self):
        fx = self.fixtures_store()
        try:
            rows = fx.scan(self.secrets())
            problem = fx.problem()
        except (HoplonError, OSError) as e:
            rows, problem = [], str(e)
        return {"dir": fx.dir, "files": rows, "digest": Fixtures.digest(rows), "approved": bool(fx.approved),
                "problem": problem, "ask": FIXTURES_ASK}

    def fixtures_action(self, action, source, paths=(), cwd=None, digest=None):
        """add, use (approve exactly what was listed), drop (forget the approval) or clear (delete the folder)."""
        fx = self.fixtures_store()
        if action == "add":
            names = fx.add(paths, cwd or os.getcwd())
            self.audit.log("fixtures_add", files=names, dir=fx.dir, source=source)
        elif action == "use":
            rows = fx.approve(digest, self.secrets())
            self.audit.log("fixtures_use", digest=digest, files=[[r["name"], r["size"], r["sha256"]] for r in rows],
                           source=source)
        elif action == "drop":
            fx.approved = None
            self.audit.log("fixtures_drop", source=source)
        elif action == "clear":
            fx.clear()
            self.audit.log("fixtures_clear", dir=fx.dir, source=source)
        else:
            raise HoplonError("fixtures: unknown action", EXIT_USAGE, "bad_message")
        return self.fixtures_info()

    def perform_plan(self, p):
        if p.decision != "accept" or not self.plan or self.plan["id"] != p.id:
            return "declined by the user: the plan was not approved. Ask what they want instead."
        return "The user approved this plan. Carry it out step by step, without asking first.\n" + plan_text(self.plan)

    def perform_work_plan(self, p):
        w = self.work
        if p.decision != "accept" or not w:
            return "declined by the user: the plan was not approved. Stop and ask what they want instead."
        w.goal = p.fields["goal"]
        w.items = [{"n": n, "title": t, "status": "todo", "commit": None} for n, t in enumerate(p.fields["items"], 1)]
        w.current = 1
        w.reports = []          # a new plan numbers its items afresh; what was done is committed on the branch
        w.fresh(renew=True)
        if w.role == "item":
            # An item's context replanned: the planner's context stays its own (an item's conversation doesn't go to
            # a planner elsewhere), and is told of the new plan.
            w.planner = (w.planner or []) + [{"role": "user", "content": "An item's context replaced the plan, and the user "
                                      "approved the new one:\n" + work_text(w)}]
        else:
            w.role = "plan"     # the planner's context, or the first plan's: it plans from now on
        w.swap = ("item", None, "the plan was approved")
        self.audit.log("work_plan", id=p.id, items=len(w.items))
        self.ui.work({"state": "plan", **w.info()})
        return ("The user approved this plan. Work through it item by item, without asking; call finish_item when "
                "each is done.\n" + work_text(w))

    def perform_finish(self, p):
        """Finish the current item: the test command must pass in the sandbox, then everything is committed."""
        w, n = self.work, p.fields["n"]
        if w.test and self.box.network:     # set_network refuses this; checked again, as the test doesn't ask
            self.ui.result(p, "error", f"item {n} not finished: the sandbox's network is on")
            return "not finished: the sandbox's network is on, and the test only runs offline. Ask the user."
        if w.test and w.left() < 1:
            why = f"the work session has run {w.seconds // 60} min without you"
            self.ui.result(p, "skipped", f"item {n} not finished: {why}")
            return f"not finished: {why}, so the test did not run"
        if w.test:
            try:
                ran, rc, out, note = self.box.run(w.test, self.secrets(), timeout=w.left())
            except KeyboardInterrupt:
                p.stopped = True
                self.ui.result(p, "stopped", "the test command was stopped")
                return "stopped by the user before the test command finished"
            except HoplonError as e:
                ran, rc, out, note = False, None, "", str(e)
            out = clip(redact(out, self.secrets())[0])
            self.audit.log("work_test", id=p.id, item=n, exit=rc, ran=ran)
            if not ran or rc != 0:
                why = f"the test command could not run: {note}" if not ran else \
                    (f"the test command failed (exit {rc})" if rc is not None else f"the test command was {note}")
                self.ui.result(p, "error", f"item {n} not finished: {why}", output=out, exit=rc)
                return f"not finished: {why}. Output:\n" + (out if out.strip() else "(none)")
        try:
            summary, notes = p.fields["summary"], p.fields["notes"]
            title = short_title(summary)
            body = [summary] if title != summary else []
            body.append(f"Plan item: {w.items[n - 1]['title']}")
            if notes:
                body.append("Notes for later items:\n" + notes)
            sha = w.tree.commit(f"{n}. {title}\n\n" + "\n\n".join(body))
        except HoplonError as e:
            self.ui.result(p, "error", f"item {n} not committed: {e}")
            return f"error: not committed: {e}"
        if sha is None:
            self.ui.result(p, "error", f"item {n} not finished: nothing changed since the last item")
            return "not finished: no files changed since the last item. Make the changes first."
        w.items[n - 1].update(status="done", commit=sha)
        w.reports.append({"n": n, "summary": p.fields["summary"], "notes": p.fields["notes"], "commit": sha})
        self.audit.log("work_item", id=p.id, item=n, commit=sha)
        nxt = next((it for it in w.items if it["status"] == "todo"), None)
        w.current = nxt["n"] if nxt else 0
        w.fresh()
        if nxt:
            w.swap = ("item", None, f"item {n} was finished")
        self.ui.result(p, "ok", f"item {n} committed as {sha}")
        try:
            w.tree.publish()
        except HoplonError as e:     # it's committed in the copy; the end of the session tries again
            self.ui.notice(f"[!] item {n} is committed in the copy, but the branch couldn't be updated: {e}")
        self.ui.work({"state": "item", **w.info()})
        if nxt is None:
            return f"Item {n} committed as {sha}. Every item is done: reply with a short summary of the work."
        return f"Item {n} committed as {sha}. Next: item {nxt['n']}: {nxt['title']}"

    def perform_retry(self, p):
        w = self.work
        w.swap = ("item", p.fields["hint"], "the planner asked for a fresh attempt")
        self.audit.log("work_retry", id=p.id, item=p.fields["n"])
        self.ui.result(p, "ok", f"a fresh attempt at item {p.fields['n']} starts now")
        return f"A fresh attempt at item {p.fields['n']} starts now, with your hint."

    def perform_external(self, p):
        status = p.decision if p.decision in ("ok", "declined", "error") else "declined"
        out, counts = redact(str(p.result or ""), self.secrets())
        self.audit.log("external_result", id=p.id, tool=p.fields["tool"], status=status,
                       chars=len(out), redacted=counts)
        return f"{status}" + (f":\n{clip(out)}" if out else "")

    def perform_file(self, p):
        """read, list, search, write and edit, through the working directory's checks."""
        try:
            if p.kind == "read":
                if p.auto and "_read_error" in p.fields:
                    raise p.fields["_read_error"]
                text = p.fields["_read_text"] if p.auto else self.wd.read(p.fields["path"])
                result = text
                note = f"read {len(text)} characters"
                if p.fields.get("_not_secret") and not p.auto:
                    self.remember_not_secret(p.fields["path"], text)
                if self.secret_text(text):
                    self.ui.notice(f"warning: {p.fields['path']} looks like it contains secrets; it was sent as is")
            elif p.kind == "search":
                result, note = self.search(p)
            elif p.kind == "list":
                rows, truncated = self.wd.list(p.fields["path"])
                lines = [f"{n}/" if k == "dir" else f"{n}  ({s} bytes)" if k == "file" else f"{n}  [{k}]"
                         for n, k, s in rows]
                if truncated:
                    lines.append(f"... listing stopped after {LIST_CAP} entries")
                result = "\n".join(lines) or "(empty directory)"
                note = f"listed {len(rows)} entries"
            elif p.kind == "write":
                n = self.wd.write(p.fields["path"], p.fields["content"], expected=p.fields["_state"])
                result = note = f"wrote {p.fields['path']} ({n} bytes)"
            else:
                self.wd.write(p.fields["path"], p.fields["_content"], expected=p.fields["_state"])
                result = note = f"edited {p.fields['path']}"
        except StaleApproval:
            self.audit.log("file_op", id=p.id, kind=p.kind, path=p.fields["path"], status="stale")
            self.ui.result(p, "error", f"{p.fields['path']} changed after you reviewed it, so nothing was written")
            return (f"not applied: {p.fields['path']} changed since the user reviewed your proposal; "
                    "propose the change again")
        except (ValueError, OSError) as e:
            self.audit.log("file_op", id=p.id, kind=p.kind, path=p.fields.get("path"), status="error", error=str(e))
            self.ui.result(p, "error", str(e))
            return f"error: {e}"
        self.audit.log("file_op", id=p.id, kind=p.kind, path=p.fields.get("path"), status="ok", auto=p.auto,
                       **({"approved_file": True} if p.fields.get("approved_file") else {}))
        key = self.file_key(p.fields["path"]) if self.work and p.kind in ("write", "edit") else None
        if key:
            sub = self.work.tree.sub
            self.work.written.add(key if sub == "." else f"{sub}/{key}")
        self.ui.result(p, "ok", note)
        step = p.fields.get("plan_step")
        if step and self.plan:
            for st in self.plan["steps"]:
                if st["n"] == step:
                    st["status"] = "done"
            self.ui.plan(self.plan)
        return result

    def run_sandboxed(self, p):
        """Run an accepted run_in_sandbox call. The model gets the exit code and the output, redacted and clipped;
        the user sees the same."""
        where = "online" if p.fields["network"] else "offline"
        left = self.work.left() if self.work else None
        if left is not None and left < 1:
            why = f"the work session has run {self.work.seconds // 60} min without you"
            self.ui.result(p, "skipped", f"not run: {why}")
            return f"not run: {why}"
        started = time.monotonic()
        try:
            fx = self.fixtures_store()
            mount = fx.mount(self.secrets())
            if mount and self.work:
                fx.used_in_work = True
            ran, rc, out, note = self.box.run(p.fields["command"], self.secrets(), timeout=left, fixtures=mount)
        except KeyboardInterrupt:
            p.stopped = True
            self.audit.log("sandbox_exit", id=p.id, exit=None, stopped=True)
            self.ui.result(p, "stopped", "the container was killed")
            return "stopped by the user before it finished"
        except HoplonError as e:
            ran, rc, out, note = False, None, "", str(e)
        secs = time.monotonic() - started
        out, counts = redact(out, self.secrets())
        out = clip(out)
        self.audit.log("sandbox_exit", id=p.id, exit=rc, network=p.fields["network"], seconds=round(secs, 1),
                       chars=len(out), redacted=counts, note=note)
        if not ran:
            self.ui.result(p, "error", f"not run: {note}", output="", exit=None)
            return f"error: not run: {note}"
        head = f"exit {rc}" if rc is not None else note
        extra = [note] if note and rc is not None else []
        if counts:
            extra.append(f"redacted {redaction_note(counts)}")
        self.ui.result(p, "ok" if rc == 0 else "error", "; ".join([f"{head} in {secs:.1f} s"] + extra),
                       output=out, exit=rc)
        return f"{head} (sandbox, {where}, {secs:.1f} s). Output:\n" + (out if out.strip() else "(none)")

    def perform_trusted(self, p):
        """Run an accepted scoped command for the model: the exit code and the output, redacted and clipped."""
        r = self.run_trusted(p.fields["_cmd"], p.fields["params"], "model")
        if r["error"]:
            self.ui.result(p, "error", f"not run: {r['error']}", output="", exit=None)
            return f"error: not run: {r['error']}"
        rc, note = r["exit"], r["note"]
        head = f"exit {rc}" if rc is not None else note
        extra = [note] if note and rc is not None else []
        if r["cached"] is not None:
            extra.append(f"cached {r['cached']} s ago")
        if r["redacted"]:
            extra.append(f"redacted {redaction_note(r['redacted'])}")
        self.ui.result(p, "ok" if rc == 0 else "error", "; ".join([f"{head} in {r['ms']} ms"] + extra),
                       output=r["output"], exit=rc)
        return head + (f" ({'; '.join(extra)})" if extra else "") + ". Output:\n" \
            + (r["output"] if r["output"].strip() else "(none)")

    def run_user(self, cset, command, params):
        """A scoped command the user asked for (a wrapper's run message): the same checks and limits as the
        model's. Raises HoplonError when it can't be asked for; otherwise returns run_trusted's result."""
        cmd = next((c for p in self.command_sets if p.name == cset for c in p.commands.values() if c.name == command),
                   None)
        if not cmd:
            raise HoplonError(f"no command {one_line(str(cset))[0]}.{one_line(str(command))[0]} in an enabled command set",
                             EXIT_USAGE, "unknown_command")
        try:
            values = cmd.check(params)
        except ValueError as e:
            raise HoplonError(str(e), EXIT_USAGE, "bad_params") from None
        return self.run_trusted(cmd, values, "user")

    def run_trusted(self, cmd, values, source):
        """Run a scoped command whose parameters are already checked. Refused, not run, when the program changed,
        when the same command ran less than its min_interval ago, or after 30 real runs in a minute; a result
        younger than the command's cache time is returned again instead. Returns {error, exit, output, note,
        cached (seconds, or None), ms, redacted}."""
        res = {"error": None, "exit": None, "output": "", "note": "", "cached": None, "ms": 0, "redacted": {}}
        limited = False

        def finish():
            self.audit.log("trusted_run", set=cmd.set, command=cmd.name, params=values, source=source,
                           exit=res["exit"], ms=res["ms"], bytes=len(res["output"].encode()),
                           cached=res["cached"] is not None, rate_limited=limited, binary=cmd.binary,
                           error=res["error"], redacted=res["redacted"])
            return res

        key, now_ = (cmd.set, cmd.name), time.monotonic()
        ckey = key + (tuple(sorted(values.items())),)
        problem = cmd.changed()
        if problem:
            res["error"] = problem
            return finish()
        hit = self.cached.get(ckey)
        if cmd.cache and hit and now_ - hit[0] < cmd.cache:
            res.update(exit=hit[1], output=hit[2], note=hit[3], cached=int(now_ - hit[0]))
            return finish()
        while self.runs and now_ - self.runs[0] >= 60:
            self.runs.popleft()
        wait = max(cmd.min_interval - (now_ - self.last_run[key]), 0) if key in self.last_run else 0
        if len(self.runs) >= TRUSTED_PER_MINUTE:
            wait = max(wait, 60 - (now_ - self.runs[0]))
        if wait > 0:
            limited = True
            res["error"] = f"rate limited: try again in {int(wait) + 1} s"
            return finish()
        self.last_run[key] = now_
        self.runs.append(now_)
        try:
            rc, out, err, note = run_program(cmd.build(values), cmd.env(), os.getcwd(), cmd.timeout, cmd.max_output)
        except OSError as e:
            res["error"] = f"could not start the program: {e.strerror}"
            return finish()
        text = strip_ansi(out.decode("utf-8", "replace"))
        if err.strip():
            text += ("" if text.endswith("\n") or not text else "\n") + "[stderr]\n" \
                + strip_ansi(err.decode("utf-8", "replace"))
        text, counts = redact(text, self.secrets())
        res.update(exit=rc, output=clip(text), note=note, redacted=counts, ms=int((time.monotonic() - now_) * 1000))
        if cmd.cache:
            self.cached.pop(ckey, None)
            self.cached[ckey] = (now_, rc, res["output"], note)
            while len(self.cached) > TRUSTED_CACHE:
                del self.cached[next(iter(self.cached))]
        return finish()

    # -- sharing output and compaction

    def share(self, source, text, ref=None):
        """Record that reviewed output is being sent to the model."""
        self.audit.log("shared", source=source, ref=ref, chars=len(text),
                       sha256=hashlib.sha256(text.encode("utf-8", "replace")).hexdigest())

    def secret_text(self, text, excused=None):
        """Does this text look like it holds secrets? The endpoint key always counts; the patterns don't for text you
        said holds none (not-secret.json, matched by its sha256, so any change asks again)."""
        if any(k and k in text for k in self.secrets()):
            return True
        if not looks_secret(text):
            return False
        return text_digest(text) not in (self.cfg.not_secret() if excused is None else excused)

    def secrets(self):
        """Exact values to mask in text bound for the model: the endpoint keys."""
        w = getattr(self, "work", None)
        return [getattr(self.client, "_key", None)] + ([w.planner_ep[1]._key] if w and w.planner_ep else [])

    def clear(self):
        """Start the conversation over: from now on the model gets none of it, and an approved plan is dropped.
        The session's history still holds all of it. Returns how many messages the model no longer gets."""
        dropped = len(self.session.messages)
        self.session.messages = []
        self.session.usage = None
        self.clear_plan()
        if self.work:       # the planner's waiting context goes too, and what earlier items reported
            dropped += len(self.work.planner or [])
            self.work.planner, self.work.reports = None, []
            if self.work.before and self.work.before["messages"] is not None:
                self.work.before["messages"] = []
            if self.session.held:       # what is saved in place of the conversation: a resume mustn't bring it back
                self.session.held["messages"] = []
        self.audit.log("clear", dropped=dropped)
        self.session.save()
        return dropped

    def compact(self, edit_summary=None):
        """Prune old bulk, then summarize older turns only if still over the warning line."""
        msgs = self.session.messages
        user_idx = [i for i, m in enumerate(msgs) if m.get("role") == "user"]
        keep_from = user_idx[-KEEP_TURNS] if len(user_idx) >= KEEP_TURNS else 0
        before = self.used()
        pruned = 0
        for i in range(keep_from):
            m = msgs[i]
            if m.get("_bulk") and not m.get("_pruned"):
                if m.get("role") == "tool":
                    m["content"] = "[contents dropped by compaction; read again if needed]"
                else:
                    first = (m.get("content") or "").split("\n\n[", 1)[0]
                    m["content"] = first + "\n\n[attached contents dropped by compaction; ask for them again if needed]"
                m["_pruned"] = True
                pruned += 1
        self.session.usage = None
        after = self.used()
        report = {"pruned": pruned, "before": before, "after": after, "summary": None}
        if after >= WARN_FRACTION * self.active()[0].context_limit and keep_from > 0:
            older, tail = msgs[:keep_from], msgs[keep_from:]
            req = wire(older) + [{"role": "user", "content":
                   f"Summarize the conversation so far in at most {SUMMARY_WORDS} words for your own later use: "
                   "facts learned, decisions made, files touched, and open questions. Plain text only."}]
            saved_msgs = self.session.messages
            self.session.messages = req
            try:
                summary = (self.send(max_tokens=SUMMARY_WORDS * 3, tools=False).get("content") or "").strip()
            finally:
                self.session.messages = saved_msgs
                self.session.usage = None
            if edit_summary:
                summary = edit_summary(summary)
            if summary:
                first = dict(tail[0])
                first["content"] = f"[Summary of the earlier conversation]\n{summary}\n\n[Next message]\n{first['content']}"
                self.session.messages = [first] + tail[1:]
                self.session.usage = None
                report["summary"] = summary
                report["after"] = self.used()
        self.audit.log("compact", **{k: v for k, v in report.items() if k != "summary"},
                       summarized=bool(report["summary"]))
        self.session.save()
        return report


