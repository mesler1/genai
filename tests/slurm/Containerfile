# A one-node Slurm cluster for trying hoplon and its TUI against real squeue/sbatch.
# openSUSE Leap 15.6 with SUSE's own SLES 15 packages (a target platform): Slurm 24.11, tmux 3.3a,
# Python 3.11. Cgroups are disabled so it runs in rootless podman. Not for production.
FROM registry.opensuse.org/opensuse/leap:15.6
RUN zypper -n -q install slurm_24_11 slurm_24_11-node slurm_24_11-munge munge tmux python311 python311-curses \
        procps less vim util-linux shadow hostname \
 && zypper -n -q clean -a
RUN (getent passwd slurm >/dev/null || useradd -r -M -s /sbin/nologin slurm) \
 && useradd -m hpc \
 && dd if=/dev/urandom bs=1 count=1024 of=/etc/munge/munge.key status=none \
 && chown munge:munge /etc/munge/munge.key && chmod 400 /etc/munge/munge.key \
 && mkdir -p /var/spool/slurm/ctld /var/spool/slurm/d /var/log/slurm /run/munge /run/tmux \
 && chmod 1777 /run/tmux \
 && chown -R slurm:slurm /var/spool/slurm /var/log/slurm && chown munge:munge /run/munge \
 && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
 && echo 'export LANG=C.UTF-8' > /etc/profile.d/hoplon-utf8.sh
ENV LANG=C.UTF-8
COPY slurm.conf cgroup.conf /etc/slurm/
COPY entrypoint.sh /usr/local/sbin/entrypoint.sh
ENTRYPOINT ["/usr/local/sbin/entrypoint.sh"]
CMD ["su", "-", "hpc"]
